---
// Realistic 3D Split AC Indoor Unit with Cascading Arctic Breeze Animation
import { business } from '../data/business';

interface Props {
  logoUrl?: string;
  businessName?: string;
}

const {
  logoUrl,
  businessName = business.name,
} = Astro.props;
---

<div class="relative w-full max-w-md lg:max-w-lg xl:max-w-xl mx-auto select-none" id="smart-ac-showcase">
  <!-- Cold Ambient Ice Core Glow Behind the Unit -->
  <div id="ac-ambient-aura" class="absolute -top-10 left-1/2 -translate-x-1/2 w-72 sm:w-96 lg:w-[28rem] h-72 sm:h-96 lg:h-[28rem] bg-cyan-400/20 rounded-full blur-3xl pointer-events-none transition-all duration-700" aria-hidden="true"></div>

  <!-- ============================================== -->
  <!-- REALISTIC 3D SPLIT AC INDOOR UNIT CHASSIS     -->
  <!-- ============================================== -->
  <div
    id="ac-chassis"
    class="relative rounded-2xl sm:rounded-3xl bg-gradient-to-b from-white via-slate-50 to-slate-200 border border-white/90 p-4 sm:p-5 lg:p-6 shadow-[0_20px_50px_-10px_rgba(2,132,199,0.3)] transition-all duration-300"
  >
    <!-- Top Bevel Chrome Highlight -->
    <div class="absolute top-0 inset-x-4 h-[2px] bg-gradient-to-r from-transparent via-white to-transparent pointer-events-none"></div>

    <!-- Top Air Intake Grille Strip -->
    <div class="h-2 lg:h-2.5 w-full rounded-full bg-slate-200/80 border border-slate-300/60 overflow-hidden flex items-center px-1">
      <div class="w-full h-1 bg-[repeating-linear-gradient(90deg,#94a3b8_0px,#94a3b8_2px,transparent_2px,transparent_6px)] opacity-60"></div>
    </div>

    <!-- AC Front Panel Faceplate -->
    <div class="mt-3 lg:mt-4 flex items-center justify-between gap-3">
      <!-- Left: Minimal Brand Emblem -->
      <div class="flex items-center gap-2 lg:gap-2.5 min-w-0">
        <div
          id="ac-brand-badge"
          class="h-7 lg:h-9 min-w-[1.75rem] lg:min-w-[2.25rem] max-w-[3.5rem] lg:max-w-[4.5rem] px-1 rounded-lg lg:rounded-xl bg-brand-navy text-white flex items-center justify-center font-black text-xs lg:text-sm shadow-xs border border-cyan-400/30 overflow-hidden flex-shrink-0 transition-all"
        >
          {logoUrl ? (
            <img
              id="ac-brand-logo-img"
              src={logoUrl}
              alt={`${businessName} logo`}
              class="max-h-5 lg:max-h-6 w-auto max-w-full object-contain"
              loading="eager"
            />
          ) : (
            <div id="ac-brand-default-mark" class="flex items-center justify-center">
              <span id="ac-brand-logo-fallback" class="text-xs lg:text-sm select-none">❄️</span>
            </div>
          )}
        </div>
        <div class="min-w-0">
          <h3 id="ac-brand-heading" class="text-xs sm:text-sm lg:text-base font-black tracking-wider text-brand-navy uppercase font-display leading-tight truncate">
            {businessName}
          </h3>
          <p class="text-[9px] lg:text-[10px] font-bold tracking-[0.2em] text-slate-400 uppercase truncate">
            INVERTER &bull; DUAL ROTARY
          </p>
        </div>
      </div>

      <!-- Right: Hidden Cyan LED Digital Temperature Display -->
      <div class="flex items-center gap-2 lg:gap-2.5">
        <div
          id="ac-led-display"
          class="px-2.5 py-1 lg:px-3 lg:py-1.5 rounded-xl bg-slate-900 border border-cyan-500/40 shadow-inner flex items-center gap-1.5 cursor-pointer hover:border-cyan-400 transition-colors"
          title="Tap to toggle Turbo / Eco"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span id="ac-temp-val" class="text-sm sm:text-base lg:text-lg font-black text-cyan-300 font-mono tracking-tight drop-shadow-[0_0_8px_rgba(56,189,248,0.9)]">
            16°C
          </span>
          <span class="text-[10px] lg:text-xs text-cyan-400 font-bold uppercase" id="ac-mode-tag">TURBO</span>
        </div>

        <!-- 1-Tap Quick Mode Switch Button -->
        <button
          type="button"
          id="ac-turbo-switch-btn"
          class="px-2.5 py-1 lg:px-3 lg:py-1.5 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-500/40 text-cyan-700 text-xs lg:text-sm font-bold transition-all active:scale-95 cursor-pointer flex items-center gap-1"
          title="Toggle Turbo Chill"
        >
          <span>⚡ Chill</span>
        </button>
      </div>
    </div>

    <!-- Motorized Louver Flap & Air Vent -->
    <div class="mt-3 pt-2 border-t border-slate-200/80 relative">
      <!-- Swinging Flap Blade -->
      <div
        id="ac-flap-blade"
        class="h-2.5 w-full rounded-full bg-gradient-to-r from-slate-200 via-white to-slate-200 border-b border-slate-300 shadow-xs origin-top transform translate-y-1 transition-transform duration-500"
      ></div>

      <!-- Glowing Cyan Vent Slot -->
      <div
        id="ac-vent-glow"
        class="h-3 w-5/6 mx-auto bg-cyan-400/70 rounded-full blur-sm -mt-1.5 animate-pulse transition-opacity duration-500"
      ></div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- CASCADING ARCTIC FROST BREEZE ANIMATION       -->
  <!-- ============================================== -->
  <div class="relative w-full h-20 sm:h-28 lg:h-32 -mt-1 overflow-hidden pointer-events-none" id="ac-breeze-chamber">
    <!-- Cold Frost Fog Drift -->
    <div class="absolute inset-0 bg-gradient-to-b from-cyan-400/20 via-sky-400/10 to-transparent blur-md animate-frost-drift" aria-hidden="true"></div>

    <!-- Fluid High-Speed Airflow Vectors -->
    <svg class="absolute inset-0 w-full h-full fill-none overflow-visible" viewBox="0 0 500 120" preserveAspectRatio="none">
      <defs>
        <linearGradient id="frostStream1" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#0284c7" stop-opacity="0.1" />
        </linearGradient>
        <linearGradient id="frostStream2" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.05" />
        </linearGradient>
      </defs>

      <!-- Cascading Wave 1 (Left Stream) -->
      <path
        d="M 120,5 C 100,45 60,85 20,115"
        stroke="url(#frostStream1)"
        stroke-width="3"
        stroke-dasharray="16 10"
        class="frost-stream stream-1"
      />
      <!-- Cascading Wave 2 (Center Stream) -->
      <path
        d="M 250,5 C 250,45 260,85 270,115"
        stroke="url(#frostStream1)"
        stroke-width="3.5"
        stroke-dasharray="20 12"
        class="frost-stream stream-2"
      />
      <!-- Cascading Wave 3 (Right Stream) -->
      <path
        d="M 380,5 C 400,45 440,85 480,115"
        stroke="url(#frostStream2)"
        stroke-width="3"
        stroke-dasharray="16 10"
        class="frost-stream stream-3"
      />
      <!-- Cross Breeze Arc 4 -->
      <path
        d="M 80,15 C 200,60 300,75 420,110"
        stroke="#7dd3fc"
        stroke-width="2"
        stroke-dasharray="12 12"
        opacity="0.75"
        class="frost-stream stream-4"
      />
    </svg>

    <!-- Drifting Floating Snowflakes & Ice Crystals (❄️ ✨) -->
    <div class="absolute inset-0">
      <span class="snowflake s-1 top-2 left-[20%] text-sm">❄️</span>
      <span class="snowflake s-2 top-8 left-[45%] text-xs">✨</span>
      <span class="snowflake s-3 top-4 left-[70%] text-sm">❄️</span>
      <span class="snowflake s-4 top-14 left-[30%] text-xs">✨</span>
      <span class="snowflake s-5 top-12 left-[80%] text-sm">❄️</span>
    </div>
  </div>

  <!-- Interactive 1-Tap Booking Pill (Underneath the Breeze on Desktop) -->
  <div class="mt-1 hidden lg:flex items-center justify-center">
    <a
      id="ac-quick-book-pill"
      href="https://wa.me/919575664203?text=Hello%20Patel%20Cool%20Tech%2C%20I%20want%20to%20book%20Turbo%20Cool%2016%C2%B0C%20AC%20Service"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-cyan-400/50 shadow-soft hover:shadow-card hover:border-cyan-400 text-brand-navy hover:text-brand-blue text-xs font-bold transition-all active:scale-95"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span id="ac-pill-label">Turbo 16°C Active &bull; Book On WhatsApp &rarr;</span>
    </a>
  </div>
</div>

<style>
  /* Cascading Frost Airflow Streams */
  @keyframes frostFlow1 {
    0% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -150; }
  }
  @keyframes frostFlow2 {
    0% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -180; }
  }
  @keyframes frostFlow3 {
    0% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -160; }
  }

  .frost-stream.stream-1 { animation: frostFlow1 2s linear infinite; }
  .frost-stream.stream-2 { animation: frostFlow2 1.8s linear infinite; }
  .frost-stream.stream-3 { animation: frostFlow3 2.2s linear infinite; }
  .frost-stream.stream-4 { animation: frostFlow1 2.5s linear infinite; }

  /* Eco Mode: Gentle Calm Speed */
  .eco-active .frost-stream.stream-1 { animation-duration: 4.5s; }
  .eco-active .frost-stream.stream-2 { animation-duration: 4s; }
  .eco-active .frost-stream.stream-3 { animation-duration: 5s; }
  .eco-active .frost-stream.stream-4 { animation-duration: 5.5s; }

  /* Drifting Cold Mist */
  @keyframes frostMist {
    0%, 100% { opacity: 0.25; transform: scaleY(0.9); }
    50% { opacity: 0.6; transform: scaleY(1.1); }
  }
  .animate-frost-drift {
    animation: frostMist 3.5s ease-in-out infinite;
  }

  /* Floating Snowflakes Dancing in the Breeze */
  @keyframes snowflakeFall {
    0% {
      transform: translateY(0) rotate(0deg) scale(0.8);
      opacity: 0.2;
    }
    50% {
      transform: translateY(25px) rotate(180deg) scale(1.2);
      opacity: 1;
    }
    100% {
      transform: translateY(50px) rotate(360deg) scale(0.7);
      opacity: 0.1;
    }
  }

  .snowflake {
    position: absolute;
    animation: snowflakeFall 2.8s ease-in-out infinite;
    filter: drop-shadow(0 0 6px #38bdf8);
    pointer-events: none;
  }
  .snowflake.s-2 { animation-delay: 0.5s; animation-duration: 3.2s; }
  .snowflake.s-3 { animation-delay: 1.1s; animation-duration: 2.6s; }
  .snowflake.s-4 { animation-delay: 1.6s; animation-duration: 3s; }
  .snowflake.s-5 { animation-delay: 2.1s; animation-duration: 2.9s; }
</style>

<script>
  function setupRealisticAc() {
    const showcase = document.getElementById('smart-ac-showcase');
    const ledDisplay = document.getElementById('ac-led-display');
    const turboSwitchBtn = document.getElementById('ac-turbo-switch-btn');
    const tempVal = document.getElementById('ac-temp-val');
    const modeTag = document.getElementById('ac-mode-tag');
    const flapBlade = document.getElementById('ac-flap-blade');
    const ventGlow = document.getElementById('ac-vent-glow');
    const ambientAura = document.getElementById('ac-ambient-aura');
    const pillLabel = document.getElementById('ac-pill-label');
    const quickBookPill = document.getElementById('ac-quick-book-pill') as HTMLAnchorElement | null;
    const breezeChamber = document.getElementById('ac-breeze-chamber');

    if (!showcase || !tempVal) return;

    let isTurbo = true;

    function toggleMode() {
      isTurbo = !isTurbo;

      if (isTurbo) {
        // Turbo 16°C
        tempVal.textContent = '16°C';
        if (modeTag) modeTag.textContent = 'TURBO';
        breezeChamber?.classList.remove('eco-active');
        if (flapBlade) flapBlade.style.transform = 'translateY(4px) rotate(2deg)';
        if (ventGlow) ventGlow.style.opacity = '1';
        if (ambientAura) ambientAura.style.opacity = '1';
        if (pillLabel) pillLabel.textContent = 'Turbo 16°C Active • Book On WhatsApp →';
        if (quickBookPill) {
          quickBookPill.href = 'https://wa.me/919575664203?text=Hello%20Patel%20Cool%20Tech%2C%20I%20want%20to%20book%20Turbo%20Cool%2016%C2%B0C%20AC%20Service';
        }
      } else {
        // Eco 24°C
        tempVal.textContent = '24°C';
        if (modeTag) modeTag.textContent = 'ECO';
        breezeChamber?.classList.add('eco-active');
        if (flapBlade) flapBlade.style.transform = 'translateY(1px) rotate(0deg)';
        if (ventGlow) ventGlow.style.opacity = '0.5';
        if (ambientAura) ambientAura.style.opacity = '0.5';
        if (pillLabel) pillLabel.textContent = 'Eco 24°C Flow • Book On WhatsApp →';
        if (quickBookPill) {
          quickBookPill.href = 'https://wa.me/919575664203?text=Hello%20Patel%20Cool%20Tech%2C%20I%20want%20to%20book%20Eco%20AC%20Service';
        }
      }
    }

    // Idempotent event listeners
    ledDisplay?.replaceWith(ledDisplay.cloneNode(true));
    turboSwitchBtn?.replaceWith(turboSwitchBtn.cloneNode(true));
    const freshLed = document.getElementById('ac-led-display');
    const freshTurboBtn = document.getElementById('ac-turbo-switch-btn');
    freshLed?.addEventListener('click', toggleMode);
    freshTurboBtn?.addEventListener('click', toggleMode);

    // Sync logo from local cache if customized
    function syncDynamicBrandLogo() {
      const badge = document.getElementById('ac-brand-badge');
      if (!badge) return;

      function renderLogo(url: string) {
        if (!url || !badge) return;
        const fallback = document.getElementById('ac-brand-default-mark') || document.getElementById('ac-brand-logo-fallback');
        if (fallback) fallback.remove();

        let img = document.getElementById('ac-brand-logo-img') as HTMLImageElement | null;
        if (!img) {
          img = document.createElement('img');
          img.id = 'ac-brand-logo-img';
          img.alt = 'Patel Cool Tech logo';
          img.className = 'max-h-5 lg:max-h-6 w-auto max-w-full object-contain';
          img.loading = 'eager';
          badge.appendChild(img);
        }
        if (img.src !== url) {
          img.src = url;
        }
      }

      try {
        const cachedLogo = localStorage.getItem('pct_custom_logo');
        if (cachedLogo) {
          renderLogo(cachedLogo);
        }
      } catch (e) {}
    }

    syncDynamicBrandLogo();
    window.addEventListener('pct:logo-updated', syncDynamicBrandLogo);
  }

  setupRealisticAc();
  document.addEventListener('astro:page-load', setupRealisticAc);
</script>
