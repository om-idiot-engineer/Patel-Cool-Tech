---
import { business } from '../data/business';
import Container from './Container.astro';
import Button from './Button.astro';

const technicianNames = business.technicians.map((t) => t.name).join(' & ');
---

<section id="contact" class="py-14 sm:py-18 lg:py-24 bg-brand-navy text-white relative overflow-hidden scroll-mt-20">
  <!-- Subtle technical grid ambient background -->
  <div class="absolute inset-0 pointer-events-none opacity-5" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cta-grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#FFFFFF" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-grid-pattern)" />
    </svg>
  </div>

  <Container class="relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-brand-ice border border-white/15 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wide uppercase">Direct Technician Assistance</span>
      </div>

      <!-- Main Section Heading (H2) -->
      <h2 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Need AC Service or Repair in Indore?
      </h2>

      <!-- Factual Supporting Copy -->
      <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Talk directly with Patel Cool Tech technicians <strong class="text-white font-semibold">{technicianNames}</strong> for air conditioner installation, troubleshooting, jet-spray servicing, gas refilling, or AMC maintenance.
      </p>

      <!-- Primary & Secondary Direct Actions -->
      <div class="mt-8 sm:mt-10 flex flex-col xs:flex-row items-stretch xs:items-center justify-center gap-3.5 max-w-md mx-auto">
        <Button
          href={business.phones.primaryTel}
          variant="secondary"
          size="lg"
          class="w-full xs:w-auto font-bold justify-center min-h-[48px] px-7 shadow-lg hover:shadow-xl text-base"
          aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call: {business.phones.primaryFormatted}</span>
        </Button>

        <Button
          href={business.phones.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="whatsapp"
          size="lg"
          class="w-full xs:w-auto font-bold justify-center min-h-[48px] px-7 shadow-lg hover:shadow-xl text-base"
          aria-label="Chat with Patel Cool Tech on WhatsApp"
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244zm4.52-6.177c-.248-.124-1.467-.723-1.695-.806-.228-.083-.394-.124-.56.124-.166.248-.644.806-.789.972-.145.166-.29.186-.538.062-.248-.124-1.047-.386-1.995-1.23-.738-.658-1.237-1.47-1.382-1.718-.145-.248-.016-.382.108-.505.112-.111.248-.29.373-.435.124-.145.166-.248.249-.414.083-.166.041-.311-.021-.435-.062-.124-.56-1.349-.767-1.848-.201-.486-.406-.42-.56-.428l-.477-.008c-.166 0-.435.062-.663.311-.228.249-.871.851-.871 2.075 0 1.224.892 2.407 1.016 2.573.124.166 1.755 2.68 4.252 3.757.594.256 1.058.409 1.42.524.597.19 1.14.163 1.57.099.479-.071 1.467-.6 1.674-1.18.207-.58.207-1.077.145-1.18-.062-.104-.228-.166-.477-.29z"/>
          </svg>
          <span>WhatsApp Us</span>
        </Button>
      </div>

      <!-- Quick Verified Contact Details Strip -->
      <div class="mt-10 pt-8 border-t border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-6 text-left sm:text-center">
        <!-- Direct Lines -->
        <div class="space-y-1">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Direct Phone Numbers</h3>
          <p class="text-sm font-medium text-white">
            <a href={business.phones.primaryTel} class="hover:text-brand-ice transition-colors">
              {business.phones.primaryFormatted}
            </a>
          </p>
          <p class="text-xs text-slate-300">
            Alt: <a href={business.phones.secondaryTel} class="hover:text-brand-ice transition-colors">{business.phones.secondaryFormatted}</a>
          </p>
        </div>

        <!-- Service Area -->
        <div class="space-y-1">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Doorstep Coverage</h3>
          <p class="text-sm font-medium text-white">
            Indore &bull; Rau &bull; Pithampur
          </p>
          <p class="text-xs text-slate-300">
            On-site service at your home or workplace
          </p>
        </div>

        <!-- Direct Email -->
        <div class="space-y-1">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Email Inquiries</h3>
          <p class="text-sm font-medium text-white">
            <a href={`mailto:${business.email}`} class="hover:text-brand-ice transition-colors break-all">
              {business.email}
            </a>
          </p>
          <p class="text-xs text-slate-300">
            Quotations &amp; corporate AMC queries
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
