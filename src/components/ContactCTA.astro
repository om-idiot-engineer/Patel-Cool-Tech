---
import { business } from '../data/business';
import Container from './Container.astro';
import Button from './Button.astro';

const technicianNames = business.technicians.map((t) => t.name).join(' & ');
---

<section id="contact" class="py-14 sm:py-20 lg:py-24 bg-brand-navy-dark bg-gradient-to-b from-brand-navy-dark via-[#061224] to-brand-navy-dark text-white relative overflow-hidden scroll-mt-20 bg-tech-dots-dark">
  <!-- Dynamic Atmospheric Cooling Aurora Glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-96 bg-brand-ice/15 rounded-full blur-[100px] pointer-events-none animate-aurora" aria-hidden="true"></div>
  <div class="absolute -bottom-24 right-1/4 w-96 h-80 bg-brand-blue/20 rounded-full blur-[90px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-radial-vignette pointer-events-none" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="max-w-4xl mx-auto text-center reveal-init">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-brand-ice-light border border-white/15 mb-4 sm:mb-6 backdrop-blur-md shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wider uppercase font-extrabold text-[10.5px] sm:text-xs">DIRECT TECHNICIAN ASSISTANCE</span>
      </div>

      <!-- Main Section Heading (H2) -->
      <h2 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-[1.18] sm:leading-tight font-display">
        Need AC Service or Repair in Indore?
      </h2>

      <!-- Factual Supporting Copy -->
      <p class="mt-3 sm:mt-5 text-sm sm:text-base lg:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
        Talk directly with Patel Cool Tech technicians <strong class="text-white font-semibold">{technicianNames}</strong> for air conditioner installation, troubleshooting, jet servicing, gas refilling, or AMC maintenance.
      </p>

      <!-- Direct Technician Contacts: 2x2 Clean Action Grid (Mobile Aligned) -->
      <div class="mt-6 sm:mt-8 max-w-lg mx-auto w-full space-y-2.5">
        <!-- Row 1: Direct Calling -->
        <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
          <!-- Call Mahendra -->
          <a
            href={business.phones.primaryTel}
            class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-white hover:bg-slate-100 text-brand-navy font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-white/20 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
            aria-label={`Call Mahendra Patel at ${business.phones.primaryFormatted}`}
          >
            <div class="w-5 h-5 rounded-lg bg-brand-navy/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-3.5 h-3.5 text-brand-navy flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <span class="whitespace-nowrap font-bold tracking-tight">Call Mahendra</span>
          </a>

          <!-- Call Satyam -->
          <a
            href={business.phones.secondaryTel}
            class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-white hover:bg-slate-100 text-brand-navy font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-white/20 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
            aria-label={`Call Satyam Patel at ${business.phones.secondaryFormatted}`}
          >
            <div class="w-5 h-5 rounded-lg bg-brand-navy/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-3.5 h-3.5 text-brand-navy flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <span class="whitespace-nowrap font-bold tracking-tight">Call Satyam</span>
          </a>
        </div>

        <!-- Row 2: Direct WhatsApp Messaging -->
        <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
          <!-- WhatsApp Mahendra -->
          <a
            href="https://wa.me/919575664203?text=Hello%20Mahendra%20ji%2C%20I%20need%20AC%20service%20in%20Indore"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-emerald-400/20 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
            aria-label="Chat with Mahendra Patel on WhatsApp"
          >
            <div class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
              </svg>
            </div>
            <span class="whitespace-nowrap font-bold tracking-tight">WhatsApp Mahendra</span>
          </a>

          <!-- WhatsApp Satyam -->
          <a
            href="https://wa.me/919425166191?text=Hello%20Satyam%20ji%2C%20I%20need%20AC%20service%20in%20Indore"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-emerald-400/20 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
            aria-label="Chat with Satyam Patel on WhatsApp"
          >
            <div class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
              </svg>
            </div>
            <span class="whitespace-nowrap font-bold tracking-tight">WhatsApp Satyam</span>
          </a>
        </div>
      </div>

      <!-- Quick Verified Contact Details Strip in Glass Cards -->
      <div class="mt-10 sm:mt-14 pt-8 sm:pt-10 border-t border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 text-left">
        <!-- Direct Lines -->
        <div class="card-spotlight-dark p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md relative group overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-brand-ice/40 to-transparent"></div>
          <div>
            <div class="flex items-center gap-2 mb-2 text-brand-ice-light">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <h3 class="text-xs font-bold uppercase tracking-wider font-display">Direct Phone Lines</h3>
            </div>
            <p class="text-xs text-slate-300 mb-2.5">Direct technician contact &bull; Zero broker delay</p>
          </div>
          <div class="space-y-1.5 pt-1 border-t border-white/10">
            <a href={business.phones.primaryTel} class="flex items-center justify-between p-2 rounded-xl bg-white/5 hover:bg-white/10 text-white hover:text-brand-ice transition-colors text-xs sm:text-sm font-bold">
              <span>Mahendra: {business.phones.primaryFormatted}</span>
              <span class="text-[11px] text-brand-ice font-normal">Call ↗</span>
            </a>
            <a href={business.phones.secondaryTel} class="flex items-center justify-between p-2 rounded-xl bg-white/5 hover:bg-white/10 text-white hover:text-brand-ice transition-colors text-xs sm:text-sm font-bold">
              <span>Satyam: {business.phones.secondaryFormatted}</span>
              <span class="text-[11px] text-brand-ice font-normal">Call ↗</span>
            </a>
          </div>
        </div>

        <!-- Service Area -->
        <div class="card-spotlight-dark p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md relative group overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-brand-cyan/40 to-transparent"></div>
          <div>
            <div class="flex items-center gap-2 mb-2 text-cyan-300">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <h3 class="text-xs font-bold uppercase tracking-wider font-display">Doorstep Coverage</h3>
            </div>
            <p class="text-sm font-bold text-white mt-1">
              Indore &bull; Rau &bull; Pithampur &bull; Khandwa
            </p>
          </div>
          <p class="text-xs text-slate-300 mt-3 pt-2 border-t border-white/10 leading-relaxed">
            On-site visits at residences, commercial offices &amp; industrial units.
          </p>
        </div>

        <!-- Direct Email -->
        <div class="card-spotlight-dark p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md relative group overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-sky-400/40 to-transparent"></div>
          <div>
            <div class="flex items-center gap-2 mb-2 text-sky-300">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <h3 class="text-xs font-bold uppercase tracking-wider font-display">Email &amp; Quotations</h3>
            </div>
            <a href={`mailto:${business.email}`} class="text-xs sm:text-sm font-bold text-white hover:text-brand-ice transition-colors break-all block mt-1">
              {business.email}
            </a>
          </div>
          <p class="text-xs text-slate-300 mt-3 pt-2 border-t border-white/10 leading-relaxed">
            Official proposals, invoices &amp; annual maintenance contracts (AMC).
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
