---
import { business } from '../data/business';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';

const technicians = business.technicians.map((tech) => {
  const initials = tech.name
    .split(' ')
    .map((part) => part[0])
    .join('');
  return {
    ...tech,
    initials,
  };
});
---

<section id="about" class="py-14 sm:py-20 lg:py-24 bg-brand-surface border-b border-brand-border scroll-mt-20">
  <Container>
    <div class="reveal-init">
      <SectionHeading
        badge="About Us"
        title="Meet the People Behind Patel Cool Tech"
        subtitle="Patel Cool Tech is locally operated by Mahendra Patel and Satyam Patel. We provide hands-on, on-site air conditioning installation, repair, servicing, gas refilling, and AMC support across Indore and surrounding areas."
        align="center"
      />
    </div>

    <!-- Technicians Presentation Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto mt-10">
      {
        technicians.map((tech, idx) => (
          <article class={`flex flex-col sm:flex-row items-center sm:items-start gap-5 p-6 sm:p-7 bg-white rounded-2xl border border-brand-border/90 shadow-soft card-hover-effect reveal-init stagger-${idx + 1}`}>
            <!-- Initials Avatar -->
            <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gradient-to-br from-brand-navy to-brand-blue flex items-center justify-center text-white font-extrabold text-2xl sm:text-3xl flex-shrink-0 shadow-soft border-2 border-white">
              <span class="tracking-wider">{tech.initials}</span>
              <span class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-[10px] text-white font-bold" title="Active on-site technician">
                ✓
              </span>
            </div>

            <!-- Details -->
            <div class="flex-grow text-center sm:text-left">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-surface-alt text-brand-blue border border-brand-border mb-1.5">
                {tech.role}
              </span>
              <h3 class="text-xl font-bold text-brand-navy">
                {tech.name}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-brand-text-muted leading-relaxed">
                Directly handling on-site AC installation, troubleshooting electrical and cooling issues, refrigerant refilling, and seasonal maintenance across Indore, Rau, and Pithampur.
              </p>

              <!-- Technician Action Links -->
              <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center justify-center sm:justify-start gap-3">
                <a
                  href={business.phones.primaryTel}
                  class="text-xs font-bold text-brand-blue hover:text-brand-ice transition-colors flex items-center gap-1.5 py-1 min-h-[44px]"
                  aria-label={`Call ${tech.name} at ${business.phones.primaryFormatted}`}
                >
                  <svg class="w-3.5 h-3.5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>{business.phones.primaryFormatted}</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Direct Accountability Banner -->
    <div class="mt-10 max-w-4xl mx-auto p-6 bg-white rounded-2xl border border-brand-border flex flex-col sm:flex-row items-center justify-between gap-5 text-center sm:text-left shadow-soft reveal-init">
      <div class="space-y-1">
        <h4 class="text-base font-bold text-brand-navy">Direct On-Site Accountability</h4>
        <p class="text-xs sm:text-sm text-brand-text-muted">
          No third-party brokers or outsourced call centers. The people you consult with are the technicians who perform your AC service.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-shrink-0 w-full sm:w-auto">
        <Button
          href="/about/"
          variant="outline"
          size="sm"
          class="font-bold px-4 min-h-[44px] justify-center"
          aria-label="Learn more about the Patel Cool Tech team"
        >
          About Our Team &rarr;
        </Button>
        <Button
          href={business.phones.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="whatsapp"
          size="sm"
          class="font-bold px-4 min-h-[44px] justify-center"
          aria-label="Message Mahendra and Satyam on WhatsApp"
        >
          Message on WhatsApp
        </Button>
      </div>
    </div>
  </Container>
</section>
