---
import Container from './Container.astro';
import Button from './Button.astro';
import { business } from '../data/business';

interface Props {
  serviceTitle: string;
  tagline?: string;
  notice?: string;
}

const {
  serviceTitle,
  tagline = 'Reach out directly to discuss your requirements or request an on-site visit.',
  notice = 'Patel Cool Tech serves customers across Indore, including Rau, Pithampur, and nearby areas.',
} = Astro.props;
---

<section class="py-14 sm:py-18 bg-brand-navy-dark text-white border-b border-slate-800 relative overflow-hidden">
  <!-- Subtle technical graphic backdrop -->
  <div class="absolute inset-0 pointer-events-none opacity-5" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="service-cta-pattern" width="60" height="60" patternUnits="userSpaceOnUse">
          <circle cx="30" cy="30" r="1.5" fill="#38BDF8" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#service-cta-pattern)" />
    </svg>
  </div>

  <Container class="relative z-10 text-center max-w-4xl mx-auto">
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-navy-light text-brand-ice border border-brand-navy-light/60 mb-5">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="tracking-wider uppercase text-[11px] font-bold">DIRECT LOCAL TECHNICIAN CONTACT</span>
    </div>

    <!-- Conversion Heading -->
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight">
      Need {serviceTitle} Support in Indore?
    </h2>

    <!-- Tagline -->
    <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      {tagline}
    </p>

    <!-- Technicians and Service Area Notice -->
    <div class="mt-5 p-4 rounded-xl bg-brand-navy-light/40 border border-slate-700/60 max-w-xl mx-auto text-xs sm:text-sm text-slate-300">
      <p class="font-medium text-white mb-1">
        Technicians: {business.technicians.map((t) => t.name).join(' & ')}
      </p>
      <p class="text-slate-400 text-xs">
        {notice}
      </p>
    </div>

    <!-- CTA Buttons Row -->
    <div class="mt-8 flex flex-col xs:flex-row items-center justify-center gap-4">
      <Button
        href={business.phones.primaryTel}
        variant="primary"
        size="lg"
        class="w-full xs:w-auto justify-center font-bold px-7 py-3.5 min-h-[48px] text-sm sm:text-base shadow-card hover:shadow-hover"
        aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
      >
        <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call: {business.phones.primaryFormatted}</span>
      </Button>

      <Button
        href={business.phones.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="whatsapp"
        size="lg"
        class="w-full xs:w-auto justify-center font-bold px-7 py-3.5 min-h-[48px] text-sm sm:text-base shadow-card hover:shadow-hover"
        aria-label="Chat with Patel Cool Tech on WhatsApp"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
        </svg>
        <span>WhatsApp Inquiry</span>
      </Button>
    </div>

    <!-- Secondary Phone & Directory Link -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-400">
      <span>Alternative Phone: <a href={business.phones.secondaryTel} class="text-brand-ice hover:underline font-semibold">{business.phones.secondaryFormatted}</a></span>
      <span class="hidden sm:inline text-slate-600">&bull;</span>
      <a href="/services/" class="text-slate-300 hover:text-white underline">
        Explore all services &rarr;
      </a>
    </div>
  </Container>
</section>
