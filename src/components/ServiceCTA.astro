---
import Container from './Container.astro';
import Button from './Button.astro';
import { business } from '../data/business';

interface Props {
  serviceTitle: string;
  tagline?: string;
  notice?: string;
}

const {
  serviceTitle,
  tagline = 'Reach out directly to discuss your requirements or request an on-site visit.',
  notice = 'Patel Cool Tech serves customers across Indore, including Rau, Pithampur, and nearby areas.',
} = Astro.props;
---

<section class="py-18 sm:py-22 lg:py-26 bg-brand-navy-dark bg-gradient-to-b from-brand-navy-dark via-[#061224] to-brand-navy-dark text-white border-b border-slate-800 relative overflow-hidden bg-tech-dots-dark">
  <!-- Dynamic Atmospheric Cooling Aurora Glow -->
  <div class="absolute -top-28 left-1/2 -translate-x-1/2 w-[650px] h-80 bg-brand-ice/15 rounded-full blur-[100px] pointer-events-none animate-aurora" aria-hidden="true"></div>
  <div class="absolute -bottom-20 right-1/4 w-80 h-72 bg-brand-blue/20 rounded-full blur-[80px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-radial-vignette pointer-events-none" aria-hidden="true"></div>

  <Container class="relative z-10 text-center max-w-4xl mx-auto reveal-init">
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-brand-ice-light border border-white/15 mb-5 backdrop-blur-md shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="tracking-wider uppercase text-[11px] font-extrabold">DIRECT LOCAL TECHNICIAN CONTACT</span>
    </div>

    <!-- Conversion Heading -->
    <h2 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight font-display">
      Need {serviceTitle} Support in Indore?
    </h2>

    <!-- Tagline -->
    <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      {tagline}
    </p>

    <!-- Technicians and Service Area Notice in Glass Card -->
    <div class="mt-6 p-5 rounded-2xl bg-white/[0.05] border border-white/10 backdrop-blur-md max-w-xl mx-auto text-xs sm:text-sm text-slate-300 shadow-sm relative group overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-[1.5px] bg-gradient-to-r from-transparent via-brand-ice/30 to-transparent"></div>
      <p class="font-bold text-white mb-1 font-display">
        Technicians: {business.technicians.map((t) => t.name).join(' & ')}
      </p>
      <p class="text-slate-300 text-xs">
        {notice}
      </p>
    </div>

    <!-- CTA Buttons Row -->
    <div class="mt-8 sm:mt-10 flex flex-col xs:flex-row items-stretch xs:items-center justify-center gap-3 sm:gap-4 max-w-md mx-auto w-full">
      <Button
        href={business.phones.primaryTel}
        variant="primary"
        size="lg"
        class="flex-1 xs:flex-1 sm:flex-initial w-full xs:w-auto justify-center font-bold px-3.5 xs:px-4 sm:px-8 py-3 sm:py-3.5 min-h-[48px] sm:min-h-[50px] text-xs xs:text-sm sm:text-base whitespace-nowrap shadow-card hover:shadow-glow-cyan active:scale-[0.98] transition-all group"
        aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
      >
        <div class="w-5 h-5 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-3.5 h-3.5 text-brand-ice flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <span class="hidden sm:inline whitespace-nowrap">Call: {business.phones.primaryFormatted}</span>
        <span class="sm:hidden whitespace-nowrap">Call Now</span>
      </Button>

      <Button
        href={business.phones.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="whatsapp"
        size="lg"
        class="flex-1 xs:flex-1 sm:flex-initial w-full xs:w-auto justify-center font-bold px-3.5 xs:px-4 sm:px-8 py-3 sm:py-3.5 min-h-[48px] sm:min-h-[50px] text-xs xs:text-sm sm:text-base whitespace-nowrap shadow-card hover:shadow-lg active:scale-[0.98] transition-all group"
        aria-label="Chat with Patel Cool Tech on WhatsApp"
      >
        <div class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
          </svg>
        </div>
        <span class="whitespace-nowrap">WhatsApp Inquiry</span>
      </Button>
    </div>

    <!-- Secondary Phone & Directory Link -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-300">
      <span>Alternative Phone: <a href={business.phones.secondaryTel} class="text-brand-ice hover:underline font-semibold">{business.phones.secondaryFormatted}</a></span>
      <span class="hidden sm:inline text-slate-600">&bull;</span>
      <a href="/services/" class="text-slate-300 hover:text-white underline">
        Explore all services &rarr;
      </a>
    </div>
  </Container>
</section>
