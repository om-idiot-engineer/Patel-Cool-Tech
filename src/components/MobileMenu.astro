---
import { business } from '../data/business';
import { siteConfig } from '../data/site';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings } from '../utils/supabase';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};

const settings = await getSiteSettings();

// Clean modern icons for navigation routes
const navIcons: Record<string, string> = {
  '/': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
  '/services/': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
  '/our-work/': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  '/about/': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
  '/contact/': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`,
};
---

<!-- Background Backdrop Overlay with Blur -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Slide-out Drawer Panel -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-y-0 left-0 z-50 w-[86%] max-w-[340px] bg-white shadow-2xl flex flex-col justify-between overflow-y-auto transform -translate-x-full transition-transform duration-300 ease-out md:hidden border-r border-slate-200"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Menu"
>
  <!-- Top Specular Brand Gradient Accent Line -->
  <div class="h-1.5 w-full bg-gradient-to-r from-brand-ice via-sky-500 to-brand-navy flex-shrink-0" aria-hidden="true"></div>

  <!-- Main Drawer Body (Header + Nav + Highlights) -->
  <div class="p-5 flex-1 flex flex-col">
    <!-- Top Header in Drawer -->
    <div class="flex items-center justify-between pb-3.5 border-b border-slate-100">
      <BrandLogo size="sm" customLogoUrl={settings?.logo_url} />
      <button
        type="button"
        id="mobile-menu-close-btn"
        class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-500 hover:text-brand-navy flex items-center justify-center border border-slate-200/70 transition-all cursor-pointer"
        aria-label="Close navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Active Service Status Badge -->
    <div class="mt-3 px-3 py-2 bg-gradient-to-r from-sky-50/90 to-blue-50/60 border border-sky-100 rounded-xl flex items-center justify-between text-xs">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-semibold text-brand-navy">Available in Indore &amp; Rau</span>
      </div>
      <span class="text-[10px] font-bold text-brand-ice uppercase tracking-wider bg-white px-2 py-0.5 rounded-md border border-sky-200/70 shadow-sm">Doorstep</span>
    </div>

    <!-- Navigation Links -->
    <nav class="mt-4 flex flex-col space-y-1.5" aria-label="Mobile primary navigation">
      {
        siteConfig.navItems.map((item) => {
          const active = isCurrent(item.href);
          const iconPath = navIcons[item.href] || navIcons['/'];
          return (
            <a
              href={item.href}
              class:list={[
                'mobile-nav-link group px-3.5 py-2.5 rounded-xl text-sm transition-all flex items-center justify-between min-h-[46px] active:scale-[0.98]',
                active
                  ? 'bg-gradient-to-r from-sky-50 to-blue-50/80 text-brand-blue border border-sky-200/90 shadow-sm font-bold'
                  : 'text-slate-700 hover:text-brand-navy hover:bg-slate-50 active:bg-slate-100 border border-transparent font-medium',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    'w-8 h-8 rounded-lg flex items-center justify-center transition-colors flex-shrink-0',
                    active
                      ? 'bg-brand-ice text-white shadow-sm'
                      : 'bg-slate-100 text-slate-500 group-hover:bg-sky-50 group-hover:text-brand-ice',
                  ]}
                  aria-hidden="true"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconPath} />
                </span>
                <span class="tracking-tight text-[14px]">{item.label}</span>
              </div>
              <svg
                class:list={[
                  'w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5',
                  active ? 'text-brand-ice' : 'text-slate-300 group-hover:text-slate-500',
                ]}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })
      }
    </nav>

    <!-- Cool Quick Highlight Card (Doorstep AC Support) -->
    <div class="mt-auto pt-4">
      <div class="rounded-xl bg-slate-50 p-3.5 border border-slate-200/70">
        <div class="flex items-center gap-2 mb-1">
          <div class="w-6 h-6 rounded-md bg-brand-navy text-brand-ice flex items-center justify-center flex-shrink-0 shadow-sm">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-brand-navy">Fast 60-Min AC Doorstep Service</span>
        </div>
        <p class="text-[11px] text-slate-500 leading-relaxed">
          Installation &bull; Repair &bull; Gas Refill &bull; AMC
        </p>
        <div class="mt-2 pt-2 border-t border-slate-200/60 flex items-center gap-1.5 text-[10px] text-slate-600 font-medium">
          <svg class="w-3 h-3 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>Verified Local Technicians &bull; Fair Pricing</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Contact Footer in Drawer (Clean, Non-repetitive) -->
  <div class="p-5 pt-3.5 bg-slate-50 border-t border-slate-200 space-y-3">
    <!-- Action Buttons Row -->
    <div class="space-y-2">
      <!-- Call Primary Action -->
      <a
        href={business.phones.primaryTel}
        class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-navy hover:bg-brand-navy-light text-white rounded-xl font-bold text-xs shadow-sm hover:shadow transition-all active:scale-[0.98]"
        aria-label="Call Patel Cool Tech primary number"
      >
        <svg class="w-3.5 h-3.5 text-brand-ice flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call: {business.phones.primaryFormatted}</span>
      </a>

      <!-- WhatsApp Action -->
      <a
        href={business.phones.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white rounded-xl font-bold text-xs shadow-sm hover:shadow transition-all active:scale-[0.98]"
        aria-label="Chat with Patel Cool Tech on WhatsApp"
      >
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
        </svg>
        <span>Chat on WhatsApp</span>
      </a>
    </div>

    <!-- Clean Secondary Line & Areas -->
    <div class="pt-2 border-t border-slate-200 text-[11px] text-slate-500 space-y-1">
      <div class="flex items-center justify-between">
        <span>Alternate Call:</span>
        <a href={business.phones.secondaryTel} class="font-semibold text-brand-navy hover:text-brand-ice transition-colors">
          {business.phones.secondaryFormatted}
        </a>
      </div>
      <div class="flex items-center justify-between text-[10px] text-slate-400">
        <span>Technicians:</span>
        <span class="font-medium text-slate-600 truncate">{business.technicians.map((t) => t.name.split(' ')[0]).join(' & ')} Patel &bull; Indore</span>
      </div>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const drawer = document.getElementById('mobile-menu-drawer');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    const toggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!drawer || !backdrop || !closeBtn || !toggleBtn) return;

    function getFocusableElements(): HTMLElement[] {
      if (!drawer) return [];
      const focusable = drawer.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      return Array.from(focusable).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
    }

    function openMenu() {
      drawer?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('pointer-events-none', 'opacity-0');
      backdrop?.classList.add('opacity-100', 'pointer-events-auto');
      drawer?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      toggleBtn?.setAttribute('aria-label', 'Close navigation menu');
      document.body.style.overflow = 'hidden';

      // Stagger animate nav links into view
      navLinks.forEach((link, index) => {
        const el = link as HTMLElement;
        el.style.opacity = '0';
        el.style.transform = 'translateX(-12px)';
        el.style.transition = 'opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
        setTimeout(() => {
          el.style.opacity = '1';
          el.style.transform = 'translateX(0)';
        }, 50 + index * 35);
      });

      closeBtn?.focus();
    }

    function closeMenu() {
      drawer?.classList.add('-translate-x-full');
      backdrop?.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      drawer?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleBtn?.setAttribute('aria-label', 'Open navigation menu');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    let isKeydownBound = false;

    toggleBtn.onclick = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    closeBtn.onclick = closeMenu;
    backdrop.onclick = closeMenu;

    navLinks.forEach((link) => {
      (link as HTMLElement).onclick = closeMenu;
    });

    if (!isKeydownBound) {
      document.addEventListener('keydown', (event) => {
        const isOpen = drawer.getAttribute('aria-hidden') === 'false';
        if (!isOpen) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closeMenu();
          return;
        }

        if (event.key === 'Tab') {
          const focusable = getFocusableElements();
          if (focusable.length === 0) return;

          const firstElement = focusable[0];
          const lastElement = focusable[focusable.length - 1];

          if (event.shiftKey) {
            if (document.activeElement === firstElement) {
              event.preventDefault();
              lastElement.focus();
            }
          } else {
            if (document.activeElement === lastElement) {
              event.preventDefault();
              firstElement.focus();
            }
          }
        }
      });
      isKeydownBound = true;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
