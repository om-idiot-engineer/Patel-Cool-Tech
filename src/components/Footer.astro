---
import { business } from '../data/business';
import { siteConfig } from '../data/site';
import Container from './Container.astro';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings } from '../utils/supabase';

const currentYear = new Date().getFullYear();
const settings = await getSiteSettings();
---

<footer class="bg-brand-navy-dark text-white pt-12 sm:pt-14 pb-20 sm:pb-12 border-t border-slate-800" role="contentinfo">
  <Container>
    <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 pb-10 sm:pb-12 border-b border-slate-800">
      <!-- 1. Brand & Identity Info (Full width on mobile, 4 cols on desktop) -->
      <div class="col-span-2 md:col-span-2 lg:col-span-4 space-y-3.5">
        <div class="flex items-center justify-between sm:justify-start gap-3 flex-wrap">
          <BrandLogo variant="light" size="md" customLogoUrl={settings?.logo_url} />
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Indore Direct HVAC
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-sm">
          {business.shortDescription}
        </p>
        <div class="p-3 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-slate-300 flex items-center gap-2.5 max-w-sm">
          <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-sm flex-shrink-0">
            👨‍🔧
          </div>
          <div>
            <span class="font-semibold text-white">Direct On-Site Technicians:</span>
            <p class="text-slate-300 text-[11px] mt-0.5">{business.technicians.map((t) => t.name).join(' & ')}</p>
          </div>
        </div>
      </div>

      <!-- 2. Quick Links (1 col on mobile, 2 cols on desktop) -->
      <div class="col-span-1 md:col-span-1 lg:col-span-2">
        <h3 class="font-bold text-xs sm:text-sm uppercase tracking-wider text-slate-200 mb-3 sm:mb-4 font-display">
          Navigation
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          {
            siteConfig.footerNavItems.map((item) => (
              <li>
                <a href={item.href} class="text-slate-300 hover:text-brand-ice transition-colors inline-block py-0.5">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 3. Service Areas (1 col on mobile, 3 cols on desktop) -->
      <div class="col-span-1 md:col-span-1 lg:col-span-3">
        <h3 class="font-bold text-xs sm:text-sm uppercase tracking-wider text-slate-200 mb-3 sm:mb-4 font-display">
          Coverage
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>
            <span class="font-medium text-white">Indore</span>
            <span class="text-[10px] text-slate-400 hidden xs:inline">(City Base)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>
            <span class="font-medium text-white">Rau</span>
            <span class="text-[10px] text-slate-400 hidden xs:inline">(Bypass)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>
            <span class="font-medium text-white">Pithampur</span>
            <span class="text-[10px] text-slate-400 hidden xs:inline">(Industrial)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>
            <span class="font-medium text-white">Khandwa</span>
            <span class="text-[10px] text-slate-400 hidden xs:inline">(Regional)</span>
          </li>
        </ul>
        <p class="text-[11px] text-slate-400 mt-2.5 leading-snug">
          Doorstep visits across residential &amp; industrial hubs.
        </p>
      </div>

      <!-- 4. Direct Contact (Full width on mobile, 3 cols on desktop) -->
      <div class="col-span-2 md:col-span-2 lg:col-span-3">
        <h3 class="font-bold text-xs sm:text-sm uppercase tracking-wider text-slate-200 mb-3 sm:mb-4 font-display">
          Contact Technicians
        </h3>
        <div class="p-4 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-sm space-y-3">
          <!-- Calls -->
          <div>
            <p class="text-[11px] font-bold text-brand-ice-light uppercase tracking-wider mb-1.5">Direct Lines</p>
            <div class="space-y-1">
              <a href={business.phones.primaryTel} class="flex items-center justify-between p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-white hover:text-brand-ice transition-colors text-xs font-bold">
                <span>Mahendra: {business.phones.primaryFormatted}</span>
                <span class="text-[10px] text-brand-ice font-normal">Call ↗</span>
              </a>
              <a href={business.phones.secondaryTel} class="flex items-center justify-between p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-white hover:text-brand-ice transition-colors text-xs font-bold">
                <span>Satyam: {business.phones.secondaryFormatted}</span>
                <span class="text-[10px] text-brand-ice font-normal">Call ↗</span>
              </a>
            </div>
          </div>

          <!-- Email & Location -->
          <div class="pt-2 border-t border-white/10 space-y-1.5 text-xs text-slate-300">
            <a href={`mailto:${business.email}`} class="flex items-center gap-2 hover:text-brand-ice transition-colors break-all">
              <svg class="w-3.5 h-3.5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>{business.email}</span>
            </a>

            <div class="flex items-center justify-between pt-0.5">
              <span class="text-slate-400">{business.city}, {business.state}</span>
              <a
                href={business.googleBusinessProfile.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-ice hover:underline text-[11px] font-medium inline-flex items-center gap-0.5"
                aria-label="View Patel Cool Tech on Google Maps (opens in new tab)"
              >
                <span>Google Maps</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Legal & Disclaimer Footnote -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 text-center sm:text-left">
      <div>
        <p>&copy; {currentYear} {business.name}. All rights reserved.</p>
        <p class="mt-1 text-[11px] text-slate-500">
          {business.disclaimers.brands}
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-[11px] text-slate-400">
        <span class="text-slate-400">Indore &bull; Rau &bull; Pithampur</span>
      </div>
  </Container>
</footer>
