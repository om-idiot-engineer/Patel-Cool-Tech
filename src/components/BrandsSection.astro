---
import { brands, brandSectionHeadline, brandSectionSubtext, brandDisclaimer } from '../data/brands';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="py-14 sm:py-20 bg-brand-surface border-b border-brand-border">
  <Container>
    <div class="reveal-init">
      <SectionHeading
        badge="Supported Makes"
        title={brandSectionHeadline}
        subtitle={brandSectionSubtext}
        align="center"
      />
    </div>

    <!-- Clean, Responsive Brand Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5 max-w-5xl mx-auto mt-10">
      {
        brands.map((brand, idx) => {
          const isLast = idx === brands.length - 1;
          return (
            <div
              class:list={[
                'flex flex-col items-center justify-center p-5 sm:p-6 rounded-2xl bg-white border border-brand-border/90 hover:border-brand-blue/50 hover:shadow-card transition-all duration-200 text-center card-hover-effect reveal-init',
                `stagger-${(idx % 4) + 1}`,
                isLast ? 'col-span-2 sm:col-span-1 lg:col-span-2 xl:col-span-1' : '',
              ]}
            >
              <div class="w-10 h-10 rounded-xl bg-brand-blue-light text-brand-blue flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                </svg>
              </div>
              <span class="text-base sm:text-lg font-bold text-brand-navy tracking-tight">
                {brand.name}
              </span>
              <span class="mt-1 text-[11px] sm:text-xs text-brand-text-subtle font-medium">
                Split &amp; Window Units
              </span>
            </div>
          );
        })
      }
    </div>

    <!-- Independent Service Clarification & Legal Disclaimer -->
    <div class="mt-10 max-w-3xl mx-auto p-5 rounded-2xl bg-white border border-brand-border text-center shadow-soft reveal-init">
      <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed font-medium">
        <strong class="text-brand-navy">Independent Service Notice:</strong> We provide independent air conditioning maintenance, diagnosis, and repair support for split and window systems from leading manufacturers.
      </p>
      <p class="mt-2 text-[11px] sm:text-xs text-brand-text-subtle leading-normal">
        {brandDisclaimer}
      </p>
    </div>
  </Container>
</section>
