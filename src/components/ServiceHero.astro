---
import Container from './Container.astro';
import Button from './Button.astro';
import { business } from '../data/business';

interface Props {
  h1: string;
  category: string;
  badge: string;
  description: string;
  breadcrumbCurrent: string;
  iconName?: string;
}

const {
  h1,
  category,
  badge,
  description,
  breadcrumbCurrent,
  iconName = 'wrench',
} = Astro.props;
---

<section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-8 sm:pb-16 lg:pt-12 lg:pb-20 border-b border-brand-border overflow-hidden">
  <!-- Subtle technical ambient pattern -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="service-hero-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0B1F3A" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#service-hero-pattern)" />
    </svg>
  </div>

  <Container class="relative z-10">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-5 sm:mb-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-brand-text-subtle">
        <li>
          <a href="/" class="hover:text-brand-blue transition-colors flex items-center gap-1">
            <span>Home</span>
          </a>
        </li>
        <li class="select-none" aria-hidden="true">&rsaquo;</li>
        <li>
          <a href="/services/" class="hover:text-brand-blue transition-colors">
            Services
          </a>
        </li>
        <li class="select-none" aria-hidden="true">&rsaquo;</li>
        <li class="font-semibold text-brand-navy" aria-current="page">
          {breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-8 flex flex-col items-start text-left">
        <!-- Category & Location Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-surface-alt text-brand-navy border border-brand-border mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span class="tracking-wide uppercase text-[11px] sm:text-xs text-brand-navy font-bold">{badge} &bull; INDORE</span>
        </div>

        <!-- H1 Heading -->
        <h1 class="text-2xl xs:text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight text-brand-navy leading-[1.18] sm:leading-[1.15]">
          {h1}
        </h1>

        <!-- Category Identifier -->
        <p class="mt-2 text-xs sm:text-sm font-semibold uppercase tracking-wider text-brand-ice">
          {category} &bull; Indore &bull; Rau &bull; Pithampur
        </p>

        <!-- Service Description -->
        <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed max-w-2xl">
          {description}
        </p>

        <!-- Technicians & Direct Touchpoint Bar -->
        <div class="mt-5 p-3.5 sm:p-4 rounded-xl bg-brand-surface border border-brand-border/80 w-full max-w-2xl text-xs sm:text-sm text-brand-text">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>Direct on-site support by <strong>{business.technicians.map((t) => t.name).join(' & ')}</strong></span>
            </div>
            <div class="text-brand-text-subtle text-[11px] sm:text-xs">
              No middleman &bull; Local Indore HVAC
            </div>
          </div>
        </div>

        <!-- Call and WhatsApp Action Buttons -->
        <div class="mt-6 sm:mt-8 flex flex-col xs:flex-row items-stretch xs:items-center gap-3 w-full sm:w-auto">
          <!-- Primary CTA: Call Now -->
          <Button
            href={business.phones.primaryTel}
            variant="primary"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold shadow-card hover:shadow-hover text-sm sm:text-base px-6 py-3.5 min-h-[48px]"
            aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
          >
            <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call Now: {business.phones.primaryFormatted}</span>
          </Button>

          <!-- Secondary CTA: WhatsApp Us -->
          <Button
            href={business.phones.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold shadow-card hover:shadow-hover text-sm sm:text-base px-6 py-3.5 min-h-[48px]"
            aria-label="Inquire via WhatsApp with Patel Cool Tech"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
            </svg>
            <span>WhatsApp Us</span>
          </Button>
        </div>
      </div>

      <!-- Right Column: Visual Feature Card -->
      <div class="lg:col-span-4 hidden lg:flex flex-col">
        <div class="relative rounded-2xl bg-white border border-brand-border p-6 shadow-card hover:shadow-hover transition-shadow">
          <div class="w-14 h-14 rounded-2xl bg-brand-blue-light text-brand-blue flex items-center justify-center mb-5">
            {iconName === 'wrench' && (
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            )}
            {iconName === 'tool' && (
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
              </svg>
            )}
            {iconName === 'refresh-cw' && (
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            )}
            {iconName === 'gauge' && (
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {iconName === 'shield-check' && (
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
          </div>

          <h2 class="text-base font-bold text-brand-navy mb-2">Service Quick Overview</h2>
          <ul class="space-y-2.5 text-xs text-brand-text-muted">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-ice flex-shrink-0"></span>
              <span>On-site service in Indore, Rau & Pithampur</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-ice flex-shrink-0"></span>
              <span>Residential & commercial air conditioners</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-ice flex-shrink-0"></span>
              <span>All major Indian AC brands supported</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-ice flex-shrink-0"></span>
              <span>No call center delay—call or WhatsApp directly</span>
            </li>
          </ul>

          <div class="mt-5 pt-4 border-t border-brand-border/80 flex items-center justify-between text-xs font-semibold text-brand-blue">
            <span>Second Phone:</span>
            <a href={business.phones.secondaryTel} class="hover:text-brand-ice transition-colors">
              {business.phones.secondaryFormatted}
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
