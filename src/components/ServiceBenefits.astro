---
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import type { ServiceBenefitItem } from '../data/servicePages';

interface Props {
  heading?: string;
  intro?: string;
  benefits: ServiceBenefitItem[];
}

const {
  heading = 'Why Contact Patel Cool Tech',
  intro = 'Direct, practical air conditioning services delivered by local technicians across Indore and nearby areas.',
  benefits,
} = Astro.props;
---

<section class="py-12 sm:py-16 bg-white border-b border-brand-border">
  <Container>
    <SectionHeading
      badge="Why Choose Us"
      title={heading}
      subtitle={intro}
      align="center"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        benefits.map((benefit, index) => (
          <div class={`card-spotlight bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-7 border border-brand-border/90 hover:border-brand-ice/50 shadow-card hover:shadow-card-elevated card-hover-effect transition-all duration-300 flex flex-col justify-between reveal-init stagger-${(index % 4) + 1} relative overflow-hidden group active:scale-[0.99] sm:active:scale-100`}>
            <!-- Top hover accent line -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>

            <div>
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-blue-light to-sky-100/60 text-brand-blue border border-brand-blue/15 flex items-center justify-center mb-4 shadow-sm group-hover:scale-105 transition-transform duration-300">
                {index === 0 && (
                  <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                )}
                {index === 1 && (
                  <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
                {index === 2 && (
                  <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z" />
                  </svg>
                )}
                {index >= 3 && (
                  <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
              </div>
              <h3 class="text-base sm:text-lg font-bold text-brand-navy font-display group-hover:text-brand-blue transition-colors mb-2">
                {benefit.title}
              </h3>
              <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed">
                {benefit.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
