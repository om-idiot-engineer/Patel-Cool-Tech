---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { title, subtitle, badge, align = 'center', class: className = '' } = Astro.props;

const alignmentClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class:list={['max-w-3xl mb-8 sm:mb-12', alignmentClass, className]}>
  {
    badge && (
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-brand-surface-alt text-brand-blue border border-brand-border mb-3">
        {badge}
      </span>
    )
  }
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-brand-navy">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-3 text-base sm:text-lg text-brand-text-muted leading-relaxed">
        {subtitle}
      </p>
    )
  }
</div>
