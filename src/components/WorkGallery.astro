---
import { workItems } from '../data/work';

interface Props {
  columns?: 2 | 4;
}

const { columns = 2 } = Astro.props;
const gridClass = columns === 4 
  ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6'
  : 'grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8';
---

<div class={`grid ${gridClass} items-stretch`}>
  {
    workItems.map((item) => (
      <article class="flex flex-col bg-white rounded-2xl overflow-hidden border border-brand-border/90 hover:border-brand-blue/50 transition-all duration-200 hover:shadow-card group">
        <!-- Visual Container (Placeholder SVG architecture, ready for drop-in webp/jpg photography) -->
        <div class="relative w-full aspect-[16/10] bg-brand-surface-alt overflow-hidden border-b border-brand-border/60">
          <img
            src={item.image}
            alt={item.alt}
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
          />
          <!-- Category Chip -->
          <span class="absolute top-3 left-3 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-brand-navy/90 text-white backdrop-blur-sm shadow-sm">
            {item.category}
          </span>

          <!-- Technical Reference Badge -->
          <span class="absolute bottom-2.5 right-3 px-2 py-0.5 rounded text-[10px] font-medium bg-white/90 text-brand-text-muted backdrop-blur-sm border border-brand-border/60">
            Field Workflow
          </span>
        </div>

        <!-- Content Details -->
        <div class="p-6 flex flex-col flex-grow justify-between">
          <div>
            <h3 class="text-xl font-bold text-brand-navy mb-2 leading-snug group-hover:text-brand-blue transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-brand-text-muted leading-relaxed mb-4">
              {item.shortDescription}
            </p>

            <!-- Key Scope Points -->
            <ul class="space-y-2 mb-6 border-t border-brand-border/60 pt-4" role="list">
              {item.keyPoints.map((point) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-brand-text">
                  <svg class="w-4 h-4 text-brand-ice flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Action & Internal Linking to Dedicated Service Page -->
          <div class="pt-4 border-t border-brand-border/60 flex flex-col xs:flex-row items-stretch xs:items-center justify-between gap-3">
            <a
              href={item.serviceUrl}
              class="inline-flex items-center justify-center gap-1.5 text-sm font-bold text-brand-blue hover:text-brand-navy transition-colors py-2 min-h-[48px] focus-visible:outline-2 focus-visible:outline-brand-blue rounded-md"
              aria-label={`View detailed ${item.title} specifications and service workflow`}
            >
              <span>{item.serviceName}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>

            <span class="text-[11px] text-brand-text-subtle text-center xs:text-right">
              Split &amp; Window Units
            </span>
          </div>
        </div>
      </article>
    ))
  }
</div>
