---
import type { WorkItemDB } from '../types/database';
import { defaultFallbackWork } from '../utils/supabase';

interface Props {
  items?: WorkItemDB[];
  columns?: 2 | 3 | 4;
  showFilters?: boolean;
}

const {
  items = defaultFallbackWork,
  columns = 3,
  showFilters = true,
} = Astro.props;

const categories = [
  'All',
  'Installation',
  'Repair',
  'AC Service',
  'Gas Refilling',
  'Maintenance / AMC',
];

const gridColsClass = {
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<div class="work-gallery-root" data-gallery-id="main-work-gallery">
  {showFilters && (
    <!-- Interactive Category Filter Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 mb-8 sm:mb-10 reveal-init" role="tablist" aria-label="Work category filters">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class:list={[
            'gallery-filter-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl sm:rounded-2xl text-xs sm:text-sm font-bold tracking-wide transition-all duration-200 min-h-[44px] cursor-pointer focus-visible:outline-2 focus-visible:outline-brand-ice border active:scale-95',
            idx === 0
              ? 'bg-brand-navy text-white border-brand-navy shadow-card'
              : 'bg-white text-brand-navy border-brand-border hover:bg-brand-surface hover:border-brand-ice/40 shadow-soft',
          ]}
          data-filter={cat}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>
  )}

  <!-- Responsive Work Grid -->
  <div class={`grid ${gridColsClass} gap-6 lg:gap-8 items-stretch gallery-grid`}>
    {
      items.map((item, index) => {
        const isVideo = item.media_type === 'video' || Boolean(item.video_url) || (Boolean(item.image_url) && /\.(mp4|webm|mov)$/i.test(item.image_url));
        const videoSrc = item.video_url || (isVideo ? item.image_url : '');
        return (
          <article
            class="card-spotlight gallery-item flex flex-col bg-white rounded-2xl sm:rounded-3xl overflow-hidden border border-brand-border/90 hover:border-brand-ice/60 transition-all duration-300 hover:shadow-card-elevated card-hover-effect group cursor-pointer reveal-init relative active:scale-[0.99] sm:active:scale-100"
            data-category={item.category}
            data-index={index}
            data-title={item.title}
            data-description={item.description || ''}
            data-image={item.image_url}
            data-video={videoSrc}
            data-mediatype={isVideo ? 'video' : 'image'}
            data-serviceurl={item.service_url || '/services/'}
          >
            <!-- Top hover accent line -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>

            <!-- Media Visual Container -->
            <div class="relative w-full aspect-[4/3] bg-brand-surface-alt overflow-hidden">
              {isVideo ? (
                <video
                  src={`${videoSrc}#t=0.001`}
                  muted
                  playsinline
                  preload="metadata"
                  class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out pointer-events-none"
                ></video>
              ) : (
                <img
                  src={item.thumbnail_url || item.image_url}
                  alt={item.alt_text || item.title}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
                />
              )}

              <!-- Dark Vignette on Hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy-dark/70 via-brand-navy/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

              <!-- Top Left: Category Badge in Glass Pill -->
              <span class="absolute top-3 left-3 px-3 py-1 rounded-xl text-xs font-bold uppercase tracking-wider glass-pill-dark text-white shadow-sm border border-white/20">
                {item.category}
              </span>

              <!-- Video Play Badge / Image Zoom Cue -->
              {isVideo ? (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-brand-navy/90 text-white border border-brand-ice/50 flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform duration-200">
                    <svg class="w-6 h-6 text-brand-ice ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              ) : (
                <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold glass-pill text-brand-navy shadow-sm border border-brand-border/90">
                    <svg class="w-3.5 h-3.5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                    </svg>
                    <span>Inspect</span>
                  </span>
                </div>
              )}
            </div>

            <!-- Content Details -->
            <div class="p-6 flex flex-col flex-grow justify-between">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-brand-navy mb-2 leading-snug group-hover:text-brand-blue transition-colors font-display">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed line-clamp-3">
                  {item.description}
                </p>
              </div>

              <!-- Action Link / Card Trigger -->
              <div class="mt-5 pt-3.5 border-t border-brand-border/60 flex items-center justify-between text-xs">
                <span class="inline-flex items-center gap-1.5 font-bold text-brand-blue group-hover:text-brand-ice transition-colors">
                  <span>View Details &bull; Full View</span>
                  <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
                <span class="text-brand-text-subtle font-medium flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  <span>Field Verified</span>
                </span>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <!-- LIGHTBOX / MEDIA VIEWER MODAL -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 bg-brand-navy-dark/95 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center p-3 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Work Media Viewer"
    aria-hidden="true"
  >
    <div class="relative w-full max-w-4xl max-h-[92vh] bg-white rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col transform scale-95 transition-all duration-300 ease-out border border-white/20" id="lightbox-container">
      <!-- Top Bar: Category & Close -->
      <div class="p-4 sm:p-5 bg-gradient-to-r from-brand-navy-dark via-brand-navy to-brand-navy-dark text-white flex items-center justify-between border-b border-white/10">
        <div class="flex items-center gap-2.5">
          <span id="lb-category" class="px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-brand-ice text-white shadow-xs"></span>
          <span id="lb-counter" class="text-xs text-slate-300 font-medium"></span>
        </div>
        <button
          type="button"
          id="lb-close-btn"
          class="p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/15 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-ice min-h-[44px] min-w-[44px] flex items-center justify-center cursor-pointer active:scale-95"
          aria-label="Close media viewer"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Center Media Container -->
      <div class="relative bg-slate-950 flex items-center justify-center min-h-[260px] sm:min-h-[420px] max-h-[58vh] overflow-hidden select-none">
        <!-- Image Viewer -->
        <img
          id="lb-image"
          src=""
          alt=""
          class="max-w-full max-h-[58vh] object-contain transition-opacity duration-300"
        />

        <!-- Video Viewer -->
        <video
          id="lb-video"
          src=""
          controls
          playsinline
          preload="metadata"
          class="hidden max-w-full max-h-[58vh] object-contain"
        ></video>

        <!-- Navigation Buttons -->
        <button
          type="button"
          id="lb-prev-btn"
          class="absolute left-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full bg-brand-navy/80 hover:bg-brand-navy text-white backdrop-blur-md transition-all focus-visible:outline-2 focus-visible:outline-brand-ice min-h-[44px] min-w-[44px] flex items-center justify-center shadow-lg cursor-pointer border border-white/15 active:scale-90"
          aria-label="Previous work project"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="lb-next-btn"
          class="absolute right-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full bg-brand-navy/80 hover:bg-brand-navy text-white backdrop-blur-md transition-all focus-visible:outline-2 focus-visible:outline-brand-ice min-h-[44px] min-w-[44px] flex items-center justify-center shadow-lg cursor-pointer border border-white/15 active:scale-90"
          aria-label="Next work project"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Bottom Details & Direct CTAs -->
      <div class="p-5 sm:p-6 bg-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-brand-border">
        <div class="max-w-lg">
          <h4 id="lb-title" class="text-lg sm:text-xl font-bold text-brand-navy leading-snug font-display"></h4>
          <p id="lb-desc" class="text-xs sm:text-sm text-brand-text-muted mt-1 leading-relaxed"></p>
        </div>
        <div class="flex items-center gap-2.5 w-full sm:w-auto flex-shrink-0">
          <a
            id="lb-service-link"
            href="/services/"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-brand-navy hover:bg-brand-navy-light text-white font-bold text-xs sm:text-sm transition-all duration-200 min-h-[44px] active:scale-[0.98] shadow-card"
          >
            <span>Service Details &rarr;</span>
          </a>
          <a
            href="https://wa.me/919575664203?text=Hello%20Patel%20Cool%20Tech%2C%20I%20saw%20your%20work%20portfolio%20and%20need%20AC%20service"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white font-bold text-xs sm:text-sm transition-all duration-200 min-h-[44px] active:scale-[0.98] shadow-card"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import type { WorkItemDB } from '../types/database';
  import { getStoredWorkItems } from '../utils/liveSync';

  function createGalleryItemHTML(item: WorkItemDB, index: number) {
    const isVideo = item.media_type === 'video' || Boolean(item.video_url) || (Boolean(item.image_url) && /\.(mp4|webm|mov)$/i.test(item.image_url));
    const videoSrc = item.video_url || (isVideo ? item.image_url : '');
    const mediaSrc = item.thumbnail_url || item.image_url;

    return `
      <article
        class="card-spotlight gallery-item flex flex-col bg-white rounded-2xl sm:rounded-3xl overflow-hidden border border-brand-border/90 hover:border-brand-ice/60 transition-all duration-300 hover:shadow-card-elevated card-hover-effect group cursor-pointer reveal-init relative active:scale-[0.99] sm:active:scale-100 reveal-visible"
        data-category="${item.category}"
        data-index="${index}"
        data-title="${item.title}"
        data-description="${item.description || ''}"
        data-image="${item.image_url}"
        data-video="${videoSrc}"
        data-mediatype="${isVideo ? 'video' : 'image'}"
        data-serviceurl="${item.service_url || '/services/'}"
      >
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
        <div class="relative w-full aspect-[4/3] bg-brand-surface-alt overflow-hidden">
          ${isVideo ? `
            <video
              src="${videoSrc}#t=0.001"
              muted
              playsinline
              preload="metadata"
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out pointer-events-none"
            ></video>
          ` : `
            <img
              src="${mediaSrc}"
              alt="${item.alt_text || item.title}"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
            />
          `}
          <div class="absolute inset-0 bg-gradient-to-t from-brand-navy-dark/70 via-brand-navy/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          <span class="absolute top-3 left-3 px-3 py-1 rounded-xl text-xs font-bold uppercase tracking-wider glass-pill-dark text-white shadow-sm border border-white/20">
            ${item.category}
          </span>
          ${isVideo ? `
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-brand-navy/90 text-white border border-brand-ice/50 flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform duration-200">
                <svg class="w-6 h-6 text-brand-ice ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          ` : `
            <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold glass-pill text-brand-navy shadow-sm border border-brand-border/90">
                <svg class="w-3.5 h-3.5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
                <span>Inspect</span>
              </span>
            </div>
          `}
        </div>
        <div class="p-6 flex flex-col flex-grow justify-between">
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-brand-navy mb-2 leading-snug group-hover:text-brand-blue transition-colors font-display">
              ${item.title}
            </h3>
            <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed line-clamp-3">
              ${item.description || ''}
            </p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-brand-border/60 flex items-center justify-between text-xs">
            <span class="inline-flex items-center gap-1.5 font-bold text-brand-blue group-hover:text-brand-ice transition-colors">
              <span>View Details &bull; Full View</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
            <span class="text-brand-text-subtle font-medium flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Field Verified</span>
            </span>
          </div>
        </div>
      </article>
    `;
  }

  function setupWorkGallery() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
    const lightbox = document.getElementById('gallery-lightbox');
    const container = document.getElementById('lightbox-container');
    const closeBtn = document.getElementById('lb-close-btn');
    const prevBtn = document.getElementById('lb-prev-btn');
    const nextBtn = document.getElementById('lb-next-btn');
    const lbImage = document.getElementById('lb-image') as HTMLImageElement | null;
    const lbVideo = document.getElementById('lb-video') as HTMLVideoElement | null;
    const lbTitle = document.getElementById('lb-title');
    const lbCategory = document.getElementById('lb-category');
    const lbCounter = document.getElementById('lb-counter');
    const lbDesc = document.getElementById('lb-desc');
    const lbServiceLink = document.getElementById('lb-service-link') as HTMLAnchorElement | null;
    const grid = document.querySelector<HTMLElement>('.gallery-grid');

    if (!lightbox || !grid) return;

    let activeFilter = 'All';

    function applyFilter(filter: string) {
      activeFilter = filter;
      filterButtons.forEach((b) => {
        const bFilter = b.getAttribute('data-filter') || 'All';
        if (bFilter === filter) {
          b.classList.add('bg-brand-navy', 'text-white', 'border-brand-navy');
          b.classList.remove('bg-white', 'border-brand-border');
          b.setAttribute('aria-selected', 'true');
        } else {
          b.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy');
          b.classList.add('bg-white', 'text-brand-navy', 'border-brand-border');
          b.setAttribute('aria-selected', 'false');
        }
      });

      const currentItems = grid.querySelectorAll<HTMLElement>('.gallery-item');
      currentItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (filter === 'All' || itemCat === filter) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }

    filterButtons.forEach((btn) => {
      btn.onclick = () => {
        const filter = btn.getAttribute('data-filter') || 'All';
        applyFilter(filter);
      };
    });

    function renderLiveGrid(items: WorkItemDB[]) {
      if (!grid || !items || items.length === 0) return;
      grid.innerHTML = items.map((item, idx) => createGalleryItemHTML(item, idx)).join('');
      applyFilter(activeFilter);
    }

    const cachedItems = getStoredWorkItems();
    if (cachedItems && cachedItems.length > 0) {
      renderLiveGrid(cachedItems);
    }

    // Lightbox state
    let activeIndex = 0;
    const getVisibleItems = () => Array.from(grid.querySelectorAll<HTMLElement>('.gallery-item')).filter((el) => el.style.display !== 'none');

    function updateLightbox(idx: number) {
      const activeList = getVisibleItems();
      if (activeList.length === 0) return;
      if (idx < 0) idx = activeList.length - 1;
      if (idx >= activeList.length) idx = 0;
      activeIndex = idx;

      const item = activeList[activeIndex];
      const title = item.getAttribute('data-title') || '';
      const desc = item.getAttribute('data-description') || '';
      const image = item.getAttribute('data-image') || '';
      const video = item.getAttribute('data-video') || '';
      const mediatype = item.getAttribute('data-mediatype') || 'image';
      const category = item.getAttribute('data-category') || '';
      const serviceUrl = item.getAttribute('data-serviceurl') || '/services/';

      if (lbTitle) lbTitle.textContent = title;
      if (lbDesc) lbDesc.textContent = desc;
      if (lbCategory) lbCategory.textContent = category;
      if (lbCounter) lbCounter.textContent = `${activeIndex + 1} / ${activeList.length}`;
      if (lbServiceLink) lbServiceLink.href = serviceUrl;

      if (mediatype === 'video' && video) {
        if (lbImage) lbImage.classList.add('hidden');
        if (lbVideo) {
          lbVideo.classList.remove('hidden');
          lbVideo.src = video;
          lbVideo.load();
        }
      } else {
        if (lbVideo) {
          lbVideo.pause();
          lbVideo.classList.add('hidden');
          lbVideo.removeAttribute('src');
        }
        if (lbImage) {
          lbImage.classList.remove('hidden');
          lbImage.src = image;
          lbImage.alt = title;
        }
      }
    }

    function openLightbox(idx: number) {
      updateLightbox(idx);
      lightbox?.classList.remove('opacity-0', 'pointer-events-none');
      lightbox?.classList.add('opacity-100', 'pointer-events-auto');
      lightbox?.setAttribute('aria-hidden', 'false');
      container?.classList.remove('scale-95');
      container?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (lbVideo) {
        lbVideo.pause();
        lbVideo.removeAttribute('src');
      }
      lightbox?.classList.add('opacity-0', 'pointer-events-none');
      lightbox?.classList.remove('opacity-100', 'pointer-events-auto');
      lightbox?.setAttribute('aria-hidden', 'true');
      container?.classList.add('scale-95');
      container?.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    // High performance O(1) event delegation on grid
    grid.onclick = (e) => {
      const target = e.target as HTMLElement | null;
      const item = target?.closest<HTMLElement>('.gallery-item');
      if (item) {
        const activeList = getVisibleItems();
        const indexInVisible = activeList.indexOf(item);
        openLightbox(indexInVisible >= 0 ? indexInVisible : 0);
      }
    };

    if (closeBtn) closeBtn.onclick = closeLightbox;
    if (prevBtn) prevBtn.onclick = () => updateLightbox(activeIndex - 1);
    if (nextBtn) nextBtn.onclick = () => updateLightbox(activeIndex + 1);

    lightbox.onclick = (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    };

    document.onkeydown = (e) => {
      if (lightbox.getAttribute('aria-hidden') === 'false') {
        if (e.key === 'Escape') {
          closeLightbox();
        } else if (e.key === 'ArrowLeft') {
          updateLightbox(activeIndex - 1);
        } else if (e.key === 'ArrowRight') {
          updateLightbox(activeIndex + 1);
        }
      }
    };

    window.addEventListener('pct:work-updated', (e: any) => {
      if (Array.isArray(e.detail)) {
        renderLiveGrid(e.detail);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWorkGallery);
  } else {
    setupWorkGallery();
  }
  document.addEventListener('astro:page-load', setupWorkGallery);
</script>
