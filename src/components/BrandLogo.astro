---
import { business } from '../data/business';

interface Props {
  variant?: 'light' | 'dark' | 'auto';
  size?: 'sm' | 'md' | 'lg';
  showTagline?: boolean;
  customLogoUrl?: string;
  class?: string;
}

const {
  variant = 'auto',
  size = 'md',
  showTagline = true,
  customLogoUrl,
  class: className = '',
} = Astro.props;

// Circle frame size classes
const frameSizeClasses = {
  sm: 'w-8 h-8 sm:w-9 sm:h-9',
  md: 'w-10 h-10 sm:w-11 sm:h-11',
  lg: 'w-12 h-12 sm:w-14 sm:h-14',
}[size];

const textSizeClasses = {
  sm: 'text-sm sm:text-base',
  md: 'text-base sm:text-lg lg:text-xl',
  lg: 'text-lg sm:text-xl lg:text-2xl',
}[size];

const isLight = variant === 'light';
---

<div class={`brand-logo-container flex items-center gap-2.5 sm:gap-3 group ${className}`} data-logo-variant={variant} data-logo-size={size}>
  <div class="brand-logo-visual flex-shrink-0 flex items-center justify-center">
    {customLogoUrl ? (
      <div
        class={`brand-logo-frame ${frameSizeClasses} rounded-full overflow-hidden flex items-center justify-center bg-white flex-shrink-0 transition-transform duration-300 group-hover:scale-105 ${
          isLight
            ? 'ring-2 ring-white/20 shadow-md shadow-brand-navy/30'
            : 'ring-1.5 ring-slate-200/90 shadow-xs'
        }`}
      >
        <img
          src={customLogoUrl}
          alt={`${business.name} official logo`}
          class="brand-logo-img w-full h-full object-cover rounded-full"
          loading="eager"
          decoding="async"
        />
      </div>
    ) : (
      <div
        class={`brand-logo-mark ${frameSizeClasses} rounded-full relative flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-105 shadow-sm ${
          isLight
            ? 'bg-white/10 text-brand-ice border border-white/20 backdrop-blur-md'
            : 'bg-gradient-to-br from-brand-navy to-brand-navy-dark text-brand-ice border border-brand-blue/30 shadow-brand-navy/10'
        }`}
        aria-hidden="true"
      >
        <!-- Stylized Cooling HVAC Icon with airflow & snowflake geometry -->
        <svg class="w-3/5 h-3/5 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <!-- Dual cooling blades / power bolt -->
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
          <!-- Subtle cooling dot -->
          <circle cx="19" cy="5" r="1.5" fill="#38BDF8" stroke="none" />
        </svg>
        <!-- Ambient corner glow -->
        <div class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-brand-ice animate-pulse opacity-70"></div>
      </div>
    )}
  </div>

  <div class="flex flex-col leading-none">
    <span
      class={`font-extrabold tracking-tight transition-colors duration-200 leading-tight ${textSizeClasses} ${
        isLight
          ? 'text-white group-hover:text-brand-ice-light'
          : 'text-brand-navy group-hover:text-brand-blue'
      }`}
    >
      {business.name.toUpperCase()}
    </span>
    {showTagline && (
      <span
        class={`text-[10px] sm:text-xs font-medium tracking-wide flex items-center gap-1.5 mt-0.5 leading-none ${
          isLight ? 'text-slate-300' : 'text-brand-text-muted'
        }`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 animate-pulse"></span>
        <span class="truncate">Indore &bull; MP</span>
      </span>
    )}
  </div>
</div>

<script>
  import { getStoredLogo } from '../utils/liveSync';

  function applyLogoToContainers(logoUrl: string | null) {
    const containers = document.querySelectorAll<HTMLElement>('.brand-logo-container');
    containers.forEach((container) => {
      const visual = container.querySelector<HTMLElement>('.brand-logo-visual');
      if (!visual) return;
      const size = container.dataset.logoSize || 'md';
      const isLight = container.dataset.logoVariant === 'light';

      const frameSizeClasses =
        size === 'sm'
          ? 'w-8 h-8 sm:w-9 sm:h-9'
          : size === 'lg'
          ? 'w-12 h-12 sm:w-14 sm:h-14'
          : 'w-10 h-10 sm:w-11 sm:h-11';

      if (logoUrl && logoUrl.trim().length > 0) {
        let frame = visual.querySelector<HTMLElement>('.brand-logo-frame');
        let img = visual.querySelector('img.brand-logo-img') as HTMLImageElement | null;
        if (!frame || !img) {
          visual.innerHTML = `
            <div class="brand-logo-frame ${frameSizeClasses} rounded-full overflow-hidden flex items-center justify-center bg-white flex-shrink-0 transition-transform duration-300 group-hover:scale-105 ${
              isLight ? 'ring-2 ring-white/20 shadow-md shadow-brand-navy/30' : 'ring-1.5 ring-slate-200/90 shadow-xs'
            }">
              <img
                src="${logoUrl}"
                alt="Patel Cool Tech official logo"
                class="brand-logo-img w-full h-full object-cover rounded-full"
                loading="eager"
                decoding="async"
              />
            </div>
          `;
        } else if (img.src !== logoUrl) {
          img.src = logoUrl;
        }
      } else {
        const existingFrame = visual.querySelector('.brand-logo-frame') || visual.querySelector('img.brand-logo-img');
        if (existingFrame) {
          visual.innerHTML = `
            <div
              class="brand-logo-mark ${frameSizeClasses} rounded-full relative flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-105 shadow-sm ${
                isLight
                  ? 'bg-white/10 text-brand-ice border border-white/20 backdrop-blur-md'
                  : 'bg-gradient-to-br from-brand-navy to-brand-navy-dark text-brand-ice border border-brand-blue/30 shadow-brand-navy/10'
              }"
              aria-hidden="true"
            >
              <svg class="w-3/5 h-3/5 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
                <circle cx="19" cy="5" r="1.5" fill="#38BDF8" stroke="none" />
              </svg>
              <div class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-brand-ice animate-pulse opacity-70"></div>
            </div>
          `;
        }
      }
    });
  }

  function syncBrandLogo(url?: string | null) {
    const targetUrl = typeof url === 'string' ? url : getStoredLogo();
    if (targetUrl) {
      applyLogoToContainers(targetUrl);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => syncBrandLogo());
  } else {
    syncBrandLogo();
  }
  document.addEventListener('astro:page-load', () => syncBrandLogo());
  window.addEventListener('pct:logo-updated', (e: any) => {
    applyLogoToContainers(e.detail?.logoUrl);
  });
  window.addEventListener('pct:settings-updated', (e: any) => {
    if (typeof e.detail?.logo_url === 'string') {
      applyLogoToContainers(e.detail.logo_url);
    }
  });
</script>
