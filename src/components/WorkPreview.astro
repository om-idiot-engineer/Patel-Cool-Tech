---
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import WorkGallery from './WorkGallery.astro';
import { defaultFallbackWork } from '../utils/supabase';

// Show first 4 items on the home page preview
const previewItems = defaultFallbackWork.slice(0, 4);
---

<section id="work" class="py-14 sm:py-20 lg:py-24 bg-white border-b border-brand-border scroll-mt-20">
  <Container>
    <div class="reveal-init">
      <SectionHeading
        badge="On-Site Portfolio"
        title="Recent Field Work &amp; Installations"
        subtitle="Real-world air conditioning installations, electrical troubleshooting, deep jet-spray coil cleaning, and gas charging across Indore, Rau, and Pithampur."
        align="center"
      />
    </div>

    <!-- Gallery with 4 columns without top category pills for clean preview -->
    <div class="mt-10">
      <WorkGallery items={previewItems} columns={4} showFilters={false} />
    </div>

    <!-- Section Bottom Callout -->
    <div class="mt-12 text-center flex flex-col sm:flex-row items-center justify-center gap-3.5 reveal-init">
      <Button
        href="/our-work/"
        variant="primary"
        size="md"
        class="font-bold px-6 py-3.5 min-h-[48px] shadow-card hover:shadow-hover"
        aria-label="View our complete air conditioning work portfolio"
      >
        <span>View Full Work Portfolio &rarr;</span>
      </Button>
      <Button
        href="/contact/"
        variant="outline"
        size="md"
        class="font-bold px-6 py-3.5 min-h-[48px]"
        aria-label="Request service from Patel Cool Tech"
      >
        <span>Contact Technicians Directly</span>
      </Button>
    </div>
  </Container>
</section>
