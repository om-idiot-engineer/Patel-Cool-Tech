---
import { business } from '../data/business';
import Container from './Container.astro';
import Button from './Button.astro';
import type { SiteSettingsDB } from '../types/database';

interface Props {
  settings?: Partial<SiteSettingsDB>;
}

const { settings } = Astro.props;

const heroImage = settings?.hero_media_url || '/images/hero/hero-technician.jpg';
const heroMediaType = settings?.hero_media_type || 'image';
const heroHeading = settings?.hero_heading || 'Professional AC Installation, Repair & Service in Indore';
const heroDescription = settings?.hero_description ||
  `Prompt, dependable air conditioning installation, fault diagnosis, high-pressure jet servicing, gas refilling, and AMC support across Indore and surrounding regions. Direct on-site work by technicians ${business.technicians.map((t) => t.name).join(' & ')}.`;
---

<section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-10 sm:pb-20 lg:pt-16 lg:pb-24 border-b border-brand-border overflow-hidden">
  <!-- Subtle technical cooling background ambient glow -->
  <div class="absolute -top-32 right-1/4 w-96 h-96 bg-brand-ice/10 rounded-full blur-3xl pointer-events-none -z-0" aria-hidden="true"></div>
  <div class="absolute top-1/2 -left-32 w-80 h-80 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none -z-0" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center">
      <!-- Left Column: Service declaration, direct trust, conversion -->
      <div class="lg:col-span-7 flex flex-col items-start text-left reveal-init">
        <!-- Live Trust Status Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-brand-navy border border-brand-border shadow-sm mb-4 sm:mb-5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="tracking-wide uppercase text-[11px] sm:text-xs font-bold text-brand-navy">DIRECT ON-SITE HVAC SPECIALISTS &bull; INDORE</span>
        </div>

        <!-- H1: Bold, high-clarity headline -->
        <h1 class="text-3xl xs:text-4xl sm:text-5xl lg:text-[3.25rem] xl:text-[3.65rem] font-extrabold tracking-tight text-brand-navy leading-[1.12] sm:leading-[1.1]">
          {heroHeading}
        </h1>

        <!-- Supporting copy -->
        <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed max-w-2xl font-normal">
          {heroDescription}
        </p>

        <!-- Primary & Secondary Conversion Actions -->
        <div class="mt-6 sm:mt-8 flex flex-col xs:flex-row items-stretch xs:items-center gap-3.5 w-full sm:w-auto">
          <!-- Primary CTA: Call Now -->
          <Button
            href={business.phones.primaryTel}
            variant="primary"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold shadow-card hover:shadow-hover text-sm sm:text-base px-6 py-4 min-h-[48px] transition-transform duration-200 hover:-translate-y-0.5"
            aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
          >
            <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call: {business.phones.primaryFormatted}</span>
          </Button>

          <!-- Secondary CTA: WhatsApp Us -->
          <Button
            href={business.phones.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold shadow-card hover:shadow-hover text-sm sm:text-base px-6 py-4 min-h-[48px] transition-transform duration-200 hover:-translate-y-0.5"
            aria-label="Chat with Patel Cool Tech on WhatsApp"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
            </svg>
            <span>WhatsApp Us</span>
          </Button>
        </div>

        <!-- Factual Trust Pillars -->
        <div class="mt-6 sm:mt-8 pt-6 border-t border-brand-border/80 w-full grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs text-brand-text-muted">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-brand-surface-alt border border-brand-border flex items-center justify-center text-brand-ice flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Indore &amp; Nearby</p>
              <p class="text-[11px] text-brand-text-subtle">Rau &bull; Pithampur coverage</p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-brand-surface-alt border border-brand-border flex items-center justify-center text-brand-ice flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Genuine Quality</p>
              <p class="text-[11px] text-brand-text-subtle">Certified refrigerants &amp; parts</p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-brand-surface-alt border border-brand-border flex items-center justify-center text-brand-ice flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Direct Technicians</p>
              <p class="text-[11px] text-brand-text-subtle">No call center middleman</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Showcase with Interactive Floating Badges -->
      <div class="lg:col-span-5 w-full mt-4 lg:mt-0 flex justify-center reveal-init stagger-2">
        <div class="relative w-full max-w-lg lg:max-w-none">
          <!-- Main Visual Card -->
          <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border border-brand-border bg-white shadow-hover group">
            {heroMediaType === 'video' ? (
              <video
                src={heroImage}
                poster={settings?.hero_poster_url || '/images/hero/hero-technician.jpg'}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                class="w-full h-auto aspect-[4/3] object-cover"
              ></video>
            ) : (
              <img
                src={heroImage}
                alt="Patel Cool Tech professional AC technician performing on-site service in Indore"
                width="800"
                height="600"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-105"
              />
            )}

            <!-- Gradient bottom vignette -->
            <div class="absolute inset-0 bg-gradient-to-t from-brand-navy-dark/70 via-transparent to-transparent pointer-events-none"></div>

            <!-- In-image bottom information overlay -->
            <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5 flex items-center justify-between text-white backdrop-blur-[2px]">
              <div>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-ice-light">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Verified On-Site Service
                </span>
                <p class="text-xs sm:text-sm font-semibold text-slate-100 mt-0.5">Split &bull; Window &bull; Inverter Units</p>
              </div>
              <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-white/20 text-white backdrop-blur-md border border-white/20">
                Indore, MP
              </span>
            </div>
          </div>

          <!-- Floating Badge 1: Direct Technician Access (Top Left) -->
          <div class="hidden sm:flex absolute -top-4 -left-4 bg-white/95 backdrop-blur-md border border-brand-border rounded-xl p-3 shadow-card items-center gap-2.5 animate-float z-20">
            <div class="w-8 h-8 rounded-lg bg-brand-blue-light text-brand-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-brand-navy">Fast Direct Response</p>
              <p class="text-[10px] text-brand-text-muted">On-site technical assistance</p>
            </div>
          </div>

          <!-- Floating Badge 2: Multi-Brand Support (Bottom Right) -->
          <div class="hidden sm:flex absolute -bottom-5 -right-4 bg-brand-navy/95 text-white backdrop-blur-md border border-brand-blue/30 rounded-xl p-3 shadow-darkCard items-center gap-2.5 animate-floatDelayed z-20">
            <div class="w-8 h-8 rounded-lg bg-white/10 text-brand-ice flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-white">Major Brands Covered</p>
              <p class="text-[10px] text-slate-300">Daikin, Voltas, Blue Star &amp; more</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
