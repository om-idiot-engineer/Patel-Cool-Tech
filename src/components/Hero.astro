---
import { business } from '../data/business';
import Container from './Container.astro';
import Button from './Button.astro';
---

<section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-10 sm:pb-16 lg:pt-14 lg:pb-20 border-b border-brand-border overflow-hidden">
  <!-- Subtle background ambient pattern for technical depth -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0B1F3A" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid-pattern)" />
    </svg>
  </div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      <!-- Left Column: Primary Content & Actions -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Eyebrow Badge: Brand Context & Location -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-surface-alt text-brand-navy border border-brand-border mb-4 sm:mb-5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span class="tracking-wide uppercase text-[11px] sm:text-xs">PATEL COOL TECH &bull; INDORE</span>
        </div>

        <!-- H1: The core service declaration -->
        <h1 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl xl:text-[3.25rem] font-extrabold tracking-tight text-brand-navy leading-[1.18] sm:leading-[1.15]">
          AC Installation, Repair &amp; Service in Indore
        </h1>

        <!-- Supporting copy: Real-world, concise service scope -->
        <p class="mt-3.5 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed max-w-2xl">
          Professional AC installation, repair, servicing, gas refilling and AMC support for homes and businesses across Indore and nearby areas. Direct communication and on-site assistance by technicians <strong class="text-brand-text font-semibold">{business.technicians.map((t) => t.name).join(' & ')}</strong>.
        </p>

        <!-- Primary & Secondary Conversion Actions -->
        <div class="mt-6 sm:mt-8 flex flex-col xs:flex-row items-stretch xs:items-center gap-3 w-full sm:w-auto">
          <!-- Primary CTA: Call Now -->
          <Button
            href={business.phones.primaryTel}
            variant="primary"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold shadow-card hover:shadow-hover text-sm sm:text-base px-6 py-3.5 min-h-[48px]"
            aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
          >
            <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call Now: {business.phones.primaryFormatted}</span>
          </Button>

          <!-- Secondary CTA: WhatsApp Us -->
          <Button
            href={business.phones.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold shadow-card hover:shadow-hover text-sm sm:text-base px-6 py-3.5 min-h-[48px]"
            aria-label="Chat with Patel Cool Tech on WhatsApp"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244zm4.52-6.177c-.248-.124-1.467-.723-1.695-.806-.228-.083-.394-.124-.56.124-.166.248-.644.806-.789.972-.145.166-.29.186-.538.062-.248-.124-1.047-.386-1.995-1.23-.738-.658-1.237-1.47-1.382-1.718-.145-.248-.016-.382.108-.505.112-.111.248-.29.373-.435.124-.145.166-.248.249-.414.083-.166.041-.311-.021-.435-.062-.124-.56-1.349-.767-1.848-.201-.486-.406-.42-.56-.428l-.477-.008c-.166 0-.435.062-.663.311-.228.249-.871.851-.871 2.075 0 1.224.892 2.407 1.016 2.573.124.166 1.755 2.68 4.252 3.757.594.256 1.058.409 1.42.524.597.19 1.14.163 1.57.099.479-.071 1.467-.6 1.674-1.18.207-.58.207-1.077.145-1.18-.062-.104-.228-.166-.477-.29z"/>
            </svg>
            <span>WhatsApp Us</span>
          </Button>
        </div>

        <!-- Service-Area & Local Trust Microcopy -->
        <div class="mt-5 sm:mt-6 pt-5 border-t border-brand-border/80 w-full flex flex-col xs:flex-row xs:items-center gap-2 xs:gap-4 text-xs text-brand-text-muted">
          <span class="flex items-center gap-1.5 font-medium text-brand-navy">
            <svg class="w-4 h-4 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Serving Indore &bull; Rau &bull; Pithampur &amp; nearby areas</span>
          </span>
          <span class="hidden xs:inline text-slate-300">&bull;</span>
          <span class="text-brand-text-subtle">
            Split &amp; Window AC &bull; Direct Technician Response
          </span>
        </div>
      </div>

      <!-- Right Column: Professional HVAC Visual Treatment -->
      <div class="lg:col-span-5 w-full mt-4 lg:mt-0 flex justify-center">
        <div class="relative w-full max-w-lg lg:max-w-none rounded-2xl overflow-hidden border border-brand-border bg-white shadow-card">
          <!-- Architecture allows swapping placeholder with real on-site photograph seamlessly -->
          <picture>
            <source srcset="/images/hero/hero-ac-unit.svg" type="image/svg+xml" />
            <img
              src="/images/hero/hero-ac-unit.svg"
              alt="Split and window air conditioner installation, repair, and servicing in Indore"
              width="800"
              height="600"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto aspect-[4/3] object-cover"
            />
          </picture>

          <!-- Technical Trust Signal Overlay on Desktop / Tablets -->
          <div class="p-3 sm:p-4 bg-brand-surface border-t border-brand-border flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
              <span class="font-semibold text-brand-navy">Direct On-Site Service</span>
            </div>
            <span class="text-brand-text-muted font-medium">Split &amp; Window Units</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
