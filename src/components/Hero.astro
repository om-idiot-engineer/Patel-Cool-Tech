---
import { business } from '../data/business';
import Container from './Container.astro';
import SmartAcHeroUnit from './SmartAcHeroUnit.astro';
import type { SiteSettingsDB } from '../types/database';

interface Props {
  settings?: Partial<SiteSettingsDB>;
}

const { settings } = Astro.props;

const heroImage = settings?.hero_media_url || '/images/hero/hero-technician.webp';
const heroMediaType = settings?.hero_media_type || 'image';
const heroHeading = settings?.hero_heading || 'Fast Doorstep AC Repair & Installations';
const heroDescription = settings?.hero_description ||
  'Doorstep technician visit across Indore & Rau. 100% genuine spares, upfront pricing & direct support.';

const runningServices = [
  { icon: '❄️', title: 'AC Installation' },
  { icon: '⚡', title: 'AC Repair & Diagnostics' },
  { icon: '💨', title: 'Gas Refilling (R32 / R410A)' },
  { icon: '🌊', title: 'Deep Jet Pump Servicing' },
  { icon: '🔧', title: 'Split & Window AC Service' },
  { icon: '🛠️', title: 'AC Uninstallation & Shifting' },
  { icon: '🛡️', title: 'Commercial & Home AMC' },
  { icon: '📍', title: 'Doorstep Visits across Indore & Rau' },
];
---

<section class="relative bg-gradient-to-b from-brand-surface via-white to-white pb-10 sm:pb-16 lg:pb-20 border-b border-brand-border/80 overflow-hidden bg-tech-dots">
  <!-- Top Running Micro-Ticker: Services in Motion (Ultra-low height, high-impact) -->
  <div class="relative w-full bg-slate-900 border-b border-slate-800 text-slate-200 overflow-hidden py-1.5 sm:py-2 select-none z-20">
    <div class="marquee-mask relative overflow-hidden">
      <div class="marquee-track animate-marquee-left flex items-center gap-6 whitespace-nowrap text-[11px] sm:text-xs font-semibold tracking-wide">
        {
          [...runningServices, ...runningServices, ...runningServices].map((srv) => (
            <div class="flex items-center gap-1.5 text-slate-200 shrink-0">
              <span class="text-xs">{srv.icon}</span>
              <span class="text-white font-medium">{srv.title}</span>
              <span class="text-sky-400 font-bold ml-4">•</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Atmospheric cooling ambient glows (low GPU, organic drift) -->
  <div class="absolute -top-32 right-1/4 w-[34rem] h-[34rem] bg-brand-ice/15 rounded-full blur-3xl pointer-events-none -z-0 animate-aurora" aria-hidden="true"></div>
  <div class="absolute top-1/3 -left-28 w-[28rem] h-[28rem] bg-brand-blue/12 rounded-full blur-3xl pointer-events-none -z-0 animate-pulseGlow" aria-hidden="true"></div>
  <div class="absolute -bottom-24 right-10 w-96 h-96 bg-sky-200/25 rounded-full blur-2xl pointer-events-none -z-0" aria-hidden="true"></div>

  <!-- Subtle HVAC Airflow Waves Vector Motif (Pure SVG with animated dash) -->
  <div class="absolute inset-0 pointer-events-none opacity-45 overflow-hidden" aria-hidden="true">
    <svg class="absolute top-12 left-0 w-full h-52 stroke-brand-ice/25 fill-none" viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path d="M-100,50 C200,120 500,-20 800,60 C1100,140 1300,30 1600,80" stroke-width="1.5" class="animate-airflow" />
      <path d="M-50,90 C250,160 550,20 850,100 C1150,180 1350,70 1650,120" stroke-width="1" stroke-dasharray="14 14" opacity="0.6" />
    </svg>
  </div>

  <Container class="relative z-10 pt-6 sm:pt-8 lg:pt-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 xl:gap-16 items-center">
      <!-- 1. Top on Mobile / Right Column on Desktop: Interactive Smart AC Showcase with Airflow Visualization -->
      <div class="order-1 lg:order-2 lg:col-span-5 w-full flex flex-col items-center justify-center pt-1 sm:pt-0 pb-3 sm:pb-0 reveal-scale stagger-1">
        <div class="relative w-full max-w-md lg:max-w-lg xl:max-w-xl">
          <!-- Floating Badge 1: Top-Left (Desktop Only) -->
          <div class="hidden lg:flex absolute -top-4 -left-6 bg-white/95 backdrop-blur-md border border-brand-border rounded-xl p-2.5 shadow-card items-center gap-2 animate-float z-20">
            <div class="w-7 h-7 rounded-lg bg-brand-blue-light text-brand-blue flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] font-bold text-brand-navy">Fast Direct Response</p>
              <p class="text-[9.5px] text-brand-text-muted">Doorstep within 60-90 Mins</p>
            </div>
          </div>

          <SmartAcHeroUnit
            logoUrl={settings?.logo_url}
            businessName={settings?.business_name || business.name}
          />

          <!-- Floating Badge 2: Bottom-Right (Desktop Only) -->
          <div class="hidden lg:flex absolute -bottom-3 -right-4 bg-brand-navy/95 text-white backdrop-blur-md border border-brand-blue/30 rounded-xl p-2.5 shadow-darkCard items-center gap-2 animate-floatDelayed z-20">
            <div class="w-7 h-7 rounded-lg bg-white/10 text-brand-ice flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] font-bold text-white">All Major Brands</p>
              <p class="text-[9.5px] text-slate-300">Daikin, Voltas, Blue Star &amp; more</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Text & CTAs: Below AC on Mobile / Left Column on Desktop -->
      <div class="order-2 lg:order-1 lg:col-span-7 flex flex-col items-start text-left">
        <!-- H1: Bold, high-clarity headline (Optimized Mobile Typography) -->
        <h1 id="hero-heading-text" class="text-2xl xs:text-3xl sm:text-4xl lg:text-[3.25rem] xl:text-[3.6rem] font-black tracking-tight text-brand-navy leading-[1.15] sm:leading-[1.1] reveal-init stagger-2 font-display">
          {heroHeading}
        </h1>

        <!-- Supporting copy: Compact, realistic, trust-building (No rigid same-day promise) -->
        <p id="hero-desc-text" class="mt-3 sm:mt-4 text-sm sm:text-base lg:text-lg text-brand-text-muted leading-relaxed max-w-xl font-normal reveal-init stagger-3">
          {heroDescription}
        </p>

        <!-- Direct Technician Contacts: 2x2 Clean Action Grid (Mobile Aligned with generous breathing room) -->
        <div class="mt-6 sm:mt-8 w-full sm:max-w-xl space-y-2.5 reveal-init stagger-4">
          <!-- Row 1: Direct Calling -->
          <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
            <!-- Call Mahendra -->
            <a
              href={business.phones.primaryTel}
              class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-brand-navy hover:bg-brand-navy-light text-white font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-white/10 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
              aria-label={`Call Mahendra Patel at ${business.phones.primaryFormatted}`}
            >
              <div class="w-5 h-5 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5 text-brand-ice flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <span class="whitespace-nowrap font-bold tracking-tight">Call Mahendra</span>
            </a>

            <!-- Call Satyam -->
            <a
              href={business.phones.secondaryTel}
              class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-brand-navy hover:bg-brand-navy-light text-white font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-white/10 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
              aria-label={`Call Satyam Patel at ${business.phones.secondaryFormatted}`}
            >
              <div class="w-5 h-5 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5 text-brand-ice flex-shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <span class="whitespace-nowrap font-bold tracking-tight">Call Satyam</span>
            </a>
          </div>

          <!-- Row 2: Direct WhatsApp Messaging -->
          <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
            <!-- WhatsApp Mahendra -->
            <a
              href="https://wa.me/919575664203?text=Hello%20Mahendra%20ji%2C%20I%20need%20AC%20service%20in%20Indore"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-emerald-400/20 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
              aria-label="Chat with Mahendra Patel on WhatsApp"
            >
              <div class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
                </svg>
              </div>
              <span class="whitespace-nowrap font-bold tracking-tight">WhatsApp Mahendra</span>
            </a>

            <!-- WhatsApp Satyam -->
            <a
              href="https://wa.me/919425166191?text=Hello%20Satyam%20ji%2C%20I%20need%20AC%20service%20in%20Indore"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-3 sm:py-3.5 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white font-bold text-xs sm:text-sm shadow-card hover:shadow-hover border border-emerald-400/20 active:scale-[0.98] transition-all whitespace-nowrap select-none group min-h-[46px]"
              aria-label="Chat with Satyam Patel on WhatsApp"
            >
              <div class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
                </svg>
              </div>
              <span class="whitespace-nowrap font-bold tracking-tight">WhatsApp Satyam</span>
            </a>
          </div>
        </div>

        <!-- Compact Trust Badges on Mobile (Organized & separated from CTAs) -->
        <div class="grid grid-cols-3 gap-2.5 mt-7 sm:mt-8 pt-5 border-t border-brand-border/60 w-full lg:hidden text-center reveal-init stagger-5">
          <div class="py-2.5 px-2 rounded-xl bg-white/90 border border-brand-border/80 shadow-2xs flex flex-col items-center justify-center">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-blue mb-1"></span>
            <p class="text-[11px] font-bold text-brand-navy leading-tight">Indore &amp; Rau</p>
            <p class="text-[9.5px] text-slate-500 mt-0.5">Doorstep Hub</p>
          </div>
          <div class="py-2.5 px-2 rounded-xl bg-white/90 border border-brand-border/80 shadow-2xs flex flex-col items-center justify-center">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 mb-1"></span>
            <p class="text-[11px] font-bold text-brand-navy leading-tight">100% Genuine</p>
            <p class="text-[9.5px] text-slate-500 mt-0.5">Leak Tested</p>
          </div>
          <div class="py-2.5 px-2 rounded-xl bg-white/90 border border-brand-border/80 shadow-2xs flex flex-col items-center justify-center">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 mb-1"></span>
            <p class="text-[11px] font-bold text-brand-navy leading-tight">Direct Techs</p>
            <p class="text-[9.5px] text-slate-500 mt-0.5">No Middlemen</p>
          </div>
        </div>

        <!-- Factual Trust Pillars on Desktop -->
        <div class="hidden lg:grid mt-8 pt-6 border-t border-brand-border/80 w-full grid-cols-3 gap-3.5 text-xs text-brand-text-muted reveal-init stagger-5">
          <div class="flex items-center gap-2.5 p-2.5 rounded-2xl bg-white/75 backdrop-blur-sm border border-brand-border/70 hover:border-brand-ice/40 hover:shadow-soft transition-all duration-200">
            <div class="w-8 h-8 rounded-xl bg-brand-blue-light border border-brand-border/80 flex items-center justify-center text-brand-ice flex-shrink-0 shadow-xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Indore &amp; Nearby</p>
              <p class="text-[11px] text-brand-text-subtle">Rau &bull; Pithampur</p>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-2.5 rounded-2xl bg-white/75 backdrop-blur-sm border border-brand-border/70 hover:border-brand-ice/40 hover:shadow-soft transition-all duration-200">
            <div class="w-8 h-8 rounded-xl bg-brand-blue-light border border-brand-border/80 flex items-center justify-center text-brand-ice flex-shrink-0 shadow-xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Genuine Quality</p>
              <p class="text-[11px] text-brand-text-subtle">Leak-tested spares</p>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-2.5 rounded-2xl bg-white/75 backdrop-blur-sm border border-brand-border/70 hover:border-brand-ice/40 hover:shadow-soft transition-all duration-200">
            <div class="w-8 h-8 rounded-xl bg-brand-blue-light border border-brand-border/80 flex items-center justify-center text-brand-ice flex-shrink-0 shadow-xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-brand-navy">Direct Techs</p>
              <p class="text-[11px] text-brand-text-subtle">Zero call center wait</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
