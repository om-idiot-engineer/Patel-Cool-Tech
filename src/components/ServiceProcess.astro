---
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import type { ServiceProcessStep } from '../data/servicePages';

interface Props {
  heading?: string;
  intro?: string;
  disclaimer?: string;
  steps: ServiceProcessStep[];
}

const {
  heading = 'How the Service Works',
  intro = 'A structured, careful approach to ensure your cooling system operates safely and effectively.',
  disclaimer = 'Typical process may include the following steps (sequence may adapt to site layout and unit condition):',
  steps,
} = Astro.props;
---

<section class="py-12 sm:py-16 bg-brand-surface border-b border-brand-border">
  <Container>
    <SectionHeading
      badge="Workflow"
      title={heading}
      subtitle={intro}
      align="center"
    />

    <!-- Process Disclaimer Notice -->
    <div class="max-w-3xl mx-auto -mt-4 mb-8 text-center text-xs sm:text-sm text-brand-text-subtle italic">
      {disclaimer}
    </div>

    <!-- Steps Grid / Timeline -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        steps.map((step, idx) => (
          <div class={`card-spotlight relative bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-7 border border-brand-border/90 hover:border-brand-ice/50 shadow-card hover:shadow-card-elevated card-hover-effect transition-all duration-300 flex flex-col justify-between group reveal-init stagger-${(idx % 3) + 1} overflow-hidden active:scale-[0.99] sm:active:scale-100`}>
            <!-- Top hover accent line -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>

            <div>
              <!-- Step Number Badge -->
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-brand-blue-light to-sky-100/60 text-brand-blue font-extrabold text-sm group-hover:bg-brand-navy group-hover:text-brand-ice transition-all duration-300 shadow-sm border border-brand-blue/15">
                  {step.stepNumber < 10 ? `0${step.stepNumber}` : step.stepNumber}
                </span>
                <span class="text-[11px] font-bold uppercase tracking-wider text-brand-text-subtle">
                  Step {step.stepNumber}
                </span>
              </div>

              <!-- Step Title -->
              <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2.5 font-display group-hover:text-brand-blue transition-colors">
                {step.title}
              </h3>

              <!-- Step Description -->
              <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed">
                {step.description}
              </p>
            </div>

            <!-- Bottom Progress Line Indicator -->
            <div class="mt-5 pt-3.5 border-t border-brand-border/60 flex items-center justify-between text-[11px] text-brand-text-subtle">
              <span class="font-medium">On-Site Procedure</span>
              <span class="w-2 h-2 rounded-full bg-brand-ice animate-pulse"></span>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
