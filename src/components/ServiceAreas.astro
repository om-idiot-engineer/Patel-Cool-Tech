---
import { business } from '../data/business';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';

const { featuredAreas, extendedCoverageNote } = business.serviceAreas;

const areaHighlights = [
  {
    name: 'Indore',
    badge: 'City Center & Suburbs',
    description: 'On-site AC installation in Indore, deep coil jet servicing, compressor troubleshooting, and gas refilling across residential apartments and retail spaces.',
    highlights: ['Residential colonies & apartments', 'Commercial shops & offices', 'Split & window unit support'],
  },
  {
    name: 'Rau',
    badge: 'Residential Corridor',
    description: 'Prompt AC repair in Rau, emergency cooling fault diagnostics, drainage leakage resolution, and seasonal tune-ups along the AB Road corridor.',
    highlights: ['Fast doorstep technician dispatch', 'Water leakage & noise resolution', 'Gas leak detection & refill'],
  },
  {
    name: 'Pithampur',
    badge: 'Industrial & Commercial Hub',
    description: 'Reliable air conditioning maintenance, split AC servicing, and customized annual maintenance contracts (AMC) for commercial and industrial facilities.',
    highlights: ['Multi-unit commercial facilities', 'Office space cooling maintenance', 'Scheduled preventive AMC contracts'],
  },
];
---

<section class="py-12 sm:py-16 lg:py-20 bg-white border-b border-brand-border">
  <Container>
    <SectionHeading
      badge="Service Coverage"
      title="Serving Indore & Nearby Areas"
      subtitle="Patel Cool Tech delivers on-site air conditioning service, repair, and installation directly at your premises with straightforward local coordination."
      align="center"
    />

    <!-- Core Coverage Area Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {
        areaHighlights.map((area) => (
          <article class="flex flex-col justify-between bg-brand-surface rounded-2xl p-6 sm:p-7 border border-brand-border/80 hover:border-brand-blue/40 hover:shadow-card transition-all duration-200 group">
            <div>
              <!-- Header with Location Pin -->
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-brand-border text-brand-blue">
                  <svg class="w-3.5 h-3.5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{area.badge}</span>
                </span>
                <span class="text-xs font-medium text-slate-400">Madhya Pradesh</span>
              </div>

              <!-- Location Name & Description -->
              <h3 class="text-xl sm:text-2xl font-bold text-brand-navy mb-2.5">
                {area.name}
              </h3>
              <p class="text-sm text-brand-text-muted leading-relaxed mb-5">
                {area.description}
              </p>

              <!-- Local Bullet Points -->
              <ul class="space-y-2 mb-6 border-t border-brand-border/60 pt-4" role="list">
                {area.highlights.map((item) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-brand-text">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Direct Action -->
            <div class="pt-3 border-t border-brand-border/60">
              <Button
                href={business.phones.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                variant="outline"
                size="sm"
                class="w-full justify-center text-xs sm:text-sm font-semibold min-h-[44px]"
                aria-label={`Inquire about AC service in ${area.name}`}
              >
                Request Service in {area.name}
              </Button>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Extended Coverage Notice Box -->
    <div class="mt-8 sm:mt-10 p-5 sm:p-6 rounded-2xl bg-brand-surface-alt border border-brand-border flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-brand-blue-light text-brand-blue flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm sm:text-base font-bold text-brand-navy">Extended &amp; Surrounding Region Coverage</h4>
          <p class="text-xs sm:text-sm text-brand-text-muted mt-0.5 leading-relaxed">
            {extendedCoverageNote}
          </p>
        </div>
      </div>

      <div class="flex-shrink-0 w-full md:w-auto">
        <Button
          href={business.phones.primaryTel}
          variant="primary"
          size="sm"
          class="w-full md:w-auto font-semibold min-h-[44px]"
          aria-label="Call to confirm coverage in your area"
        >
          Call to Confirm Location
        </Button>
      </div>
    </div>
  </Container>
</section>
