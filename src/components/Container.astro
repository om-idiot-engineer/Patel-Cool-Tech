---
interface Props {
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'nav' | 'main';
  class?: string;
  size?: 'default' | 'narrow' | 'wide';
}

const { as: Tag = 'div', class: className = '', size = 'default' } = Astro.props;

const sizeClasses = {
  narrow: 'max-w-4xl',
  default: 'max-w-7xl',
  wide: 'max-w-[1440px]',
};
---

<Tag class:list={['w-full mx-auto px-4 sm:px-6 lg:px-8', sizeClasses[size], className]}>
  <slot />
</Tag>
