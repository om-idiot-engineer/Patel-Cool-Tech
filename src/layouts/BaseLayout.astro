---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { siteConfig } from '../data/site';
import { buildPageTitle, generateLocalBusinessSchema } from '../utils/seo';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  additionalSchema?: Record<string, any> | Record<string, any>[];
  hideHeaderFooter?: boolean;
}

const {
  title,
  description = siteConfig.defaultDescription,
  canonicalUrl: propCanonicalUrl,
  ogImage = '/images/hero/hero-technician.jpg',
  noindex = false,
  additionalSchema,
  hideHeaderFooter = false,
} = Astro.props;

const canonicalUrl = (() => {
  if (propCanonicalUrl) {
    const u = new URL(propCanonicalUrl, siteConfig.siteUrl);
    if (!u.pathname.endsWith('/')) {
      u.pathname = `${u.pathname}/`;
    }
    return u.href;
  }
  const u = new URL(Astro.url.pathname, Astro.site || siteConfig.siteUrl);
  if (!u.pathname.endsWith('/')) {
    u.pathname = `${u.pathname}/`;
  }
  return u.href;
})();

const pageTitle = buildPageTitle(title);
const schemaData = generateLocalBusinessSchema();
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Preconnect and non-blocking font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap"
      />
    </noscript>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site || siteConfig.siteUrl).href} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {!noindex && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site || siteConfig.siteUrl).href} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b1f3a" />

    <!-- LocalBusiness JSON-LD Schema (omitted on error / noindex pages) -->
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />}
    {additionalSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(additionalSchema)} />
    )}

    <!-- Astro View Transitions with reduced motion awareness -->
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-full bg-white text-brand-text antialiased selection:bg-brand-ice selection:text-white">
    <!-- Accessible Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2.5 bg-brand-navy text-white font-semibold rounded-lg shadow-xl outline-none ring-2 ring-brand-ice"
    >
      Skip to main content
    </a>

    {!hideHeaderFooter && (
      <>
        <!-- Global Header & Mobile Navigation Drawer -->
        <Header />
        <MobileMenu />
      </>
    )}

    <!-- Main Content Area -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    {!hideHeaderFooter && (
      <>
        <!-- Global Footer & Mobile Direct CTA -->
        <Footer />
        <StickyMobileCTA />
      </>
    )}

    <!-- Interactive Motion & Scroll Reveal Observer Script -->
    <script>
      let activeObserver: IntersectionObserver | null = null;
      let isSpotlightInitialized = false;

      function initInteractiveMotion() {
        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.reveal-init, .reveal-scale, .reveal-fade');

        if (isReducedMotion) {
          revealElements.forEach((el) => {
            el.classList.add('reveal-visible');
          });
          return;
        }

        if (activeObserver) {
          activeObserver.disconnect();
        }

        activeObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                activeObserver?.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.05,
            rootMargin: '0px 0px -20px 0px',
          }
        );

        revealElements.forEach((el) => {
          activeObserver?.observe(el);
        });

        // Pointer Spotlight tracking for desktop fine pointer (delegated, throttled, zero layout thrashing)
        if (!isSpotlightInitialized && window.matchMedia('(pointer: fine)').matches) {
          isSpotlightInitialized = true;
          let rafId: number | null = null;

          document.addEventListener(
            'mousemove',
            (e: MouseEvent) => {
              const target = e.target as HTMLElement | null;
              const card = target?.closest<HTMLElement>('.card-spotlight, .card-spotlight-dark');
              if (!card) return;

              if (rafId) cancelAnimationFrame(rafId);
              rafId = requestAnimationFrame(() => {
                const rect = card.getBoundingClientRect();
                card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
                card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
              });
            },
            { passive: true }
          );
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initInteractiveMotion);
      } else {
        initInteractiveMotion();
      }
      document.addEventListener('astro:page-load', initInteractiveMotion);
    </script>
  </body>
</html>
