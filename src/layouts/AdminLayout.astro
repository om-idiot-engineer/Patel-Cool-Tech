---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import { isSupabaseConfigured, getSiteSettings } from '../utils/supabase';
import { getFaviconMimeType } from '../utils/favicon';

interface Props {
  title: string;
  activeTab?: 'dashboard' | 'work' | 'media' | 'settings';
}

const { title, activeTab = 'dashboard' } = Astro.props;
const settings = await getSiteSettings();
const siteLogoUrl = settings?.logo_url || '';
const initialFavicon = siteLogoUrl || '/favicon.svg';
const initialFaviconType = getFaviconMimeType(initialFavicon);
---

<!doctype html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | Patel Cool Tech Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <!-- Favicon & Mobile Web App Icons (Dynamic to Owner Logo) -->
    <link
      id="dynamic-favicon"
      rel="icon"
      {...(initialFaviconType ? { type: initialFaviconType } : {})}
      href={initialFavicon}
    />
    <link
      id="dynamic-apple-icon"
      rel="apple-touch-icon"
      href={initialFavicon}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Zero-latency inline script: applies owner-uploaded original logo to browser tab immediately -->
    <script is:inline>
      (function() {
        try {
          var logo = localStorage.getItem('pct_custom_logo');
          if (!logo) {
            var raw = localStorage.getItem('pct_site_settings');
            if (raw) {
              var s = JSON.parse(raw);
              if (s && s.logo_url) logo = s.logo_url;
            }
          }
          if (logo && logo.trim()) {
            var icon = document.getElementById('dynamic-favicon');
            var apple = document.getElementById('dynamic-apple-icon');
            var clean = logo.split('?')[0].toLowerCase();
            var mime = '';
            if (clean.indexOf('.svg') !== -1 || logo.indexOf('data:image/svg') === 0) mime = 'image/svg+xml';
            else if (clean.indexOf('.png') !== -1 || logo.indexOf('data:image/png') === 0) mime = 'image/png';
            else if (clean.indexOf('.jpg') !== -1 || clean.indexOf('.jpeg') !== -1 || logo.indexOf('data:image/jpeg') === 0) mime = 'image/jpeg';
            else if (clean.indexOf('.webp') !== -1 || logo.indexOf('data:image/webp') === 0) mime = 'image/webp';
            else if (clean.indexOf('.ico') !== -1 || logo.indexOf('data:image/x-icon') === 0) mime = 'image/x-icon';

            if (icon && icon.getAttribute('href') !== logo) {
              icon.href = logo;
              if (mime) icon.type = mime; else icon.removeAttribute('type');
            }
            if (apple && apple.getAttribute('href') !== logo) {
              apple.href = logo;
            }
          }
        } catch (_) {}
      })();
    </script>

    <!-- Immediate Pre-Render Owner Auth Check: Blocks any unauthenticated access instantly -->
    <style is:inline id="admin-auth-guard-style">
      html, body {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
      }
    </style>
    <script is:inline>
      (function() {
        try {
          var isAuth = sessionStorage.getItem('pct_admin_authenticated');
          if (isAuth !== 'true') {
            try {
              localStorage.clear();
              sessionStorage.clear();
            } catch (e) {}
            window.location.replace('/admin/login/?unauthorized=1');
            return;
          }
        } catch (err) {
          window.location.replace('/admin/login/?unauthorized=1');
        }
      })();
    </script>
    <noscript>
      <style>
        body { display: none !important; }
      </style>
    </noscript>
  </head>
  <body class="flex flex-col min-h-full bg-slate-950 text-slate-100 font-sans antialiased">
    <!-- Security Verification Barrier (Dismissed once cryptographic token is verified) -->
    <div id="auth-verifier-overlay" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-slate-950 text-white transition-opacity duration-200">
      <div class="flex flex-col items-center gap-3 p-6 text-center max-w-sm">
        <div class="relative w-12 h-12 flex items-center justify-center">
          <div class="absolute inset-0 rounded-full border-2 border-brand-ice/20 border-t-brand-ice animate-spin"></div>
          <svg class="w-5 h-5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <p class="text-sm font-bold text-white tracking-wide">Owner Security Check</p>
        <p class="text-xs text-slate-400">Verifying authorized Patel Cool Tech session...</p>
      </div>
    </div>
    <!-- Admin Top Navbar -->
    <header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14 sm:h-18">
          <!-- Logo & Admin Badge -->
          <div class="flex items-center gap-2 sm:gap-3">
            <a href="/admin/" class="flex items-center gap-2" aria-label="Patel Cool Tech Admin Home">
              <BrandLogo variant="light" size="sm" showTagline={false} customLogoUrl={settings?.logo_url} />
            </a>
            <span class="px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold uppercase tracking-wider bg-brand-ice/20 text-brand-ice border border-brand-ice/30">
              Admin
            </span>
          </div>

          <!-- Navigation Links (Desktop only - mobile uses bottom app dock) -->
          <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Admin navigation">
            <a
              href="/admin/"
              class:list={[
                'px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors',
                activeTab === 'dashboard'
                  ? 'bg-slate-800 text-white font-bold text-brand-ice-light'
                  : 'text-slate-400 hover:text-white hover:bg-slate-800/60',
              ]}
            >
              Dashboard
            </a>
            <a
              href="/admin/work/"
              class:list={[
                'px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors',
                activeTab === 'work'
                  ? 'bg-slate-800 text-white font-bold text-brand-ice-light'
                  : 'text-slate-400 hover:text-white hover:bg-slate-800/60',
              ]}
            >
              Work Portfolio
            </a>
            <a
              href="/admin/media/"
              class:list={[
                'px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors',
                activeTab === 'media'
                  ? 'bg-slate-800 text-white font-bold text-brand-ice-light'
                  : 'text-slate-400 hover:text-white hover:bg-slate-800/60',
              ]}
            >
              Media Library
            </a>
            <a
              href="/admin/settings/"
              class:list={[
                'px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors',
                activeTab === 'settings'
                  ? 'bg-slate-800 text-white font-bold text-brand-ice-light'
                  : 'text-slate-400 hover:text-white hover:bg-slate-800/60',
              ]}
            >
              Settings
            </a>
          </nav>

          <!-- Right: Owner Account Badge, View Public Site & Logout -->
          <div class="flex items-center gap-2 sm:gap-3">
            <!-- Verified Owner Account Indicator -->
            <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-950/40 border border-emerald-800/50 text-[11px] text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-emerald-400 font-semibold">Owner:</span>
              <span id="header-owner-email" class="font-bold text-white">patelcooltech@gmail.com</span>
            </div>

            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 transition-colors"
              title="View Live Public Website"
            >
              <span class="hidden xs:inline sm:inline">View Site</span>
              <svg class="w-3.5 h-3.5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <button
              type="button"
              id="admin-logout-btn"
              class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-300 hover:text-rose-100 bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/50 transition-colors cursor-pointer"
              title="Sign Out of Admin"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span class="hidden sm:inline">Logout</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Admin Content Area (Extra bottom padding on mobile for dock) -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-8 pb-28 md:pb-12">
      <slot />
    </main>

    <!-- Native App-Style Bottom Navigation Dock (Mobile Only) -->
    <nav
      class="fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur-xl border-t border-slate-800 shadow-[0_-4px_24px_rgba(0,0,0,0.6)] md:hidden pb-[max(0.6rem,env(safe-area-inset-bottom))] pt-1 px-2"
      aria-label="Mobile Admin Navigation"
    >
      <div class="grid grid-cols-4 items-center">
        <!-- Tab 1: Dashboard -->
        <a
          href="/admin/"
          class:list={[
            'flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all active:scale-95 min-h-[50px]',
            activeTab === 'dashboard'
              ? 'text-brand-ice font-bold'
              : 'text-slate-400 hover:text-slate-200',
          ]}
        >
          <div class:list={[
            'p-1 rounded-lg transition-colors',
            activeTab === 'dashboard' ? 'bg-brand-ice/15' : 'bg-transparent',
          ]}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
          </div>
          <span class="text-[10px] mt-0.5 tracking-tight font-medium">Dashboard</span>
        </a>

        <!-- Tab 2: Work Items -->
        <a
          href="/admin/work/"
          class:list={[
            'flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all active:scale-95 min-h-[50px]',
            activeTab === 'work'
              ? 'text-brand-ice font-bold'
              : 'text-slate-400 hover:text-slate-200',
          ]}
        >
          <div class:list={[
            'p-1 rounded-lg transition-colors',
            activeTab === 'work' ? 'bg-brand-ice/15' : 'bg-transparent',
          ]}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-[10px] mt-0.5 tracking-tight font-medium">Work</span>
        </a>

        <!-- Tab 3: Media -->
        <a
          href="/admin/media/"
          class:list={[
            'flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all active:scale-95 min-h-[50px]',
            activeTab === 'media'
              ? 'text-brand-ice font-bold'
              : 'text-slate-400 hover:text-slate-200',
          ]}
        >
          <div class:list={[
            'p-1 rounded-lg transition-colors',
            activeTab === 'media' ? 'bg-brand-ice/15' : 'bg-transparent',
          ]}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-[10px] mt-0.5 tracking-tight font-medium">Media</span>
        </a>

        <!-- Tab 4: Settings -->
        <a
          href="/admin/settings/"
          class:list={[
            'flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-all active:scale-95 min-h-[50px]',
            activeTab === 'settings'
              ? 'text-brand-ice font-bold'
              : 'text-slate-400 hover:text-slate-200',
          ]}
        >
          <div class:list={[
            'p-1 rounded-lg transition-colors',
            activeTab === 'settings' ? 'bg-brand-ice/15' : 'bg-transparent',
          ]}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <span class="text-[10px] mt-0.5 tracking-tight font-medium">Settings</span>
        </a>
      </div>
    </nav>

    <!-- Admin Footer -->
    <footer class="hidden md:block bg-slate-900 border-t border-slate-800 py-6 text-center text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} Patel Cool Tech &bull; Owner Administration System</p>
    </footer>

    <!-- Client-side Cryptographic Auth Guardian Script & Live Sync -->
    <script>
      import { supabase, isSupabaseConfigured, isAuthorizedOwner } from '../utils/supabase';
      import { initLiveSync } from '../utils/liveSync';

      // Initialize liveSync to keep browser favicon and business settings synced
      initLiveSync();

      async function checkAdminAuth() {
        const isAuth = sessionStorage.getItem('pct_admin_authenticated');
        if (isAuth !== 'true') {
          try {
            if (supabase) await supabase.auth.signOut();
            localStorage.clear();
            sessionStorage.clear();
          } catch (_) {}
          window.location.replace('/admin/login/?unauthorized=1');
          return;
        }

        if (!isSupabaseConfigured || !supabase) {
          try { sessionStorage.clear(); } catch (_) {}
          window.location.replace('/admin/login/?unauthorized=1');
          return;
        }

        try {
          const { data: { session }, error } = await supabase.auth.getSession();

          if (error || !session || !session.user || !isAuthorizedOwner(session.user.email)) {
            // Unauthenticated or not owner: sign out and redirect immediately
            try {
              await supabase.auth.signOut();
              localStorage.clear();
              sessionStorage.clear();
            } catch (_) {}
            window.location.replace('/admin/login/?unauthorized=1');
            return;
          }

          // Verified owner confirmed! Safely reveal the protected dashboard
          const guardStyle = document.getElementById('admin-auth-guard-style');
          if (guardStyle) {
            guardStyle.remove();
          }
          document.documentElement.style.removeProperty('display');
          document.documentElement.style.removeProperty('visibility');
          document.documentElement.style.removeProperty('opacity');
          document.body.style.removeProperty('display');
          document.body.style.display = 'flex';
          document.body.style.setProperty('visibility', 'visible', 'important');
          document.body.style.setProperty('opacity', '1', 'important');
          document.body.style.transition = 'opacity 0.2s ease-in';

          const overlay = document.getElementById('auth-verifier-overlay');
          if (overlay) {
            overlay.style.opacity = '0';
            setTimeout(() => overlay.remove(), 200);
          }

          const emailEl = document.getElementById('header-owner-email');
          if (emailEl && session.user.email) {
            emailEl.textContent = session.user.email;
          }
        } catch (err) {
          try { localStorage.clear(); sessionStorage.clear(); } catch (_) {}
          window.location.replace('/admin/login/?unauthorized=1');
        }
      }

      // Real-time auth listener: if token revoked or sign-out triggered, immediately lock screen
      if (supabase) {
        supabase.auth.onAuthStateChange((event, session) => {
          if (event === 'SIGNED_OUT' || !session || !isAuthorizedOwner(session?.user?.email)) {
            try { localStorage.clear(); sessionStorage.clear(); } catch (_) {}
            window.location.replace('/admin/login/?logout=1');
          }
        });
      }

      // Logout handler
      const logoutBtn = document.getElementById('admin-logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          if (supabase) {
            try { await supabase.auth.signOut(); } catch (_) {}
          }
          try {
            localStorage.clear();
            sessionStorage.clear();
          } catch (_) {}
          window.location.replace('/admin/login/?logout=1');
        });
      }

      checkAdminAuth();
    </script>
  </body>
</html>
