---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import WorkPreview from '../components/WorkPreview.astro';
import BrandsSection from '../components/BrandsSection.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import AboutPreview from '../components/AboutPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { siteConfig } from '../data/site';
import { getSiteSettings } from '../utils/supabase';

const settings = await getSiteSettings();
---

<BaseLayout
  title="AC Installation, Repair & Service in Indore"
  description={siteConfig.defaultDescription}
>
  <!-- 1. Hero Section with Real Photography & Floating Badges -->
  <Hero settings={settings} />

  <!-- 2. Major Brands Section (Supported Makes - Directly Below Hero) -->
  <BrandsSection />

  <!-- 3. Services Overview Section (#services) -->
  <ServicesOverview />

  <!-- 4. Our Work Preview Section (#work) with Interactive Lightbox -->
  <WorkPreview />

  <!-- 5. Service Areas Section (Indore, Rau, Pithampur) -->
  <ServiceAreas />

  <!-- 6. About / Team Introduction Section (#about) -->
  <AboutPreview settings={settings} />

  <!-- 7. Final High-Impact Contact CTA Section (#contact) -->
  <ContactCTA />
</BaseLayout>
