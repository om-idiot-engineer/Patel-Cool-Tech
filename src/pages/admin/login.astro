---
import '../../styles/global.css';
import BrandLogo from '../../components/BrandLogo.astro';
import { isSupabaseConfigured } from '../../utils/supabase';
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Owner Login | Patel Cool Tech</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="flex flex-col min-h-full items-center justify-center p-4 sm:p-6 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 font-sans">
    <!-- Ambient glow -->
    <div class="absolute w-96 h-96 bg-brand-ice/10 rounded-full blur-3xl pointer-events-none -z-0"></div>

    <div class="relative z-10 w-full max-w-md bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="flex justify-center mb-4">
          <BrandLogo variant="light" size="md" />
        </div>
        <h1 class="text-2xl font-extrabold text-white tracking-tight">Owner Portal Login</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1.5">
          Manage latest work photos, videos, services, and website settings
        </p>
      </div>

      <!-- Error / Alert Banner -->
      <div id="login-error" class="hidden mb-5 p-3.5 rounded-xl bg-rose-950/60 border border-rose-800/80 text-rose-200 text-xs flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="login-error-msg">Authentication failed. Please check your credentials.</span>
      </div>

      <!-- Demo Info if Supabase not configured -->
      {!isSupabaseConfigured && (
        <div class="mb-5 p-3.5 rounded-xl bg-amber-950/50 border border-amber-800/60 text-amber-200 text-xs">
          <p class="font-bold">Supabase Not Connected Yet</p>
          <p class="mt-0.5 text-[11px] text-amber-300">
            You can enter any demo credentials or click <strong>Continue to Demo Admin</strong> below to test the full owner interface.
          </p>
        </div>
      )}

      <!-- Login Form -->
      <form id="admin-login-form" class="space-y-4">
        <div>
          <label for="admin-email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Owner Email
          </label>
          <input
            type="email"
            id="admin-email"
            required
            autocomplete="email"
            placeholder="patelcooltech@gmail.com"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice focus:ring-1 focus:ring-brand-ice transition-colors text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Password
          </label>
          <input
            type="password"
            id="admin-password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice focus:ring-1 focus:ring-brand-ice transition-colors text-sm min-h-[48px]"
          />
        </div>

        <button
          type="submit"
          id="login-submit-btn"
          class="w-full mt-2 py-3.5 px-4 bg-brand-ice hover:bg-brand-ice-hover text-white font-bold rounded-xl text-sm transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.99] min-h-[48px] flex items-center justify-center gap-2 cursor-pointer"
        >
          <span id="btn-text">Sign In to Dashboard</span>
          <svg id="btn-spinner" class="hidden animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
      </form>

      <!-- Demo bypass button if unconfigured -->
      {!isSupabaseConfigured && (
        <div class="mt-4 pt-4 border-t border-slate-800 text-center">
          <a
            href="/admin/"
            class="inline-block text-xs font-semibold text-slate-400 hover:text-brand-ice transition-colors py-2"
          >
            Continue to Demo Admin &rarr;
          </a>
        </div>
      )}

      <!-- Bottom return link -->
      <div class="mt-6 text-center">
        <a href="/" class="text-xs text-slate-500 hover:text-slate-300 transition-colors">
          &larr; Return to public website
        </a>
      </div>
    </div>

    <!-- Client-side Login Handler -->
    <script>
      import { supabase, isSupabaseConfigured } from '../../utils/supabase';

      const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
      const emailInput = document.getElementById('admin-email') as HTMLInputElement | null;
      const passInput = document.getElementById('admin-password') as HTMLInputElement | null;
      const errorBox = document.getElementById('login-error');
      const errorMsg = document.getElementById('login-error-msg');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');
      const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement | null;

      // Auto redirect if already logged in
      async function checkExistingSession() {
        if (isSupabaseConfigured && supabase) {
          const { data: { session } } = await supabase.auth.getSession();
          if (session) {
            window.location.href = '/admin/';
          }
        }
      }
      checkExistingSession();

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorBox?.classList.add('hidden');

          const email = emailInput?.value.trim() || '';
          const password = passInput?.value.trim() || '';

          if (!email || !password) return;

          // UI loading state
          if (btnText) btnText.textContent = 'Verifying credentials...';
          btnSpinner?.classList.remove('hidden');
          if (submitBtn) submitBtn.disabled = true;

          // If Supabase is unconfigured, allow demo access
          if (!isSupabaseConfigured || !supabase) {
            setTimeout(() => {
              window.location.href = '/admin/';
            }, 600);
            return;
          }

          try {
            const { error } = await supabase.auth.signInWithPassword({
              email,
              password,
            });

            if (error) {
              if (errorBox && errorMsg) {
                errorMsg.textContent = error.message || 'Invalid email or password.';
                errorBox.classList.remove('hidden');
              }
              if (btnText) btnText.textContent = 'Sign In to Dashboard';
              btnSpinner?.classList.add('hidden');
              if (submitBtn) submitBtn.disabled = false;
            } else {
              window.location.href = '/admin/';
            }
          } catch (err: any) {
            if (errorBox && errorMsg) {
              errorMsg.textContent = err.message || 'Network connection failed.';
              errorBox.classList.remove('hidden');
            }
            if (btnText) btnText.textContent = 'Sign In to Dashboard';
            btnSpinner?.classList.add('hidden');
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
