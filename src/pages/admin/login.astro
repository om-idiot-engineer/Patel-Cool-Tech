---
import '../../styles/global.css';
import BrandLogo from '../../components/BrandLogo.astro';
import { getSiteSettings, OWNER_EMAIL } from '../../utils/supabase';
import { getFaviconMimeType } from '../../utils/favicon';

const settings = await getSiteSettings();
const siteLogoUrl = settings?.logo_url || '';
const initialFavicon = siteLogoUrl || '/favicon.svg';
const initialFaviconType = getFaviconMimeType(initialFavicon);
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Owner Portal Login | Patel Cool Tech</title>
    <meta name="robots" content="noindex, nofollow" />
    <!-- Favicon & Mobile Web App Icons (Dynamic to Owner Logo) -->
    <link
      id="dynamic-favicon"
      rel="icon"
      {...(initialFaviconType ? { type: initialFaviconType } : {})}
      href={initialFavicon}
    />
    <link
      id="dynamic-apple-icon"
      rel="apple-touch-icon"
      href={initialFavicon}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Zero-latency inline script: applies owner-uploaded original logo to browser tab immediately -->
    <script is:inline>
      (function() {
        try {
          var logo = localStorage.getItem('pct_custom_logo');
          if (!logo) {
            var raw = localStorage.getItem('pct_site_settings');
            if (raw) {
              var s = JSON.parse(raw);
              if (s && s.logo_url) logo = s.logo_url;
            }
          }
          if (logo && logo.trim()) {
            var icon = document.getElementById('dynamic-favicon');
            var apple = document.getElementById('dynamic-apple-icon');
            var clean = logo.split('?')[0].toLowerCase();
            var mime = '';
            if (clean.indexOf('.svg') !== -1 || logo.indexOf('data:image/svg') === 0) mime = 'image/svg+xml';
            else if (clean.indexOf('.png') !== -1 || logo.indexOf('data:image/png') === 0) mime = 'image/png';
            else if (clean.indexOf('.jpg') !== -1 || clean.indexOf('.jpeg') !== -1 || logo.indexOf('data:image/jpeg') === 0) mime = 'image/jpeg';
            else if (clean.indexOf('.webp') !== -1 || logo.indexOf('data:image/webp') === 0) mime = 'image/webp';
            else if (clean.indexOf('.ico') !== -1 || logo.indexOf('data:image/x-icon') === 0) mime = 'image/x-icon';

            if (icon && icon.getAttribute('href') !== logo) {
              icon.href = logo;
              if (mime) icon.type = mime; else icon.removeAttribute('type');
            }
            if (apple && apple.getAttribute('href') !== logo) {
              apple.href = logo;
            }
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-full items-center justify-center p-4 sm:p-6 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 font-sans">
    <!-- Ambient glow -->
    <div class="absolute w-96 h-96 bg-brand-ice/10 rounded-full blur-3xl pointer-events-none -z-0"></div>

    <div class="relative z-10 w-full max-w-md bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
      <!-- Header -->
      <div class="text-center mb-6">
        <div class="flex justify-center mb-4">
          <BrandLogo variant="light" size="md" customLogoUrl={settings?.logo_url} />
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-ice/15 border border-brand-ice/30 text-[11px] font-bold text-brand-ice uppercase tracking-wider mb-2">
          <svg class="w-3.5 h-3.5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Restricted Owner Access
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Owner Portal Login</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Authorized access only for managing work portfolio, media, and site settings.
        </p>
      </div>



      <!-- Security Notice Banner (when redirecting from protected route) -->
      <div id="login-notice" class="hidden mb-4 p-3.5 rounded-xl bg-amber-950/60 border border-amber-800/80 text-amber-200 text-xs flex items-start gap-2.5">
        <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span id="login-notice-msg">Please enter your owner credentials to open the dashboard.</span>
      </div>

      <!-- Success / Logout Banner -->
      <div id="login-success" class="hidden mb-4 p-3.5 rounded-xl bg-emerald-950/60 border border-emerald-800/80 text-emerald-200 text-xs flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span id="login-success-msg">You have been logged out safely. Please enter password to log in again.</span>
      </div>

      <!-- Error / Alert Banner -->
      <div id="login-error" class="hidden mb-4 p-3.5 rounded-xl bg-rose-950/60 border border-rose-800/80 text-rose-200 text-xs flex items-start gap-2.5">
        <svg class="w-4 h-4 text-rose-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="login-error-msg">Invalid email or password. Please check your credentials.</span>
      </div>

      <!-- Secure Login Form -->
      <form id="admin-login-form" class="space-y-4">
        <div>
          <label for="admin-email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Owner Email
          </label>
          <input
            type="email"
            id="admin-email"
            required
            autocomplete="username"
            value={OWNER_EMAIL}
            placeholder={OWNER_EMAIL}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice focus:ring-1 focus:ring-brand-ice transition-colors text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              Password
            </label>
            <button
              type="button"
              id="toggle-password-btn"
              class="text-[11px] text-brand-ice hover:text-brand-ice-light font-medium transition-colors"
            >
              Show Password
            </button>
          </div>
          <div class="relative">
            <input
              type="password"
              id="admin-password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="w-full px-4 py-3 pr-11 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice focus:ring-1 focus:ring-brand-ice transition-colors text-base sm:text-sm min-h-[48px]"
            />
            <button
              type="button"
              id="toggle-password-icon-btn"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white p-1"
              aria-label="Toggle password visibility"
            >
              <svg id="eye-icon-show" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <svg id="eye-icon-hide" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
              </svg>
            </button>
          </div>
        </div>

        <button
          type="submit"
          id="login-submit-btn"
          class="w-full mt-2 py-3.5 px-4 bg-brand-ice hover:bg-brand-ice-hover text-white font-bold rounded-xl text-sm transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.99] min-h-[48px] flex items-center justify-center gap-2 cursor-pointer"
        >
          <span id="btn-text">Sign In to Dashboard</span>
          <svg id="btn-spinner" class="hidden animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
      </form>

      <!-- Bottom return link -->
      <div class="mt-6 text-center">
        <a href="/" class="text-xs text-slate-500 hover:text-slate-300 transition-colors inline-flex items-center gap-1">
          <span>&larr;</span>
          <span>Return to public website</span>
        </a>
      </div>
    </div>

    <!-- Client-side Secure Login Handler -->
    <script>
      import { supabase, isSupabaseConfigured, isAuthorizedOwner } from '../../utils/supabase';

      const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
      const emailInput = document.getElementById('admin-email') as HTMLInputElement | null;
      const passInput = document.getElementById('admin-password') as HTMLInputElement | null;
      const errorBox = document.getElementById('login-error');
      const errorMsg = document.getElementById('login-error-msg');
      const noticeBox = document.getElementById('login-notice');
      const noticeMsg = document.getElementById('login-notice-msg');
      const successBox = document.getElementById('login-success');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');
      const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement | null;

      // Password toggle buttons
      const toggleTextBtn = document.getElementById('toggle-password-btn');
      const toggleIconBtn = document.getElementById('toggle-password-icon-btn');
      const eyeShow = document.getElementById('eye-icon-show');
      const eyeHide = document.getElementById('eye-icon-hide');

      function togglePassword() {
        if (!passInput) return;
        const isPassword = passInput.type === 'password';
        passInput.type = isPassword ? 'text' : 'password';
        if (toggleTextBtn) {
          toggleTextBtn.textContent = isPassword ? 'Hide Password' : 'Show Password';
        }
        if (eyeShow && eyeHide) {
          eyeShow.classList.toggle('hidden', isPassword);
          eyeHide.classList.toggle('hidden', !isPassword);
        }
      }

      if (toggleTextBtn) toggleTextBtn.addEventListener('click', togglePassword);
      if (toggleIconBtn) toggleIconBtn.addEventListener('click', togglePassword);

      // Inspect URL parameters for unauthorized / logout flags
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('unauthorized') === '1' && noticeBox) {
        noticeBox.classList.remove('hidden');
      } else if (urlParams.get('logout') === '1' && successBox) {
        successBox.classList.remove('hidden');
      }

      // Ensure clean state on login page: clear lingering tokens if redirected
      async function clearPreviousAuth() {
        if (!isSupabaseConfigured || !supabase) return;
        try {
          if (urlParams.get('logout') === '1' || urlParams.get('unauthorized') === '1') {
            await supabase.auth.signOut();
            localStorage.clear();
            sessionStorage.clear();
          }
        } catch (_) {}
      }
      clearPreviousAuth();

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorBox?.classList.add('hidden');
          noticeBox?.classList.add('hidden');
          successBox?.classList.add('hidden');

          const email = emailInput?.value.trim() || '';
          const password = passInput?.value || '';

          if (!email || !password) {
            if (errorBox && errorMsg) {
              errorMsg.textContent = 'Please provide both email and password.';
              errorBox.classList.remove('hidden');
            }
            return;
          }

          // UI loading state
          if (btnText) btnText.textContent = 'Verifying credentials...';
          btnSpinner?.classList.remove('hidden');
          if (submitBtn) submitBtn.disabled = true;

          if (!isSupabaseConfigured || !supabase) {
            if (errorBox && errorMsg) {
              errorMsg.textContent = 'Supabase authentication service is currently unavailable.';
              errorBox.classList.remove('hidden');
            }
            if (btnText) btnText.textContent = 'Sign In to Dashboard';
            btnSpinner?.classList.add('hidden');
            if (submitBtn) submitBtn.disabled = false;
            return;
          }

          try {
            const { data, error } = await supabase.auth.signInWithPassword({
              email,
              password,
            });

            if (error) {
              if (errorBox && errorMsg) {
                errorMsg.textContent = error.message || 'Invalid email or password.';
                errorBox.classList.remove('hidden');
              }
              if (btnText) btnText.textContent = 'Sign In to Dashboard';
              btnSpinner?.classList.add('hidden');
              if (submitBtn) submitBtn.disabled = false;
              return;
            }

            // Verify owner authorization
            if (!isAuthorizedOwner(data.user?.email)) {
              await supabase.auth.signOut();
              if (errorBox && errorMsg) {
                errorMsg.textContent = 'Access restricted: Only authorized Patel Cool Tech owner account is permitted.';
                errorBox.classList.remove('hidden');
              }
              if (btnText) btnText.textContent = 'Sign In to Dashboard';
              btnSpinner?.classList.add('hidden');
              if (submitBtn) submitBtn.disabled = false;
              return;
            }

            // Successfully authenticated owner!
            sessionStorage.setItem('pct_admin_authenticated', 'true');
            if (btnText) btnText.textContent = 'Access granted. Opening dashboard...';
            window.location.replace('/admin/');
          } catch (err: any) {
            if (errorBox && errorMsg) {
              errorMsg.textContent = err.message || 'Network error occurred. Please try again.';
              errorBox.classList.remove('hidden');
            }
            if (btnText) btnText.textContent = 'Sign In to Dashboard';
            btnSpinner?.classList.add('hidden');
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
