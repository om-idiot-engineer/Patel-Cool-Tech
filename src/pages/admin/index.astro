---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { defaultFallbackWork, getPublishedWorkItems } from '../../utils/supabase';

const workItems = await getPublishedWorkItems();
const displayItems = workItems.length > 0 ? workItems : defaultFallbackWork;
const totalPublished = displayItems.filter(i => i.published).length;
const totalPhotos = displayItems.filter(i => i.media_type === 'image').length;
const totalVideos = displayItems.filter(i => i.media_type === 'video').length;
---

<AdminLayout title="Dashboard" activeTab="dashboard">
  <!-- Welcome Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 sm:pb-8 border-b border-slate-800">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-ice flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Owner Control Center
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Patel Cool Tech Management</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Update work portfolio, photos, videos, service details, and website branding.
      </p>
    </div>

    <!-- Quick Action: Add Work -->
    <a
      href="/admin/work/"
      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-ice hover:bg-brand-ice-hover text-white font-bold text-sm shadow-md transition-all active:scale-[0.98] min-h-[48px] w-full sm:w-auto flex-shrink-0 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
      <span>+ Add New Work</span>
    </a>
  </div>

  <!-- Metric Badges (Mobile Optimized 2x2 Grid) -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 my-6 sm:my-8">
    <!-- Published Projects -->
    <div class="p-4 sm:p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[11px] sm:text-xs font-bold uppercase text-slate-400">Published</span>
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 text-emerald-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>
      <div class="mt-3">
        <div class="text-2xl sm:text-3xl font-extrabold text-white" id="stat-published">{totalPublished}</div>
        <div class="text-[11px] text-emerald-400 font-semibold mt-0.5">Active online</div>
      </div>
    </div>

    <!-- Work Photos -->
    <div class="p-4 sm:p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[11px] sm:text-xs font-bold uppercase text-slate-400">Photos</span>
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-brand-ice/15 text-brand-ice flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
      <div class="mt-3">
        <div class="text-2xl sm:text-3xl font-extrabold text-white" id="stat-photos">{totalPhotos}</div>
        <div class="text-[11px] text-brand-ice font-semibold mt-0.5">Field captures</div>
      </div>
    </div>

    <!-- Work Videos -->
    <div class="p-4 sm:p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[11px] sm:text-xs font-bold uppercase text-slate-400">Videos</span>
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-purple-500/15 text-purple-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
      <div class="mt-3">
        <div class="text-2xl sm:text-3xl font-extrabold text-white" id="stat-videos">{totalVideos}</div>
        <div class="text-[11px] text-purple-400 font-semibold mt-0.5">Video clips</div>
      </div>
    </div>

    <!-- Service Coverage -->
    <div class="p-4 sm:p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[11px] sm:text-xs font-bold uppercase text-slate-400">Coverage</span>
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-sky-500/15 text-sky-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
      </div>
      <div class="mt-3">
        <div class="text-xl sm:text-3xl font-extrabold text-white">3 Hubs</div>
        <div class="text-[11px] text-slate-400 font-semibold mt-0.5 truncate">Indore, Rau, Pithampur</div>
      </div>
    </div>
  </div>

  <!-- Quick Action Navigation Tiles (Mobile Tap Cards) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-8 sm:mb-10">
    <a
      href="/admin/work/"
      class="p-4 sm:p-5 rounded-2xl bg-slate-900/80 hover:bg-slate-900 active:bg-slate-800 border border-slate-800 hover:border-brand-ice/40 transition-all flex items-center justify-between group active:scale-[0.99]"
    >
      <div class="flex items-center gap-3.5">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-brand-ice/15 text-brand-ice flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm sm:text-base font-bold text-white group-hover:text-brand-ice transition-colors">Manage Work Items &amp; Photos</h2>
          <p class="text-xs text-slate-400 mt-0.5">Upload photos/videos, add projects &amp; manage live showcase</p>
        </div>
      </div>
      <svg class="w-5 h-5 text-slate-500 group-hover:text-brand-ice flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a
      href="/admin/settings/"
      class="p-4 sm:p-5 rounded-2xl bg-slate-900/80 hover:bg-slate-900 active:bg-slate-800 border border-slate-800 hover:border-brand-ice/40 transition-all flex items-center justify-between group active:scale-[0.99]"
    >
      <div class="flex items-center gap-3.5">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm sm:text-base font-bold text-white group-hover:text-emerald-300 transition-colors">Website Settings</h2>
          <p class="text-xs text-slate-400 mt-0.5">Phone numbers, WhatsApp, Hero, Logo</p>
        </div>
      </div>
      <svg class="w-5 h-5 text-slate-500 group-hover:text-emerald-300 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>

  <!-- Latest Portfolio Items -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="p-4 sm:p-6 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-white">Latest Portfolio Items</h2>
        <p class="text-xs text-slate-400 mt-0.5">Projects currently displayed on the customer website</p>
      </div>
      <a href="/admin/work/" class="text-xs font-bold text-brand-ice hover:underline flex items-center gap-1">
        <span>View All</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- 1. Dedicated Mobile Card View (shown only on small screens) -->
    <div class="block sm:hidden divide-y divide-slate-800/80">
      {
        displayItems.map((item) => {
          const isVideo = item.media_type === 'video' || Boolean(item.video_url) || (Boolean(item.image_url) && /\.(mp4|webm|mov)$/i.test(item.image_url));
          const videoSrc = item.video_url || (isVideo ? item.image_url : '');
          return (
            <div class="p-3.5 flex items-center gap-3">
              {isVideo ? (
                <video
                  src={`${videoSrc}#t=0.001`}
                  muted
                  playsinline
                  preload="metadata"
                  class="w-16 h-16 object-cover rounded-xl border border-slate-700 bg-slate-950 flex-shrink-0 pointer-events-none"
                ></video>
              ) : (
                <img
                  src={item.thumbnail_url || item.image_url}
                  alt={item.title}
                  class="w-16 h-16 object-cover rounded-xl border border-slate-700 bg-slate-950 flex-shrink-0"
                  loading="lazy"
                />
              )}
              <div class="flex-grow min-w-0">
                <div class="font-bold text-sm text-white truncate">{item.title}</div>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-[11px] font-semibold text-brand-ice bg-brand-ice/10 px-2 py-0.5 rounded">
                    {item.category}
                  </span>
                  <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Live
                  </span>
                </div>
              </div>
              <a
                href="/admin/work/"
                class="px-3 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 flex-shrink-0 min-h-[38px] flex items-center"
              >
                Edit
              </a>
            </div>
          );
        })
      }
    </div>

    <!-- 2. Desktop & Tablet Table View (hidden on small mobile screens) -->
    <div class="hidden sm:block overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs uppercase bg-slate-950 text-slate-400 border-b border-slate-800">
          <tr>
            <th scope="col" class="py-3.5 px-4 sm:px-6">Media</th>
            <th scope="col" class="py-3.5 px-4">Title &amp; Category</th>
            <th scope="col" class="py-3.5 px-4">Type</th>
            <th scope="col" class="py-3.5 px-4">Status</th>
            <th scope="col" class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60" id="work-table-body">
          {
            displayItems.map((item) => {
              const isVideo = item.media_type === 'video' || Boolean(item.video_url) || (Boolean(item.image_url) && /\.(mp4|webm|mov)$/i.test(item.image_url));
              const videoSrc = item.video_url || (isVideo ? item.image_url : '');
              return (
                <tr class="hover:bg-slate-850/50 transition-colors">
                  <td class="py-3 px-4 sm:px-6">
                    {isVideo ? (
                      <video
                        src={`${videoSrc}#t=0.001`}
                        muted
                        playsinline
                        preload="metadata"
                        class="w-12 h-10 object-cover rounded-lg border border-slate-700 bg-slate-950 pointer-events-none"
                      ></video>
                    ) : (
                      <img
                        src={item.thumbnail_url || item.image_url}
                        alt={item.title}
                        class="w-12 h-10 object-cover rounded-lg border border-slate-700 bg-slate-950"
                        loading="lazy"
                      />
                    )}
                  </td>
                <td class="py-3 px-4">
                  <div class="font-bold text-white">{item.title}</div>
                  <div class="text-xs text-brand-ice mt-0.5">{item.category}</div>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-800 text-slate-300 capitalize">
                    {item.media_type}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Published
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <a
                    href="/admin/work/"
                    class="inline-block px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors"
                  >
                    Edit
                  </a>
                </td>
              </tr>
            );
          })
        }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
