---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { defaultFallbackWork } from '../../utils/supabase';

const workItems = defaultFallbackWork;
const totalPublished = workItems.filter(i => i.published).length;
const totalPhotos = workItems.filter(i => i.media_type === 'image').length;
const totalVideos = workItems.filter(i => i.media_type === 'video').length;
---

<AdminLayout title="Dashboard" activeTab="dashboard">
  <!-- Welcome Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 border-b border-slate-800">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-ice">Owner Control Center</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Patel Cool Tech Management</h1>
      <p class="text-sm text-slate-400 mt-1">
        Update work portfolio photographs, videos, service details, and website branding.
      </p>
    </div>

    <!-- Quick Action: Add Work -->
    <a
      href="/admin/work/"
      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-ice hover:bg-brand-ice-hover text-white font-bold text-sm shadow-md transition-all active:scale-[0.98] min-h-[48px] flex-shrink-0"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
      <span>+ Add New Work</span>
    </a>
  </div>

  <!-- Metric Badges -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 my-8">
    <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <span class="text-xs font-bold uppercase text-slate-400">Published Projects</span>
      <div class="flex items-baseline gap-2 mt-2">
        <span class="text-3xl font-extrabold text-white" id="stat-published">{totalPublished}</span>
        <span class="text-xs text-emerald-400 font-semibold">Active online</span>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <span class="text-xs font-bold uppercase text-slate-400">Work Photos</span>
      <div class="flex items-baseline gap-2 mt-2">
        <span class="text-3xl font-extrabold text-white" id="stat-photos">{totalPhotos}</span>
        <span class="text-xs text-brand-ice font-semibold">Field captures</span>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <span class="text-xs font-bold uppercase text-slate-400">Work Videos</span>
      <div class="flex items-baseline gap-2 mt-2">
        <span class="text-3xl font-extrabold text-white" id="stat-videos">{totalVideos}</span>
        <span class="text-xs text-purple-400 font-semibold">Video clips</span>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col justify-between">
      <span class="text-xs font-bold uppercase text-slate-400">Service Coverage</span>
      <div class="flex items-baseline gap-2 mt-2">
        <span class="text-xl font-bold text-white">3 Hubs</span>
        <span class="text-xs text-slate-400">Indore, Rau, Pithampur</span>
      </div>
    </div>
  </div>

  <!-- Quick Action Navigation Tiles -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
    <a
      href="/admin/work/"
      class="p-5 rounded-2xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-brand-ice/40 transition-all flex items-center gap-4 group"
    >
      <div class="w-12 h-12 rounded-xl bg-brand-ice/15 text-brand-ice flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-white group-hover:text-brand-ice transition-colors">Manage Work Items</h2>
        <p class="text-xs text-slate-400 mt-0.5">Add, edit, or remove installation &amp; repair projects</p>
      </div>
    </a>

    <a
      href="/admin/media/"
      class="p-5 rounded-2xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-brand-ice/40 transition-all flex items-center gap-4 group"
    >
      <div class="w-12 h-12 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-white group-hover:text-purple-300 transition-colors">Media Library</h2>
        <p class="text-xs text-slate-400 mt-0.5">Upload photos, videos, and storage files</p>
      </div>
    </a>

    <a
      href="/admin/settings/"
      class="p-5 rounded-2xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-brand-ice/40 transition-all flex items-center gap-4 group"
    >
      <div class="w-12 h-12 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors">Website Settings</h2>
        <p class="text-xs text-slate-400 mt-0.5">Phone numbers, WhatsApp, Hero, Logo</p>
      </div>
    </a>
  </div>

  <!-- Recent Work Items Table -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="p-5 sm:p-6 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-white">Latest Portfolio Items</h2>
        <p class="text-xs text-slate-400 mt-0.5">Projects currently displayed on the customer website</p>
      </div>
      <a href="/admin/work/" class="text-xs font-bold text-brand-ice hover:underline">
        View All &rarr;
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs uppercase bg-slate-950 text-slate-400 border-b border-slate-800">
          <tr>
            <th scope="col" class="py-3.5 px-4 sm:px-6">Media</th>
            <th scope="col" class="py-3.5 px-4">Title &amp; Category</th>
            <th scope="col" class="py-3.5 px-4 hidden sm:table-cell">Type</th>
            <th scope="col" class="py-3.5 px-4">Status</th>
            <th scope="col" class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60" id="work-table-body">
          {
            workItems.map((item) => (
              <tr class="hover:bg-slate-850/50 transition-colors">
                <td class="py-3 px-4 sm:px-6">
                  <img
                    src={item.thumbnail_url || item.image_url}
                    alt={item.title}
                    class="w-12 h-10 object-cover rounded-lg border border-slate-700 bg-slate-950"
                  />
                </td>
                <td class="py-3 px-4">
                  <div class="font-bold text-white">{item.title}</div>
                  <div class="text-xs text-brand-ice mt-0.5">{item.category}</div>
                </td>
                <td class="py-3 px-4 hidden sm:table-cell">
                  <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-800 text-slate-300 capitalize">
                    {item.media_type}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Published
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <a
                    href="/admin/work/"
                    class="inline-block px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors"
                  >
                    Edit
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
