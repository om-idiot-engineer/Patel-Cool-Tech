              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                </svg>
                <span>📱 Upload Mahendra's Photo</span>
              </button>

              <button
                type="button"
                id="tech-mahendra-remove-btn"
                class="w-full py-1.5 px-3 rounded-xl text-[11px] font-bold text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 border border-rose-900/40 transition-colors cursor-pointer flex items-center justify-center gap-1.5"
              >
                <span>Reset to Monogram (MP)</span>
              </button>
            </div>
          </div>

          <div id="tech-mahendra-spinner" class="hidden p-2 rounded-xl bg-slate-900 border border-sky-500/40 text-xs text-sky-300 flex items-center gap-2">
            <div class="animate-spin w-3.5 h-3.5 border-2 border-sky-400 border-t-transparent rounded-full"></div>
            <span>Uploading photo to cloud storage...</span>
