          <div id="tech-satyam-spinner" class="hidden p-2 rounded-xl bg-slate-900 border border-cyan-500/40 text-xs text-cyan-300 flex items-center gap-2">
            <div class="animate-spin w-3.5 h-3.5 border-2 border-cyan-400 border-t-transparent rounded-full"></div>
