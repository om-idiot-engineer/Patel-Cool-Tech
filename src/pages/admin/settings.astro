        <!-- Satyam Patel Photo Card -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-200">Satyam Patel</span>
            </div>
            <span id="tech-satyam-status" class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
              {settings.tech_satyam_photo_url ? 'Custom Photo' : 'Monogram (SP)'}
            </span>
          </div>

          <div class="flex items-center gap-4">
            <!-- Preview Box -->
            <div id="tech-satyam-preview" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-slate-900 to-sky-700 flex items-center justify-center text-white font-extrabold text-2xl shadow-md ring-2 ring-cyan-400/30 overflow-hidden flex-shrink-0">
              {settings.tech_satyam_photo_url ? (
                <img src={settings.tech_satyam_photo_url} alt="Satyam Patel" class="w-full h-full object-cover" />
              ) : (
                <span>SP</span>
              )}
            </div>
            <div class="space-y-2 flex-grow">
              <button
                type="button"
                id="tech-satyam-upload-btn"
                class="w-full py-2.5 px-3 rounded-xl bg-gradient-to-r from-cyan-600 to-teal-600 hover:from-cyan-500 hover:to-teal-500 text-white font-bold text-xs shadow-md transition-all active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                </svg>
                <span>📱 Upload Satyam's Photo</span>
              </button>

              <button
                type="button"
                id="tech-satyam-remove-btn"
                class="w-full py-1.5 px-3 rounded-xl text-[11px] font-bold text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 border border-rose-900/40 transition-colors cursor-pointer flex items-center justify-center gap-1.5"
              >
                <span>Reset to Monogram (SP)</span>
              </button>
