---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSiteSettings } from '../../utils/supabase';

const settings = await getSiteSettings();
---

<AdminLayout title="Website Settings" activeTab="settings">
  <!-- Top bar -->
  <!-- Top bar with Mobile Quick Save Action -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 sm:pb-6 border-b border-slate-800">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-ice">Owner Configuration</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-0.5">Website &amp; Brand Settings</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Update contact phone numbers, WhatsApp, hero media, visiting card logo, and business identity.
      </p>
    </div>

    <!-- Quick Save Button for Fast Mobile Action -->
    <button
      type="button"
      id="top-save-settings-btn"
      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-ice hover:bg-brand-ice-hover text-white font-bold text-sm shadow-md transition-all active:scale-[0.98] min-h-[48px] w-full sm:w-auto cursor-pointer flex-shrink-0"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
      <span>Save Changes</span>
    </button>
  </div>

  <!-- Notification Toast (Positioned above mobile dock) -->
  <div id="settings-toast" class="hidden fixed bottom-20 sm:bottom-6 right-4 sm:right-6 z-50 px-5 py-3.5 rounded-xl bg-emerald-900 border border-emerald-700 text-white text-sm font-semibold shadow-2xl flex items-center gap-3 transition-opacity duration-300">
    <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toast-message">Settings updated successfully.</span>
  </div>

  <form id="settings-form" class="mt-6 sm:mt-8 space-y-6 sm:space-y-8 max-w-4xl">
    <!-- Section 1: Business Identity & Contact Details -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-8 space-y-5">
      <div>
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span>Business Information &amp; Contact</span>
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">Primary business name and customer contact lines</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div>
          <label for="set-biz-name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Business Name
          </label>
          <input
            type="text"
            id="set-biz-name"
            value={settings.business_name}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="set-tagline" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Tagline
          </label>
          <input
            type="text"
            id="set-tagline"
            value={settings.tagline}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="set-phone-primary" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Primary Phone Number
          </label>
          <input
            type="text"
            id="set-phone-primary"
            value={settings.phone_primary}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="set-phone-secondary" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Secondary Phone Number
          </label>
          <input
            type="text"
            id="set-phone-secondary"
            value={settings.phone_secondary}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="set-whatsapp" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            WhatsApp Number (with country code)
          </label>
          <input
            type="text"
            id="set-whatsapp"
            value={settings.whatsapp_number}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="set-email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Business Email
          </label>
          <input
            type="email"
            id="set-email"
            value={settings.email}
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>
      </div>

      <div>
        <label for="set-service-areas" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Service Areas
        </label>
        <input
          type="text"
          id="set-service-areas"
          value={settings.service_areas}
          class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
        />
      </div>
    </div>

    <!-- Section 2: Hero Visual & Copy Customization (Mobile-friendly Upload enabled) -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-8 space-y-5">
      <div>
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Hero Media &amp; Headlines</span>
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">Customize the main showcase on the customer home page</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div>
          <label for="set-hero-type" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Hero Media Type
          </label>
          <select
            id="set-hero-type"
            class="w-full px-3 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          >
            <option value="image" selected={settings.hero_media_type === 'image'}>High-Quality Image</option>
            <option value="video" selected={settings.hero_media_type === 'video'}>Autoplay Work Video (Muted)</option>
          </select>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="set-hero-url" class="text-xs font-bold uppercase tracking-wider text-slate-300">
              Hero Media URL / File
            </label>
            <input type="file" id="hero-file-picker" accept="image/*,video/mp4,video/webm" class="hidden" />
            <button
              type="button"
              id="hero-upload-btn"
              class="text-xs font-bold text-purple-400 hover:text-purple-300 hover:underline flex items-center gap-1.5 cursor-pointer py-1"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span>📱 Upload from Phone</span>
            </button>
          </div>
          <input
            type="text"
            id="set-hero-url"
            value={settings.hero_media_url}
            placeholder="/images/hero/hero-technician.jpg or cloud URL"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
          <div id="hero-upload-spinner" class="hidden mt-2 p-2.5 rounded-xl bg-slate-950 border border-purple-500/40 text-xs text-purple-300 flex items-center gap-2">
            <div class="animate-spin w-3.5 h-3.5 border-2 border-purple-400 border-t-transparent rounded-full"></div>
            <span id="hero-upload-msg">Uploading hero media to cloud storage...</span>
          </div>
        </div>
      </div>

      <div>
        <label for="set-hero-heading" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Main Hero Heading (H1)
        </label>
        <input
          type="text"
          id="set-hero-heading"
          value={settings.hero_heading}
          class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
        />
      </div>

      <div>
        <label for="set-hero-desc" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
          Hero Supporting Description
        </label>
        <textarea
          id="set-hero-desc"
          rows="3"
          class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm"
        >{settings.hero_description}</textarea>
      </div>
    </div>

    <!-- Section 3: Official Brand Logo & Card Assets (Phone-Friendly Direct Upload) -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
            <span>Official Brand Logo</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Upload your visiting card logo photo or brand image to replace the default vector badge across the website.
          </p>
        </div>
      </div>

      <!-- Hidden File Input for Phone & Computer Picker -->
      <input
        type="file"
        id="logo-file-picker"
        accept="image/png,image/jpeg,image/jpg,image/webp,image/svg+xml,image/*"
        class="hidden"
      />

      <!-- Quick Action Upload Zone for Mobile & Desktop -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <button
            type="button"
            id="logo-upload-btn"
            class="inline-flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-sm shadow-lg shadow-emerald-950/40 transition-all active:scale-[0.98] min-h-[52px] cursor-pointer"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>📱 Choose Logo from Phone / Gallery</span>
          </button>

          <span class="text-xs text-slate-500 text-center sm:text-left">or tap below to select file</span>
        </div>

        <!-- Drag & Drop / Tap Dropzone -->
        <div
          id="logo-dropzone"
          class="border-2 border-dashed border-slate-700 hover:border-emerald-500/60 rounded-2xl p-5 sm:p-6 text-center bg-slate-950/60 transition-all cursor-pointer group"
        >
          <div class="flex flex-col items-center justify-center gap-2">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 group-hover:scale-110 flex items-center justify-center text-emerald-400 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <p class="text-xs sm:text-sm font-semibold text-white">Tap here to select visiting card or logo image</p>
            <p class="text-[11px] text-slate-400">Supports PNG, JPG, WebP, SVG (Transparent PNG recommended for best look)</p>
          </div>
        </div>

        <!-- Uploading Progress Indicator -->
        <div id="logo-upload-spinner" class="hidden p-3.5 rounded-xl bg-slate-950 border border-emerald-500/40 flex items-center justify-between text-xs text-emerald-300">
          <div class="flex items-center gap-2.5">
            <div class="animate-spin w-4 h-4 border-2 border-emerald-400 border-t-transparent rounded-full"></div>
            <span id="logo-upload-msg">Uploading logo from phone to cloud storage...</span>
          </div>
        </div>
      </div>

      <!-- Live Interactive Logo Preview Banner -->
      <div id="logo-preview-card" class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-200">Live Website Preview</span>
          </div>
          <span id="logo-badge-status" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
            {settings.logo_url ? 'Custom Logo Active' : 'Default Vector Icon'}
          </span>
        </div>

        <p class="text-xs text-slate-400">
          Here is how your brand identity will appear on light and dark sections across the website:
        </p>

        <!-- Previews in Dark & Light modes -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Dark Theme Container (Footer & Admin CMS) -->
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex items-center gap-3.5">
            <div id="preview-logo-dark" class="w-12 h-12 rounded-xl bg-slate-950 border border-slate-700/80 flex items-center justify-center p-1 overflow-hidden flex-shrink-0">
              {settings.logo_url ? (
                <img src={settings.logo_url} alt="Logo preview" class="max-h-10 max-w-full object-contain" />
              ) : (
                <div class="w-9 h-9 rounded-lg bg-white/10 text-brand-ice flex items-center justify-center">
                  <svg class="w-5 h-5 text-brand-ice" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
                  </svg>
                </div>
              )}
            </div>
            <div class="min-w-0">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Footer &amp; Admin Header</span>
              <p class="text-xs sm:text-sm font-extrabold text-white truncate">PATEL COOL TECH</p>
              <span class="text-[10px] text-slate-400 flex items-center gap-1 mt-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Indore &bull; MP
              </span>
            </div>
          </div>

          <!-- Light Theme Container (Customer Header & Mobile Menu) -->
          <div class="p-4 rounded-xl bg-white border border-slate-200 flex items-center gap-3.5 shadow-sm">
            <div id="preview-logo-light" class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-center p-1 overflow-hidden flex-shrink-0">
              {settings.logo_url ? (
                <img src={settings.logo_url} alt="Logo preview" class="max-h-10 max-w-full object-contain" />
              ) : (
                <div class="w-9 h-9 rounded-lg bg-brand-navy text-brand-ice flex items-center justify-center">
                  <svg class="w-5 h-5 text-brand-ice" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
                  </svg>
                </div>
              )}
            </div>
            <div class="min-w-0">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">Public Header &amp; Mobile Drawer</span>
              <p class="text-xs sm:text-sm font-extrabold text-brand-navy truncate">PATEL COOL TECH</p>
              <span class="text-[10px] text-brand-text-muted flex items-center gap-1 mt-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Indore &bull; MP
              </span>
            </div>
          </div>
        </div>

        <!-- Action Buttons for Logo -->
        <div class="pt-2 flex flex-wrap items-center gap-3 border-t border-slate-800/80">
          <button
            type="button"
            id="replace-logo-btn"
            class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 cursor-pointer transition-colors inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Change / Upload New Logo</span>
          </button>

          <button
            type="button"
            id="remove-logo-btn"
            class="px-4 py-2 rounded-xl text-xs font-bold text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 border border-rose-900/60 cursor-pointer transition-colors inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Reset to Default Vector Icon</span>
          </button>
        </div>
      </div>

      <!-- Advanced / Direct URL Override -->
      <details class="text-xs text-slate-400 pt-1">
        <summary class="cursor-pointer hover:text-slate-300 py-1 font-semibold select-none flex items-center gap-2">
          <span>⚙️ Advanced: View or paste image URL directly</span>
        </summary>
        <div class="mt-3 space-y-1.5 pl-3 border-l-2 border-slate-800">
          <label for="set-logo-url" class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
            Logo URL Path
          </label>
          <input
            type="text"
            id="set-logo-url"
            value={settings.logo_url}
            placeholder="Auto-filled when uploading via button above, or paste URL"
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice text-sm min-h-[44px]"
          />
          <p class="text-[11px] text-slate-500">
            Leave blank to use the built-in technical vector mark.
          </p>
        </div>
      </details>
    </div>

    <!-- Section 4: Verified Technician Profile Photos (Owner Account) -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Technician Profile Photos</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Upload personal photos of Mahendra Patel &amp; Satyam Patel from your phone or gallery to replace initials monograms across the website.
          </p>
        </div>
      </div>

      <!-- Hidden File Inputs -->
      <input type="file" id="tech-mahendra-file-picker" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" class="hidden" />
      <input type="file" id="tech-satyam-file-picker" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" class="hidden" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Mahendra Patel Photo Card -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-200">Mahendra Patel</span>
            </div>
