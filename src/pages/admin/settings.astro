    <!-- Submit Save Button -->
    <div class="pt-2 flex items-center justify-end">
      <button
        type="submit"
        id="save-settings-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-brand-ice hover:bg-brand-ice-hover text-white font-bold text-sm shadow-lg transition-all active:scale-[0.98] min-h-[50px] cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Save All Settings</span>
      </button>
