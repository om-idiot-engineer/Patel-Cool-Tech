            <div id="tech-mahendra-preview" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-slate-900 to-brand-blue flex items-center justify-center text-white font-extrabold text-2xl shadow-md ring-2 ring-sky-400/30 overflow-hidden flex-shrink-0">
