  </form>

  <script>
    import { supabase, isSupabaseConfigured } from '../../utils/supabase';
    import { broadcastSettingsUpdate } from '../../utils/liveSync';

    const form = document.getElementById('settings-form');
    const toast = document.getElementById('settings-toast');
    const toastMsg = document.getElementById('toast-message');

    // Logo elements
    const logoFilePicker = document.getElementById('logo-file-picker') as HTMLInputElement | null;
    const logoUploadBtn = document.getElementById('logo-upload-btn');
    const logoDropzone = document.getElementById('logo-dropzone');
    const replaceLogoBtn = document.getElementById('replace-logo-btn');
    const removeLogoBtn = document.getElementById('remove-logo-btn');
    const logoUrlInput = document.getElementById('set-logo-url') as HTMLInputElement | null;
    const logoUploadSpinner = document.getElementById('logo-upload-spinner');
    const logoUploadMsg = document.getElementById('logo-upload-msg');
    const previewLogoDark = document.getElementById('preview-logo-dark');
    const previewLogoLight = document.getElementById('preview-logo-light');
    const logoBadgeStatus = document.getElementById('logo-badge-status');

    // Hero elements
    const heroFilePicker = document.getElementById('hero-file-picker') as HTMLInputElement | null;
    const heroUploadBtn = document.getElementById('hero-upload-btn');
    const heroUrlInput = document.getElementById('set-hero-url') as HTMLInputElement | null;
    const heroUploadSpinner = document.getElementById('hero-upload-spinner');

    // Technician elements
    const techMahendraFilePicker = document.getElementById('tech-mahendra-file-picker') as HTMLInputElement | null;
    const techMahendraUploadBtn = document.getElementById('tech-mahendra-upload-btn');
    const techMahendraRemoveBtn = document.getElementById('tech-mahendra-remove-btn');
    const techMahendraUrlInput = document.getElementById('set-tech-mahendra-url') as HTMLInputElement | null;
    const techMahendraPreview = document.getElementById('tech-mahendra-preview');
    const techMahendraStatus = document.getElementById('tech-mahendra-status');
    const techMahendraSpinner = document.getElementById('tech-mahendra-spinner');

    const techSatyamFilePicker = document.getElementById('tech-satyam-file-picker') as HTMLInputElement | null;
    const techSatyamUploadBtn = document.getElementById('tech-satyam-upload-btn');
    const techSatyamRemoveBtn = document.getElementById('tech-satyam-remove-btn');
    const techSatyamUrlInput = document.getElementById('set-tech-satyam-url') as HTMLInputElement | null;
    const techSatyamPreview = document.getElementById('tech-satyam-preview');
    const techSatyamStatus = document.getElementById('tech-satyam-status');
    const techSatyamSpinner = document.getElementById('tech-satyam-spinner');

    function updateMahendraPreview(url: string | null) {
      if (url && url.trim().length > 0) {
        if (techMahendraPreview) {
          techMahendraPreview.innerHTML = `<img src="${url}" alt="Mahendra Patel" class="w-full h-full object-cover" />`;
        }
        if (techMahendraStatus) {
          techMahendraStatus.textContent = 'Custom Photo Active';
          techMahendraStatus.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-sky-950 text-sky-400 border border-sky-800';
        }
      } else {
        if (techMahendraPreview) {
          techMahendraPreview.innerHTML = '<span>MP</span>';
        }
        if (techMahendraStatus) {
          techMahendraStatus.textContent = 'Monogram (MP)';
          techMahendraStatus.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300';
        }
      }
    }

    function updateSatyamPreview(url: string | null) {
      if (url && url.trim().length > 0) {
        if (techSatyamPreview) {
          techSatyamPreview.innerHTML = `<img src="${url}" alt="Satyam Patel" class="w-full h-full object-cover" />`;
        }
        if (techSatyamStatus) {
          techSatyamStatus.textContent = 'Custom Photo Active';
          techSatyamStatus.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-cyan-950 text-cyan-400 border border-cyan-800';
        }
      } else {
        if (techSatyamPreview) {
          techSatyamPreview.innerHTML = '<span>SP</span>';
        }
        if (techSatyamStatus) {
          techSatyamStatus.textContent = 'Monogram (SP)';
          techSatyamStatus.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300';
        }
      }
    }

    function showToast(message: string = 'Settings updated successfully.') {
      if (toast) {
        if (toastMsg) toastMsg.textContent = message;
        toast.classList.remove('hidden');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 3500);
      }
    }

    // Default vector mark SVG
    const defaultVectorDark = `
      <div class="w-9 h-9 rounded-lg bg-white/10 text-brand-ice flex items-center justify-center">
        <svg class="w-5 h-5 text-brand-ice" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
        </svg>
      </div>
    `;

    const defaultVectorLight = `
      <div class="w-9 h-9 rounded-lg bg-brand-navy text-brand-ice flex items-center justify-center">
        <svg class="w-5 h-5 text-brand-ice" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
        </svg>
      </div>
    `;

    function updateLogoPreview(url: string | null) {
      if (url && url.trim().length > 0) {
        if (previewLogoDark) {
          previewLogoDark.innerHTML = `<img src="${url}" alt="Logo preview dark" class="max-h-10 max-w-full object-contain" />`;
        }
        if (previewLogoLight) {
          previewLogoLight.innerHTML = `<img src="${url}" alt="Logo preview light" class="max-h-10 max-w-full object-contain" />`;
        }
        if (logoBadgeStatus) {
          logoBadgeStatus.textContent = 'Custom Logo Active';
          logoBadgeStatus.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-900/60 text-emerald-300 border border-emerald-700/60';
        }
      } else {
        if (previewLogoDark) previewLogoDark.innerHTML = defaultVectorDark;
        if (previewLogoLight) previewLogoLight.innerHTML = defaultVectorLight;
        if (logoBadgeStatus) {
          logoBadgeStatus.textContent = 'Default Vector Icon';
          logoBadgeStatus.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300';
        }
      }
    }

    // Connect Logo Picker triggers
    logoUploadBtn?.addEventListener('click', () => logoFilePicker?.click());
    logoDropzone?.addEventListener('click', () => logoFilePicker?.click());
    replaceLogoBtn?.addEventListener('click', () => logoFilePicker?.click());

    // Drag & Drop on dropzone
    logoDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      logoDropzone.classList.add('border-emerald-400', 'bg-emerald-950/20');
    });
    logoDropzone?.addEventListener('dragleave', () => {
      logoDropzone.classList.remove('border-emerald-400', 'bg-emerald-950/20');
    });
    logoDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      logoDropzone.classList.remove('border-emerald-400', 'bg-emerald-950/20');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleLogoFileUpload(e.dataTransfer.files[0]);
      }
    });

    // Handle File Pick
    logoFilePicker?.addEventListener('change', () => {
      const file = logoFilePicker.files?.[0];
      if (file) {
        handleLogoFileUpload(file);
      }
    });

    async function handleLogoFileUpload(file: File) {
      logoUploadSpinner?.classList.remove('hidden');
      if (logoUploadMsg) logoUploadMsg.textContent = `Uploading "${file.name}" to cloud storage...`;

      // Show immediate local object preview
      const localPreviewUrl = URL.createObjectURL(file);
      updateLogoPreview(localPreviewUrl);

      if (isSupabaseConfigured && supabase) {
        try {
          const fileExt = file.name.split('.').pop() || 'png';
          const cleanName = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.]/g, '_')}`;
          const filePath = `logos/${cleanName}`;

          const { error: uploadError } = await supabase.storage
            .from('work-media')
            .upload(filePath, file, { upsert: true });

          if (uploadError) throw uploadError;

          const { data: { publicUrl } } = supabase.storage
            .from('work-media')
            .getPublicUrl(filePath);

          if (logoUrlInput) logoUrlInput.value = publicUrl;
          broadcastSettingsUpdate({ logo_url: publicUrl });
          updateLogoPreview(publicUrl);

          // Auto-save setting to Supabase site_settings
          const { error: upsertErr } = await supabase.from('site_settings').upsert({
            id: 'default',
            logo_url: publicUrl,
            updated_at: new Date().toISOString(),
          });

          if (upsertErr) {
            console.error('Supabase upsert error:', upsertErr);
            showToast('Logo uploaded, but saving to DB failed: ' + upsertErr.message);
          } else {
            showToast('Official Logo uploaded & saved successfully!');
          }
        } catch (err: any) {
          console.error('Logo upload error:', err);
          // If storage bucket isn't created or fails, fall back to Base64 data URL
          const reader = new FileReader();
          reader.onload = (e) => {
            const dataUrl = e.target?.result as string;
            if (logoUrlInput) logoUrlInput.value = dataUrl;
            broadcastSettingsUpdate({ logo_url: dataUrl });
            updateLogoPreview(dataUrl);
            showToast('Logo attached locally. Click "Save All Settings" to confirm.');
          };
          reader.readAsDataURL(file);
        }
      } else {
        // Local/Demo Mode: read as data URL
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUrl = e.target?.result as string;
          if (logoUrlInput) logoUrlInput.value = dataUrl;
          broadcastSettingsUpdate({ logo_url: dataUrl });
          updateLogoPreview(dataUrl);
          showToast('Logo selected! Tap "Save All Settings" to apply.');
        };
        reader.readAsDataURL(file);
      }

      logoUploadSpinner?.classList.add('hidden');
    }

    // Remove Logo Button
    removeLogoBtn?.addEventListener('click', async () => {
      if (confirm('Reset logo to default technical vector badge?')) {
        if (logoUrlInput) logoUrlInput.value = '';
        broadcastSettingsUpdate({ logo_url: '' });
        updateLogoPreview('');

        if (isSupabaseConfigured && supabase) {
          await supabase.from('site_settings').upsert({
            id: 'default',
            logo_url: '',
            updated_at: new Date().toISOString(),
          });
        }
        showToast('Logo reset to default vector icon.');
      }
    });

    // Update preview when URL input changes manually
    logoUrlInput?.addEventListener('input', () => {
      updateLogoPreview(logoUrlInput.value);
    });

    // Hero Media File Picker
    heroUploadBtn?.addEventListener('click', () => heroFilePicker?.click());
    heroFilePicker?.addEventListener('change', async () => {
      const file = heroFilePicker.files?.[0];
      if (!file) return;

      heroUploadSpinner?.classList.remove('hidden');

      if (isSupabaseConfigured && supabase) {
        try {
          const cleanName = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.]/g, '_')}`;
          const filePath = `hero/${cleanName}`;

          const { error: uploadError } = await supabase.storage
            .from('work-media')
            .upload(filePath, file, { upsert: true });

          if (uploadError) throw uploadError;

          const { data: { publicUrl } } = supabase.storage
            .from('work-media')
            .getPublicUrl(filePath);

          if (heroUrlInput) heroUrlInput.value = publicUrl;
          broadcastSettingsUpdate({ hero_media_url: publicUrl });
          showToast('Hero media uploaded successfully.');
        } catch (err: any) {
          alert('Hero upload failed: ' + err.message);
        }
      } else {
        const objectUrl = URL.createObjectURL(file);
        if (heroUrlInput) heroUrlInput.value = objectUrl;
        broadcastSettingsUpdate({ hero_media_url: objectUrl });
        showToast('Hero media attached for preview.');
      }

      heroUploadSpinner?.classList.add('hidden');
    });

    // Technician Photo File Pickers
    techMahendraUploadBtn?.addEventListener('click', () => techMahendraFilePicker?.click());
    techMahendraFilePicker?.addEventListener('change', async () => {
      const file = techMahendraFilePicker.files?.[0];
      if (!file) return;

      techMahendraSpinner?.classList.remove('hidden');

      if (isSupabaseConfigured && supabase) {
        try {
          const fileExt = file.name.split('.').pop() || 'jpg';
          const cleanName = `mahendra-${Date.now()}.${fileExt}`;
          const filePath = `team/${cleanName}`;

          const { error: uploadError } = await supabase.storage
            .from('work-media')
            .upload(filePath, file, { upsert: true });

          if (uploadError) throw uploadError;

          const { data: { publicUrl } } = supabase.storage
            .from('work-media')
            .getPublicUrl(filePath);

          if (techMahendraUrlInput) techMahendraUrlInput.value = publicUrl;
          updateMahendraPreview(publicUrl);
          broadcastSettingsUpdate({ tech_mahendra_photo_url: publicUrl });

          await supabase.from('site_settings').upsert({
            id: 'default',
            tech_mahendra_photo_url: publicUrl,
            updated_at: new Date().toISOString(),
          });

          showToast("Mahendra Patel's photo uploaded & saved successfully!");
        } catch (err: any) {
          console.error('Mahendra photo upload error:', err);
          const reader = new FileReader();
          reader.onload = (e) => {
            const dataUrl = e.target?.result as string;
            if (techMahendraUrlInput) techMahendraUrlInput.value = dataUrl;
            updateMahendraPreview(dataUrl);
            broadcastSettingsUpdate({ tech_mahendra_photo_url: dataUrl });
            showToast('Photo attached locally. Click "Save Changes" to confirm.');
          };
          reader.readAsDataURL(file);
        }
      } else {
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUrl = e.target?.result as string;
          if (techMahendraUrlInput) techMahendraUrlInput.value = dataUrl;
          updateMahendraPreview(dataUrl);
          broadcastSettingsUpdate({ tech_mahendra_photo_url: dataUrl });
          showToast('Photo attached locally. Click "Save Changes" to confirm.');
        };
        reader.readAsDataURL(file);
      }

      techMahendraSpinner?.classList.add('hidden');
    });

    techMahendraRemoveBtn?.addEventListener('click', async () => {
      if (confirm("Reset Mahendra Patel's photo to default monogram (MP)?")) {
        if (techMahendraUrlInput) techMahendraUrlInput.value = '';
        updateMahendraPreview('');
        broadcastSettingsUpdate({ tech_mahendra_photo_url: '' });

        if (isSupabaseConfigured && supabase) {
          await supabase.from('site_settings').upsert({
            id: 'default',
            tech_mahendra_photo_url: '',
            updated_at: new Date().toISOString(),
          });
        }
        showToast("Mahendra Patel photo reset to default monogram.");
      }
    });

    // Satyam Photo Picker
    techSatyamUploadBtn?.addEventListener('click', () => techSatyamFilePicker?.click());
    techSatyamFilePicker?.addEventListener('change', async () => {
      const file = techSatyamFilePicker.files?.[0];
      if (!file) return;

      techSatyamSpinner?.classList.remove('hidden');

      if (isSupabaseConfigured && supabase) {
        try {
          const fileExt = file.name.split('.').pop() || 'jpg';
          const cleanName = `satyam-${Date.now()}.${fileExt}`;
          const filePath = `team/${cleanName}`;

          const { error: uploadError } = await supabase.storage
            .from('work-media')
            .upload(filePath, file, { upsert: true });

          if (uploadError) throw uploadError;

          const { data: { publicUrl } } = supabase.storage
            .from('work-media')
            .getPublicUrl(filePath);

          if (techSatyamUrlInput) techSatyamUrlInput.value = publicUrl;
          updateSatyamPreview(publicUrl);
          broadcastSettingsUpdate({ tech_satyam_photo_url: publicUrl });

          await supabase.from('site_settings').upsert({
            id: 'default',
            tech_satyam_photo_url: publicUrl,
            updated_at: new Date().toISOString(),
          });

          showToast("Satyam Patel's photo uploaded & saved successfully!");
        } catch (err: any) {
          console.error('Satyam photo upload error:', err);
          const reader = new FileReader();
          reader.onload = (e) => {
            const dataUrl = e.target?.result as string;
            if (techSatyamUrlInput) techSatyamUrlInput.value = dataUrl;
            updateSatyamPreview(dataUrl);
            broadcastSettingsUpdate({ tech_satyam_photo_url: dataUrl });
            showToast('Photo attached locally. Click "Save Changes" to confirm.');
          };
          reader.readAsDataURL(file);
        }
      } else {
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUrl = e.target?.result as string;
          if (techSatyamUrlInput) techSatyamUrlInput.value = dataUrl;
          updateSatyamPreview(dataUrl);
          broadcastSettingsUpdate({ tech_satyam_photo_url: dataUrl });
          showToast('Photo attached locally. Click "Save Changes" to confirm.');
        };
        reader.readAsDataURL(file);
      }

      techSatyamSpinner?.classList.add('hidden');
    });

    techSatyamRemoveBtn?.addEventListener('click', async () => {
      if (confirm("Reset Satyam Patel's photo to default monogram (SP)?")) {
        if (techSatyamUrlInput) techSatyamUrlInput.value = '';
        updateSatyamPreview('');
        broadcastSettingsUpdate({ tech_satyam_photo_url: '' });

        if (isSupabaseConfigured && supabase) {
          await supabase.from('site_settings').upsert({
            id: 'default',
            tech_satyam_photo_url: '',
            updated_at: new Date().toISOString(),
          });
        }
        showToast("Satyam Patel photo reset to default monogram.");
      }
    });

    // Load initial settings on client mount (from Supabase or localStorage)
    window.addEventListener('DOMContentLoaded', async () => {
      // Check localStorage for logo fallback if input is empty
      const cachedLogo = localStorage.getItem('pct_custom_logo');
      if (logoUrlInput && !logoUrlInput.value && cachedLogo) {
        logoUrlInput.value = cachedLogo;
        updateLogoPreview(cachedLogo);
      }

      // If Supabase is configured, fetch latest settings to sync form
      if (isSupabaseConfigured && supabase) {
        try {
          const { data } = await supabase
            .from('site_settings')
            .select('*')
            .eq('id', 'default')
            .single();

          if (data) {
            if (data.logo_url) {
              if (logoUrlInput) logoUrlInput.value = data.logo_url;
              updateLogoPreview(data.logo_url);
            }
            if (data.hero_media_url && heroUrlInput) {
              heroUrlInput.value = data.hero_media_url;
            }
            if (data.tech_mahendra_photo_url && techMahendraUrlInput) {
              techMahendraUrlInput.value = data.tech_mahendra_photo_url;
              updateMahendraPreview(data.tech_mahendra_photo_url);
            }
            if (data.tech_satyam_photo_url && techSatyamUrlInput) {
              techSatyamUrlInput.value = data.tech_satyam_photo_url;
              updateSatyamPreview(data.tech_satyam_photo_url);
            }
          }
        } catch (err) {
          console.warn('Could not sync latest settings from Supabase:', err);
        }
      }
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const bizName = (document.getElementById('set-biz-name') as HTMLInputElement | null)?.value || '';
      const tagline = (document.getElementById('set-tagline') as HTMLInputElement | null)?.value || '';
      const phone1 = (document.getElementById('set-phone-primary') as HTMLInputElement | null)?.value || '';
      const phone2 = (document.getElementById('set-phone-secondary') as HTMLInputElement | null)?.value || '';
      const whatsapp = (document.getElementById('set-whatsapp') as HTMLInputElement | null)?.value || '';
      const email = (document.getElementById('set-email') as HTMLInputElement | null)?.value || '';
      const serviceAreas = (document.getElementById('set-service-areas') as HTMLInputElement | null)?.value || '';
      const heroType = (document.getElementById('set-hero-type') as HTMLSelectElement | null)?.value as any;
      const heroUrl = (document.getElementById('set-hero-url') as HTMLInputElement | null)?.value || '';
      const heroHeading = (document.getElementById('set-hero-heading') as HTMLInputElement | null)?.value || '';
      const heroDesc = (document.getElementById('set-hero-desc') as HTMLTextAreaElement | null)?.value || '';
      const logoUrl = (document.getElementById('set-logo-url') as HTMLInputElement | null)?.value || '';
      const techMahendraPhoto = (document.getElementById('set-tech-mahendra-url') as HTMLInputElement | null)?.value || '';
      const techSatyamPhoto = (document.getElementById('set-tech-satyam-url') as HTMLInputElement | null)?.value || '';

      const updatedPayload = {
        id: 'default',
        business_name: bizName,
        tagline,
        phone_primary: phone1,
        phone_secondary: phone2,
        whatsapp_number: whatsapp,
        email,
        service_areas: serviceAreas,
        hero_media_type: heroType,
        hero_media_url: heroUrl,
        hero_heading: heroHeading,
        hero_description: heroDesc,
        logo_url: logoUrl,
        tech_mahendra_photo_url: techMahendraPhoto,
        tech_satyam_photo_url: techSatyamPhoto,
        updated_at: new Date().toISOString(),
      };

      // Instantly broadcast update locally and across tabs
      broadcastSettingsUpdate(updatedPayload as any);

      let dbError: any = null;
      if (isSupabaseConfigured && supabase) {
        const { error } = await supabase.from('site_settings').upsert(updatedPayload);
        if (error) {
          dbError = error;
          console.error('Supabase settings upsert error:', error);
        }
      }

      if (dbError) {
        alert('Settings applied locally, but saving to Supabase database returned: ' + dbError.message);
      } else {
        showToast('All website, logo and technician settings saved successfully!');
      }
    });

    const topSaveBtn = document.getElementById('top-save-settings-btn');
    topSaveBtn?.addEventListener('click', () => {
      form?.requestSubmit();
    });
  </script>
</AdminLayout>
