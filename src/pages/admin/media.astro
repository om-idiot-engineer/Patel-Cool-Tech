---
import AdminLayout from '../../layouts/AdminLayout.astro';

const initialMedia = [
  {
    id: 'med-1',
    file_name: 'hero-technician.jpg',
    file_url: '/images/hero/hero-technician.jpg',
    file_type: 'image',
    category: 'hero',
    created_at: '2026-10-08',
  },
  {
    id: 'med-2',
    file_name: 'ac-installation.jpg',
    file_url: '/images/work/ac-installation.jpg',
    file_type: 'image',
    category: 'work',
    created_at: '2026-10-08',
  },
  {
    id: 'med-3',
    file_name: 'ac-repair.jpg',
    file_url: '/images/work/ac-repair.jpg',
    file_type: 'image',
    category: 'work',
    created_at: '2026-10-08',
  },
  {
    id: 'med-4',
    file_name: 'ac-service.jpg',
    file_url: '/images/work/ac-service.jpg',
    file_type: 'image',
    category: 'work',
    created_at: '2026-10-08',
  },
  {
    id: 'med-5',
    file_name: 'ac-gas-charging.jpg',
    file_url: '/images/work/ac-gas-charging.jpg',
    file_type: 'image',
    category: 'work',
    created_at: '2026-10-08',
  },
];
---

<AdminLayout title="Media Library" activeTab="media">
  <!-- Top bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-ice">Asset Storage</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-0.5">Media Library</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Upload and manage photos, job videos, logos, and hero media for the website.
      </p>
    </div>

    <!-- Upload Media Button -->
    <div>
      <input type="file" id="media-library-upload-input" accept="image/*,video/mp4,video/webm" multiple class="hidden" />
      <button
        type="button"
        id="upload-media-trigger-btn"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm shadow-md transition-all active:scale-[0.98] min-h-[48px] cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span>Upload Media Files</span>
      </button>
    </div>
  </div>

  <!-- Filter chips -->
  <div class="flex flex-wrap items-center gap-2 my-6">
    <button
      type="button"
      class="media-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-white border border-slate-700 cursor-pointer"
      data-filter="all"
    >
      All Media
    </button>
    <button
      type="button"
      class="media-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer"
      data-filter="image"
    >
      Images
    </button>
    <button
      type="button"
      class="media-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer"
      data-filter="video"
    >
      Videos
    </button>
    <button
      type="button"
      class="media-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer"
      data-filter="hero"
    >
      Hero
    </button>
    <button
      type="button"
      class="media-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer"
      data-filter="work"
    >
      Work
    </button>
  </div>

  <!-- Upload progress notification -->
  <div id="upload-status" class="hidden mb-6 p-4 rounded-xl bg-slate-900 border border-brand-ice/40 flex items-center justify-between text-xs text-brand-ice-light">
    <div class="flex items-center gap-2.5">
      <div class="animate-spin w-4 h-4 border-2 border-brand-ice border-t-transparent rounded-full"></div>
      <span id="upload-status-text">Uploading files to Supabase cloud storage...</span>
    </div>
  </div>

  <!-- Media Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4" id="media-grid">
    {
      initialMedia.map((m) => (
        <div
          class="media-item bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between group"
          data-type={m.file_type}
          data-category={m.category}
        >
          <div class="relative w-full aspect-square bg-slate-950 overflow-hidden">
            <img
              src={m.file_url}
              alt={m.file_name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
            />
            <span class="absolute top-2 left-2 px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-950/80 text-slate-300">
              {m.category}
            </span>
          </div>
          <div class="p-3">
            <p class="text-xs font-bold text-white truncate" title={m.file_name}>
              {m.file_name}
            </p>
            <div class="mt-2.5 pt-2 border-t border-slate-800 flex items-center justify-between text-[11px]">
              <button
                type="button"
                class="copy-url-btn text-brand-ice hover:underline font-semibold cursor-pointer"
                data-url={m.file_url}
              >
                Copy Link
              </button>
              <button
                type="button"
                class="delete-media-btn text-rose-400 hover:text-rose-300 font-semibold cursor-pointer"
                data-id={m.id}
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <script>
    import { supabase, isSupabaseConfigured } from '../../utils/supabase';

    const uploadTrigger = document.getElementById('upload-media-trigger-btn');
    const fileInput = document.getElementById('media-library-upload-input') as HTMLInputElement | null;
    const uploadStatus = document.getElementById('upload-status');
    const uploadStatusText = document.getElementById('upload-status-text');
    const mediaGrid = document.getElementById('media-grid');
    const filterButtons = document.querySelectorAll('.media-filter-btn');

    uploadTrigger?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', async () => {
      const files = fileInput.files;
      if (!files || files.length === 0) return;

      uploadStatus?.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        if (uploadStatusText) {
          uploadStatusText.textContent = `Uploading ${file.name} (${i + 1}/${files.length})...`;
        }

        if (isSupabaseConfigured && supabase) {
          try {
            const ext = file.name.split('.').pop();
            const fileName = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.]/g, '_')}`;
            const { error } = await supabase.storage
              .from('work-media')
              .upload(`library/${fileName}`, file);

            if (error) throw error;

            const { data: { publicUrl } } = supabase.storage
              .from('work-media')
              .getPublicUrl(`library/${fileName}`);

            // Add record to site_media table
            await supabase.from('site_media').insert([{
              file_name: file.name,
              file_url: publicUrl,
              file_type: file.type.startsWith('video') ? 'video' : 'image',
              category: 'general',
              file_size: file.size,
            }]);

            // Append item to DOM
            appendMediaItem(file.name, publicUrl, file.type.startsWith('video') ? 'video' : 'image', 'general');
          } catch (err: any) {
            alert('Upload failed: ' + err.message);
          }
        } else {
          // Demo fallback
          const objectUrl = URL.createObjectURL(file);
          appendMediaItem(file.name, objectUrl, file.type.startsWith('video') ? 'video' : 'image', 'general');
        }
      }

      uploadStatus?.classList.add('hidden');
      alert('Upload completed successfully!');
    });

    function appendMediaItem(name: string, url: string, type: string, category: string) {
      if (!mediaGrid) return;
      const card = document.createElement('div');
      card.className = 'media-item bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between group';
      card.setAttribute('data-type', type);
      card.setAttribute('data-category', category);
      card.innerHTML = `
        <div class="relative w-full aspect-square bg-slate-950 overflow-hidden">
          <img src="${url}" alt="${name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
          <span class="absolute top-2 left-2 px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-950/80 text-slate-300">
            ${category}
          </span>
        </div>
        <div class="p-3">
          <p class="text-xs font-bold text-white truncate" title="${name}">${name}</p>
          <div class="mt-2.5 pt-2 border-t border-slate-800 flex items-center justify-between text-[11px]">
            <button type="button" class="copy-url-btn text-brand-ice hover:underline font-semibold cursor-pointer" data-url="${url}">
              Copy Link
            </button>
            <button type="button" class="delete-media-btn text-rose-400 hover:text-rose-300 font-semibold cursor-pointer">
              Delete
            </button>
          </div>
        </div>
      `;
      mediaGrid.prepend(card);
      attachListeners();
    }

    function attachListeners() {
      document.querySelectorAll('.copy-url-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const url = btn.getAttribute('data-url');
          if (url) {
            navigator.clipboard.writeText(url);
            btn.textContent = 'Copied!';
            setTimeout(() => (btn.textContent = 'Copy Link'), 2000);
          }
        });
      });

      document.querySelectorAll('.delete-media-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const card = (e.target as HTMLElement).closest('.media-item');
          if (confirm('Delete this media file from the library?')) {
            card?.remove();
          }
        });
      });
    }

    // Filter logic
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        filterButtons.forEach((b) => {
          b.classList.remove('bg-slate-800', 'text-white');
          b.classList.add('bg-slate-900', 'text-slate-400');
        });
        btn.classList.add('bg-slate-800', 'text-white');
        btn.classList.remove('bg-slate-900', 'text-slate-400');

        document.querySelectorAll('.media-item').forEach((item) => {
          const type = item.getAttribute('data-type');
          const cat = item.getAttribute('data-category');
          if (filter === 'all' || type === filter || cat === filter) {
            (item as HTMLElement).style.display = 'flex';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    attachListeners();
  </script>
</AdminLayout>
