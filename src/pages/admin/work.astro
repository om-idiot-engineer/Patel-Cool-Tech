---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Work Portfolio Manager" activeTab="work">
  <!-- Top bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 sm:pb-6 border-b border-slate-800">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-ice">Homepage Showcase &amp; Portfolio</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-0.5">Work Projects &amp; Photos</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Website ke homepage par chalne wale photos aur video reels ko yahan se manage karein.
      </p>
    </div>

    <!-- ONE Single, Big, Clear Button to Add New Project -->
    <div>
      <button
        type="button"
        id="open-add-modal-btn"
        class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-brand-ice hover:bg-brand-ice-hover text-white font-extrabold text-sm sm:text-base shadow-xl shadow-brand-ice/25 transition-all active:scale-[0.98] min-h-[48px] w-full sm:w-auto cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>+ Naya Photo / Project Dalein</span>
      </button>
    </div>
  </div>

  <!-- Easy Help Banner for Owner -->
  <div class="my-4 sm:my-5 p-4 rounded-2xl bg-sky-950/40 border border-sky-800/60 flex items-start sm:items-center gap-3.5 text-sky-200 shadow-sm">
    <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-300 flex items-center justify-center flex-shrink-0 text-lg">
      💡
    </div>
    <div class="text-xs sm:text-sm leading-relaxed">
      <span class="font-bold text-white">Photo ya Details Kaise Badlein:</span>
      <span class="text-sky-200"> Kisi bhi photo par click karein ya uske neeche diye gaye <strong class="text-white underline decoration-sky-400">"✏️ Badlein (Edit)"</strong> button ko dabayein. Nayi photo upload karein aur <strong class="text-white">Save</strong> kar dein!</span>
    </div>
  </div>

  <!-- Row Filter Tabs / Section Switcher -->
  <div class="mt-4 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
    <button
      type="button"
      id="tab-filter-all"
      class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-brand-ice text-white shadow-sm"
      data-filter="all"
    >
      Sabhi Photos (<span id="count-all">0</span>)
    </button>
    <button
      type="button"
      id="tab-filter-top"
      class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700"
      data-filter="top"
    >
      ⬆️ Upar Wali Line (Row 1) &bull; <span id="count-top">0</span>
    </button>
    <button
      type="button"
      id="tab-filter-bottom"
      class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700"
      data-filter="bottom"
    >
      ⬇️ Niche Wali Line (Row 2) &bull; <span id="count-bottom">0</span>
    </button>
  </div>

  <!-- Mobile Floating Action Button (FAB) for quick add on the move -->
  <button
    type="button"
    id="mobile-fab-add-btn"
    class="fixed bottom-20 right-4 z-30 md:hidden w-14 h-14 rounded-full bg-brand-ice hover:bg-brand-ice-hover text-white shadow-2xl shadow-brand-ice/40 flex items-center justify-center active:scale-90 transition-all cursor-pointer border border-white/20"
    aria-label="Add New Work Project"
  >
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
    </svg>
  </button>

  <!-- Notification Toast -->
  <div id="toast" class="hidden fixed bottom-20 sm:bottom-6 right-4 sm:right-6 z-50 px-5 py-3.5 rounded-xl bg-emerald-900 border border-emerald-700 text-white text-sm font-semibold shadow-2xl flex items-center gap-3 transition-opacity duration-300">
    <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toast-message">Action completed successfully.</span>
  </div>

  <!-- Work Items Container -->
  <div class="mt-6 sm:mt-8 space-y-10" id="work-sections-root">
    <!-- Top Line Section -->
    <div id="section-top-line" class="space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
          <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <span>⬆️ Upar Wali Line (Row 1)</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-sky-950 text-sky-300 border border-sky-800/60">
              Left flow &bull; <span id="section-top-count">0</span> photos
            </span>
          </h2>
        </div>
        <button
          type="button"
          class="add-row-shortcut-btn text-xs font-bold text-brand-ice hover:text-white px-3 py-1.5 rounded-lg hover:bg-slate-800 transition-colors cursor-pointer"
          data-row="top"
        >
          + Is Line me dalein
        </button>
      </div>
      <div id="top-items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <!-- Populated via script -->
      </div>
    </div>

    <!-- Bottom Line Section -->
    <div id="section-bottom-line" class="space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 animate-pulse"></span>
          <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <span>⬇️ Niche Wali Line (Row 2)</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-indigo-950 text-indigo-300 border border-indigo-800/60">
              Right flow &bull; <span id="section-bottom-count">0</span> photos
            </span>
          </h2>
        </div>
        <button
          type="button"
          class="add-row-shortcut-btn text-xs font-bold text-indigo-400 hover:text-white px-3 py-1.5 rounded-lg hover:bg-slate-800 transition-colors cursor-pointer"
          data-row="bottom"
        >
          + Is Line me dalein
        </button>
      </div>
      <div id="bottom-items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <!-- Populated via script -->
      </div>
    </div>
  </div>

  <!-- ADD / EDIT WORK MODAL (Mobile Bottom-Sheet on Phones, Centered Dialog on Desktop) -->
  <div
    id="work-modal"
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 flex items-end sm:items-center justify-center p-0 sm:p-4"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div
      class="relative w-full max-w-2xl max-h-[92vh] sm:max-h-[90vh] bg-slate-900 border-t sm:border border-slate-800 rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col transform translate-y-full sm:translate-y-0 sm:scale-95 transition-transform duration-300"
      id="work-modal-card"
    >
      <!-- Mobile Pull Indicator Handle -->
      <div class="pt-2.5 pb-1 sm:hidden flex justify-center bg-slate-950">
        <div class="w-12 h-1.5 rounded-full bg-slate-700"></div>
      </div>

      <!-- Header -->
      <div class="px-5 py-4 sm:p-6 bg-slate-950 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 id="modal-title" class="text-lg sm:text-xl font-bold text-white">Photo ya Details Badlein</h2>
          <p id="modal-subtitle" class="text-xs text-slate-400 mt-0.5">Nayi photo upload karein ya title badal kar Save karein</p>
        </div>
        <button
          type="button"
          id="close-modal-btn"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form Body (Scrollable with mobile-safe padding) -->
      <form id="work-form" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-grow text-sm">
        <input type="hidden" id="form-work-id" value="" />

        <!-- 1. PHOTO UPLOAD & PREVIEW SECTION (MOST PROMINENT) -->
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800">
          <label class="block text-xs font-bold uppercase tracking-wider text-brand-ice mb-2.5">
            1. Photo / Video * <span class="text-slate-400 normal-case font-normal">(Ye photo website par dikhegi)</span>
          </label>

          <!-- Current Photo Preview -->
          <div id="modal-image-preview-container" class="hidden mb-3">
            <div class="relative max-w-xs mx-auto aspect-[4/3] rounded-xl overflow-hidden border border-slate-700 bg-slate-900 shadow-md">
              <img id="modal-image-preview" src="" alt="Selected work photo preview" class="w-full h-full object-cover" />
              <div class="absolute bottom-2 left-2 right-2 bg-slate-950/85 backdrop-blur-sm rounded-lg px-2.5 py-1 text-[11px] font-semibold text-emerald-300 flex items-center justify-center gap-1.5 border border-emerald-500/20">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
                <span>Current Photo (Chuni hui photo)</span>
              </div>
            </div>
          </div>

          <!-- File Upload Trigger Box -->
          <input type="file" id="media-file-input" accept="image/*,video/mp4,video/webm" class="hidden" />
          <div id="upload-idle-state" class="cursor-pointer border-2 border-dashed border-brand-ice/40 hover:border-brand-ice active:border-brand-ice bg-brand-navy/20 hover:bg-brand-navy/30 rounded-2xl p-4 sm:p-5 text-center transition-all">
            <div class="w-12 h-12 rounded-full bg-brand-ice/20 text-brand-ice mx-auto flex items-center justify-center mb-2">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <p id="upload-btn-text" class="text-sm font-bold text-white">📷 Nayi Photo Chunein ya Camera se lein</p>
            <p class="text-[11px] text-slate-400 mt-1">Yahan tap karke phone camera ya gallery se photo chunein</p>
          </div>

          <!-- Upload In-Progress State -->
          <div id="upload-progress-state" class="hidden text-center py-4 bg-slate-900/60 rounded-2xl border border-brand-ice/30">
            <div class="inline-block animate-spin w-6 h-6 border-2 border-brand-ice border-t-transparent rounded-full mb-2"></div>
            <p class="text-xs text-brand-ice-light font-bold" id="upload-status-text">Photo upload ho rahi hai... Kripya rukein</p>
          </div>

          <!-- Advanced Direct URL field (hidden inside details to keep UI super simple) -->
          <details class="mt-2 text-xs text-slate-500">
            <summary class="cursor-pointer hover:text-slate-400 pt-1">Advanced: Direct image URL (optional)</summary>
            <div class="mt-2">
              <input
                type="text"
                id="work-image-url"
                required
                placeholder="https://... storage image URL"
                class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-white placeholder-slate-500 text-xs"
              />
            </div>
          </details>
        </div>

        <!-- 2. Line Placement Selector (Top Line vs Bottom Line) -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-950 border border-slate-800">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
            2. Website par kahan chalegi:
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="work-row-position" value="top" id="radio-row-top" class="hidden peer" checked />
              <div class="p-3 rounded-xl border border-slate-700 bg-slate-900/60 peer-checked:border-brand-ice peer-checked:bg-brand-ice/15 peer-checked:text-brand-ice text-slate-300 transition-all text-center">
                <div class="text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5">
                  <span>⬆️ Upar Wali Line</span>
                </div>
                <p class="text-[10px] text-slate-400 mt-0.5">Row 1 (Left flow)</p>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="work-row-position" value="bottom" id="radio-row-bottom" class="hidden peer" />
              <div class="p-3 rounded-xl border border-slate-700 bg-slate-900/60 peer-checked:border-indigo-400 peer-checked:bg-indigo-500/15 peer-checked:text-indigo-300 text-slate-300 transition-all text-center">
                <div class="text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5">
                  <span>⬇️ Niche Wali Line</span>
                </div>
                <p class="text-[10px] text-slate-400 mt-0.5">Row 2 (Right flow)</p>
              </div>
            </label>
          </div>
        </div>

        <div>
          <label for="work-title" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            3. Project Ka Naam (Title) *
          </label>
          <input
            type="text"
            id="work-title"
            required
            placeholder="e.g. Split AC Installation Rau Indore"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label for="work-category" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
              4. Category *
            </label>
            <select
              id="work-category"
              required
              class="w-full px-3 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
            >
              <option value="Installation">Installation (Fitting)</option>
              <option value="Repair">Repair</option>
              <option value="AC Service">AC Service (Jet Pump)</option>
              <option value="Gas Refilling">Gas Refilling</option>
              <option value="Maintenance / AMC">Maintenance / AMC</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div>
            <label for="work-media-type" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
              Media Type
            </label>
            <select
              id="work-media-type"
              required
              class="w-full px-3 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
            >
              <option value="image">Photo (Photograph)</option>
              <option value="video">Video Clip / Reel</option>
            </select>
          </div>
        </div>

        <div id="video-url-container" class="hidden">
          <label for="work-video-url" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Video Clip URL (MP4 / WebM)
          </label>
          <input
            type="text"
            id="work-video-url"
            placeholder="https://.../video.mp4"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice text-base sm:text-sm min-h-[48px]"
          />
        </div>

        <div>
          <label for="work-description" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
            Chhota Vivaran (Description - Optional)
          </label>
          <textarea
            id="work-description"
            rows="2"
            placeholder="Kaam ke baare me 1 line (e.g. Copper piping installation with bracket fitting)"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-brand-ice text-base sm:text-sm"
          ></textarea>
        </div>

        <div class="hidden">
          <input type="number" id="work-sort" value="1" />
          <input type="checkbox" id="work-published" checked />
          <input type="checkbox" id="work-featured" checked />
        </div>

        <!-- Sticky Form Footer -->
        <div class="pt-4 pb-2 border-t border-slate-800 flex items-center justify-end gap-3 sticky bottom-0 bg-slate-900">
          <button
            type="button"
            id="cancel-modal-btn"
            class="px-5 py-3 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 active:bg-slate-800 transition-colors min-h-[48px]"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="save-work-btn"
            class="px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-extrabold shadow-lg shadow-emerald-900/40 transition-all active:scale-[0.98] min-h-[48px] cursor-pointer flex-grow sm:flex-grow-0 flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            <span>✓ Save Karein (Update Website)</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- DELETE CONFIRMATION DIALOG -->
  <div
    id="delete-modal"
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div class="w-full max-w-sm bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl text-center">
      <div class="w-12 h-12 rounded-full bg-rose-500/20 text-rose-400 mx-auto flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Kya aap ye photo delete karna chahte hain?</h3>
      <p class="text-xs text-slate-400 mt-2">
        Ye photo website se hat jayegi. Is action ko wapas nahi laya ja sakta.
      </p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <button
          type="button"
          id="cancel-delete-btn"
          class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer min-h-[42px]"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-delete-btn"
          class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow-md transition-all active:scale-[0.98] cursor-pointer min-h-[42px]"
        >
          Delete Karein
        </button>
      </div>
    </div>
  </div>

  <script>
    import { supabase, isSupabaseConfigured, defaultFallbackWork } from '../../utils/supabase';
    import type { WorkItemDB } from '../../types/database';
    import { broadcastWorkItemsUpdate } from '../../utils/liveSync';

    let localWorkItems: WorkItemDB[] = [...defaultFallbackWork];
    let deleteTargetId: string | null = null;
    let activeFilter: 'all' | 'top' | 'bottom' = 'all';

    const topGrid = document.getElementById('top-items-grid');
    const bottomGrid = document.getElementById('bottom-items-grid');
    const sectionTop = document.getElementById('section-top-line');
    const sectionBottom = document.getElementById('section-bottom-line');

    const modal = document.getElementById('work-modal');
    const modalCard = document.getElementById('work-modal-card');
    const openAddBtn = document.getElementById('open-add-modal-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const cancelModalBtn = document.getElementById('cancel-modal-btn');
    const form = document.getElementById('work-form') as HTMLFormElement | null;
    const mediaTypeSelect = document.getElementById('work-media-type') as HTMLSelectElement | null;
    const videoUrlContainer = document.getElementById('video-url-container');
    const fileInput = document.getElementById('media-file-input') as HTMLInputElement | null;
    const uploadIdleState = document.getElementById('upload-idle-state');
    const uploadProgressState = document.getElementById('upload-progress-state');
    const imageUrlInput = document.getElementById('work-image-url') as HTMLInputElement | null;
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-message');

    // Delete modal elements
    const deleteModal = document.getElementById('delete-modal');
    const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
    const confirmDeleteBtn = document.getElementById('confirm-delete-btn');

    function showToast(msg: string) {
      if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.classList.remove('hidden');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 3500);
      }
    }

    async function loadItems() {
      if (isSupabaseConfigured && supabase) {
        const { data, error } = await supabase
          .from('work_items')
          .select('*')
          .order('sort_order', { ascending: true });
        if (!error && data && data.length > 0) {
          localWorkItems = data as WorkItemDB[];
          broadcastWorkItemsUpdate(localWorkItems);
        }
      }
      renderCards();
    }

    function createCardHTML(item: WorkItemDB) {
      const isTop = item.row_position !== 'bottom';
      const isVideo = item.media_type === 'video' || Boolean(item.video_url) || (Boolean(item.image_url) && /\.(mp4|webm|mov)$/i.test(item.image_url));
      const videoSrc = item.video_url || (isVideo ? item.image_url : '');

      return `
        <article class="bg-slate-900 border border-slate-800 hover:border-brand-ice/60 rounded-2xl overflow-hidden flex flex-col justify-between group shadow-md transition-all hover:shadow-xl hover:shadow-brand-ice/10">
          <!-- Clickable Image with direct Edit trigger -->
          <div class="relative w-full aspect-[4/3] bg-slate-950 overflow-hidden cursor-pointer edit-card-trigger" data-id="${item.id}" title="Click to change or edit this photo">
            ${isVideo ? `
              <video
                src="${videoSrc}#t=0.001"
                muted
                playsinline
                preload="metadata"
                class="w-full h-full object-cover pointer-events-none"
              ></video>
            ` : `
              <img
                src="${item.thumbnail_url || item.image_url}"
                alt="${item.title}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            `}
            <!-- Top Badges -->
            <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-slate-950/90 text-white backdrop-blur-sm border border-white/10">
                ${item.category}
              </span>
              ${isVideo ? `
                <span class="px-1.5 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-red-600/95 text-white flex items-center gap-1 shadow-xs">
                  Reel
                </span>
              ` : ''}
            </div>

            <!-- Row Badge -->
            <span class="absolute bottom-2.5 left-2.5 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wider ${isTop ? 'bg-sky-950/90 text-sky-300 border border-sky-700/70' : 'bg-indigo-950/90 text-indigo-300 border border-indigo-700/70'} backdrop-blur-md shadow-xs flex items-center gap-1">
              ${isTop ? '⬆️ Row 1 (Upar)' : '⬇️ Row 2 (Niche)'}
            </span>

            <!-- Status Badge -->
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded text-[10px] font-semibold ${item.published ? 'bg-emerald-950/90 text-emerald-300 border border-emerald-700/60' : 'bg-amber-950/90 text-amber-300 border border-amber-700/60'}">
              ${item.published ? 'Live' : 'Draft'}
            </span>

            <!-- Hover / Tap Prompt overlay -->
            <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
              <span class="px-3.5 py-2 rounded-xl bg-brand-ice text-white font-extrabold text-xs shadow-xl flex items-center gap-1.5 transform scale-95 group-hover:scale-100 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                <span>Photo Badlein (Edit)</span>
              </span>
            </div>
          </div>

          <div class="p-4 flex flex-col flex-grow justify-between">
            <div>
              <h3 class="text-sm sm:text-base font-bold text-white mb-1 line-clamp-1">${item.title}</h3>
              <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">${item.description || 'Patel Cool Tech installation / service'}</p>
            </div>

            <!-- Big, High-Contrast Action Buttons -->
            <div class="mt-4 pt-3 border-t border-slate-800 space-y-2">
              <div class="flex items-center gap-2">
                <!-- Obvious Primary Edit Button -->
                <button
                  type="button"
                  class="edit-btn flex-grow py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold bg-brand-ice hover:bg-brand-ice-hover active:bg-brand-ice-dark text-white shadow-md shadow-brand-ice/20 transition-all cursor-pointer min-h-[42px] flex items-center justify-center gap-2"
                  data-id="${item.id}"
                >
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                  <span>Badlein (Edit Photo)</span>
                </button>

                <!-- Delete Button -->
                <button
                  type="button"
                  class="delete-btn px-3 py-2.5 rounded-xl text-xs font-bold text-rose-400 hover:text-white bg-rose-950/40 hover:bg-rose-900 border border-rose-800/50 transition-colors cursor-pointer min-h-[42px] flex items-center justify-center gap-1"
                  data-id="${item.id}"
                  title="Photo Delete Karein"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>

              <!-- Quick Switch Row Button -->
              <button
                type="button"
                class="switch-row-btn w-full py-1.5 px-2.5 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-white bg-slate-950/80 hover:bg-slate-800 border border-slate-800 transition-colors cursor-pointer flex items-center justify-center gap-1.5"
                data-id="${item.id}"
                data-target-row="${isTop ? 'bottom' : 'top'}"
                title="Switch between Row 1 and Row 2"
              >
                <span>${isTop ? '⬇️ Niche Wali Line (Row 2) me bhejein' : '⬆️ Upar Wali Line (Row 1) me bhejein'}</span>
              </button>
            </div>
          </div>
        </article>
      `;
    }

    function renderCards() {
      if (!topGrid || !bottomGrid) return;

      const topItems = localWorkItems.filter((i) => i.row_position !== 'bottom');
      const bottomItems = localWorkItems.filter((i) => i.row_position === 'bottom');

      // Update counters
      const countAll = document.getElementById('count-all');
      const countTop = document.getElementById('count-top');
      const countBottom = document.getElementById('count-bottom');
      const secTopCount = document.getElementById('section-top-count');
      const secBottomCount = document.getElementById('section-bottom-count');

      if (countAll) countAll.textContent = String(localWorkItems.length);
      if (countTop) countTop.textContent = String(topItems.length);
      if (countBottom) countBottom.textContent = String(bottomItems.length);
      if (secTopCount) secTopCount.textContent = String(topItems.length);
      if (secBottomCount) secBottomCount.textContent = String(bottomItems.length);

      // Section visibility based on filter tab
      if (sectionTop && sectionBottom) {
        if (activeFilter === 'top') {
          sectionTop.classList.remove('hidden');
          sectionBottom.classList.add('hidden');
        } else if (activeFilter === 'bottom') {
          sectionTop.classList.add('hidden');
          sectionBottom.classList.remove('hidden');
        } else {
          sectionTop.classList.remove('hidden');
          sectionBottom.classList.remove('hidden');
        }
      }

      // Render Top Items
      if (topItems.length === 0) {
        topGrid.innerHTML = `
          <div class="col-span-full py-8 text-center text-slate-500 bg-slate-900/40 rounded-2xl border border-dashed border-slate-800">
            <p class="text-sm font-bold text-slate-400">Upar wali line me abhi koi photo nahi hai</p>
            <button type="button" class="add-row-shortcut-btn mt-2 inline-flex items-center gap-1 text-xs text-brand-ice font-bold px-4 py-2 rounded-xl bg-brand-navy border border-brand-ice/40" data-row="top">
              + Upar Wali Line me Pehla Photo Dalein
            </button>
          </div>
        `;
      } else {
        topGrid.innerHTML = topItems.map(createCardHTML).join('');
      }

      // Render Bottom Items
      if (bottomItems.length === 0) {
        bottomGrid.innerHTML = `
          <div class="col-span-full py-8 text-center text-slate-500 bg-slate-900/40 rounded-2xl border border-dashed border-slate-800">
            <p class="text-sm font-bold text-slate-400">Niche wali line me abhi koi photo nahi hai</p>
            <button type="button" class="add-row-shortcut-btn mt-2 inline-flex items-center gap-1 text-xs text-indigo-300 font-bold px-4 py-2 rounded-xl bg-brand-navy border border-indigo-400/40" data-row="bottom">
              + Niche Wali Line me Pehla Photo Dalein
            </button>
          </div>
        `;
      } else {
        bottomGrid.innerHTML = bottomItems.map(createCardHTML).join('');
      }

      // Attach handlers
      attachCardListeners();
    }

    function attachCardListeners() {
      // Edit button handler
      document.querySelectorAll('.edit-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const item = localWorkItems.find((i) => i.id === id);
          if (item) openModal(item);
        });
      });

      // Also whole image area clicks trigger edit
      document.querySelectorAll('.edit-card-trigger').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const id = trigger.getAttribute('data-id');
          const item = localWorkItems.find((i) => i.id === id);
          if (item) openModal(item);
        });
      });

      // Delete button handler
      document.querySelectorAll('.delete-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          if (id) openDeleteDialog(id);
        });
      });

      // Quick Move between Top Line & Bottom Line
      document.querySelectorAll('.switch-row-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const targetRow = btn.getAttribute('data-target-row') as 'top' | 'bottom';
          if (!id || !targetRow) return;

          if (isSupabaseConfigured && supabase) {
            await supabase.from('work_items').update({ row_position: targetRow }).eq('id', id);
          }
          const item = localWorkItems.find((i) => i.id === id);
          if (item) item.row_position = targetRow;
          broadcastWorkItemsUpdate(localWorkItems);

          showToast(`Photo ${targetRow === 'top' ? 'Upar Wali Line (Row 1)' : 'Niche Wali Line (Row 2)'} me move ho gayi.`);
          renderCards();
        });
      });

      // Shortcut add buttons
      document.querySelectorAll('.add-row-shortcut-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const row = (btn.getAttribute('data-row') as 'top' | 'bottom') || 'top';
          openModal(undefined, row);
        });
      });
    }

    function openModal(item?: WorkItemDB, defaultRow: 'top' | 'bottom' = 'top') {
      if (!modal || !modalCard) return;
      const modalTitle = document.getElementById('modal-title');
      const modalSubtitle = document.getElementById('modal-subtitle');
      const formId = document.getElementById('form-work-id') as HTMLInputElement | null;
      const titleInput = document.getElementById('work-title') as HTMLInputElement | null;
      const catSelect = document.getElementById('work-category') as HTMLSelectElement | null;
      const mediaSelect = document.getElementById('work-media-type') as HTMLSelectElement | null;
      const descInput = document.getElementById('work-description') as HTMLTextAreaElement | null;
      const sortInput = document.getElementById('work-sort') as HTMLInputElement | null;
      const pubCheckbox = document.getElementById('work-published') as HTMLInputElement | null;
      const featCheckbox = document.getElementById('work-featured') as HTMLInputElement | null;
      const videoInput = document.getElementById('work-video-url') as HTMLInputElement | null;

      const radioTop = document.getElementById('radio-row-top') as HTMLInputElement | null;
      const radioBottom = document.getElementById('radio-row-bottom') as HTMLInputElement | null;

      const previewContainer = document.getElementById('modal-image-preview-container');
      const previewImg = document.getElementById('modal-image-preview') as HTMLImageElement | null;
      const uploadBtnText = document.getElementById('upload-btn-text');

      if (item) {
        if (modalTitle) modalTitle.textContent = '✏️ Photo ya Details Badlein (Edit)';
        if (modalSubtitle) modalSubtitle.textContent = 'Nayi photo upload karein ya title/category badal kar Save karein';
        if (formId) formId.value = item.id;
        if (titleInput) titleInput.value = item.title;
        if (catSelect) catSelect.value = item.category;
        if (mediaSelect) mediaSelect.value = item.media_type;
        if (imageUrlInput) imageUrlInput.value = item.image_url;
        if (videoInput) videoInput.value = item.video_url || '';
        if (descInput) descInput.value = item.description || '';
        if (sortInput) sortInput.value = String(item.sort_order || 1);
        if (pubCheckbox) pubCheckbox.checked = item.published;
        if (featCheckbox) featCheckbox.checked = item.featured;

        if (item.row_position === 'bottom') {
          if (radioBottom) radioBottom.checked = true;
        } else {
          if (radioTop) radioTop.checked = true;
        }

        // Show existing image preview
        if (previewContainer && previewImg && item.image_url) {
          previewImg.src = item.image_url;
          previewContainer.classList.remove('hidden');
        }
        if (uploadBtnText) uploadBtnText.textContent = '📷 Doosri Photo Lagayein (Change Photo)';
      } else {
        if (modalTitle) modalTitle.textContent = defaultRow === 'top' ? '➕ Upar Wali Line me Naya Project Dalein' : '➕ Niche Wali Line me Naya Project Dalein';
        if (modalSubtitle) modalSubtitle.textContent = 'Phone se photo lein ya gallery se chunein';
        form?.reset();
        if (formId) formId.value = '';
        if (imageUrlInput) imageUrlInput.value = '';
        if (defaultRow === 'bottom') {
          if (radioBottom) radioBottom.checked = true;
        } else {
          if (radioTop) radioTop.checked = true;
        }

        if (previewContainer) previewContainer.classList.add('hidden');
        if (previewImg) previewImg.src = '';
        if (uploadBtnText) uploadBtnText.textContent = '📷 Photo Chunein ya Camera se lein';
      }

      // Toggle video container
      if (mediaSelect?.value === 'video') {
        videoUrlContainer?.classList.remove('hidden');
      } else {
        videoUrlContainer?.classList.add('hidden');
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modal.setAttribute('aria-hidden', 'false');
      modalCard.classList.remove('translate-y-full', 'sm:scale-95');
      modalCard.classList.add('translate-y-0', 'sm:scale-100');
    }

    function closeModal() {
      if (!modal || !modalCard) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.setAttribute('aria-hidden', 'true');
      modalCard.classList.add('translate-y-full', 'sm:scale-95');
      modalCard.classList.remove('translate-y-0', 'sm:scale-100');
    }

    function openDeleteDialog(id: string) {
      deleteTargetId = id;
      if (!deleteModal) return;
      deleteModal.classList.remove('opacity-0', 'pointer-events-none');
      deleteModal.classList.add('opacity-100', 'pointer-events-auto');
      deleteModal.setAttribute('aria-hidden', 'false');
    }

    function closeDeleteDialog() {
      deleteTargetId = null;
      if (!deleteModal) return;
      deleteModal.classList.add('opacity-0', 'pointer-events-none');
      deleteModal.classList.remove('opacity-100', 'pointer-events-auto');
      deleteModal.setAttribute('aria-hidden', 'true');
    }

    // Toggle video url field when media type changes
    mediaTypeSelect?.addEventListener('change', () => {
      if (mediaTypeSelect.value === 'video') {
        videoUrlContainer?.classList.remove('hidden');
      } else {
        videoUrlContainer?.classList.add('hidden');
      }
    });

    uploadIdleState?.addEventListener('click', () => {
      fileInput?.click();
    });

    // Handle File Upload to Supabase Storage
    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      uploadIdleState?.classList.add('hidden');
      uploadProgressState?.classList.remove('hidden');

      const previewContainer = document.getElementById('modal-image-preview-container');
      const previewImg = document.getElementById('modal-image-preview') as HTMLImageElement | null;
      const uploadBtnText = document.getElementById('upload-btn-text');

      if (isSupabaseConfigured && supabase) {
        try {
          const fileExt = file.name.split('.').pop();
          const fileName = `${Date.now()}-${Math.random().toString(36).substring(7)}.${fileExt}`;
          const filePath = `work/${fileName}`;

          const { error: uploadError } = await supabase.storage
            .from('work-media')
            .upload(filePath, file);

          if (uploadError) throw uploadError;

          const { data: { publicUrl } } = supabase.storage
            .from('work-media')
            .getPublicUrl(filePath);

          if (imageUrlInput) imageUrlInput.value = publicUrl;
          if (previewContainer && previewImg) {
            previewImg.src = publicUrl;
            previewContainer.classList.remove('hidden');
          }
          if (uploadBtnText) uploadBtnText.textContent = '📷 Doosri Photo Chunein (Change)';

          if (file.type.startsWith('video') || /\.(mp4|webm|mov)$/i.test(file.name)) {
            const videoInput = document.getElementById('work-video-url') as HTMLInputElement | null;
            if (videoInput) videoInput.value = publicUrl;
            if (mediaTypeSelect) mediaTypeSelect.value = 'video';
            if (videoUrlContainer) videoUrlContainer.classList.remove('hidden');
          }
          showToast('✓ Photo upload ho gayi!');
        } catch (err: any) {
          alert('Upload failed: ' + err.message);
        }
      } else {
        const objectUrl = URL.createObjectURL(file);
        if (imageUrlInput) imageUrlInput.value = objectUrl;
        if (previewContainer && previewImg) {
          previewImg.src = objectUrl;
          previewContainer.classList.remove('hidden');
        }
        showToast('Photo selected.');
      }

      uploadIdleState?.classList.remove('hidden');
      uploadProgressState?.classList.add('hidden');
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formId = (document.getElementById('form-work-id') as HTMLInputElement | null)?.value;
      const title = (document.getElementById('work-title') as HTMLInputElement | null)?.value || '';
      const category = (document.getElementById('work-category') as HTMLSelectElement | null)?.value as any;
      const media_type = (document.getElementById('work-media-type') as HTMLSelectElement | null)?.value as any;
      const image_url = (document.getElementById('work-image-url') as HTMLInputElement | null)?.value || '';
      const video_url = (document.getElementById('work-video-url') as HTMLInputElement | null)?.value || null;
      const description = (document.getElementById('work-description') as HTMLTextAreaElement | null)?.value || '';
      const sort_order = Number((document.getElementById('work-sort') as HTMLInputElement | null)?.value || 1);
      const published = (document.getElementById('work-published') as HTMLInputElement | null)?.checked ?? true;
      const featured = (document.getElementById('work-featured') as HTMLInputElement | null)?.checked ?? true;

      if (!image_url) {
        alert('Kripya photo select karein ya URL dalein.');
        return;
      }

      // Check selected row position
      const rowPosition = (document.querySelector('input[name="work-row-position"]:checked') as HTMLInputElement | null)?.value || 'top';

      const itemPayload: Partial<WorkItemDB> = {
        title,
        category,
        media_type,
        image_url,
        video_url,
        thumbnail_url: image_url,
        description,
        sort_order,
        published,
        featured,
        row_position: rowPosition as 'top' | 'bottom',
        updated_at: new Date().toISOString(),
      };

      // Instant optimistic local update
      if (formId) {
        const idx = localWorkItems.findIndex((i) => i.id === formId);
        if (idx >= 0) localWorkItems[idx] = { ...localWorkItems[idx], ...itemPayload } as WorkItemDB;
      } else {
        const tempItem: WorkItemDB = {
          id: `work-temp-${Date.now()}`,
          created_at: new Date().toISOString(),
          ...itemPayload,
        } as WorkItemDB;
        localWorkItems.unshift(tempItem);
      }

      broadcastWorkItemsUpdate(localWorkItems);
      closeModal();
      renderCards();
      showToast('✓ Project successfully save ho gaya!');

      // Persist to Supabase
      if (isSupabaseConfigured && supabase) {
        try {
          if (formId) {
            const { error } = await supabase
              .from('work_items')
              .update(itemPayload)
              .eq('id', formId);
            if (error) throw error;
          } else {
            const { data, error } = await supabase
              .from('work_items')
              .insert([itemPayload])
              .select()
              .single();
            if (error) throw error;
            if (data) {
              const tempIdx = localWorkItems.findIndex((i) => i.id.startsWith('work-temp-'));
              if (tempIdx >= 0) localWorkItems[tempIdx] = data as WorkItemDB;
              broadcastWorkItemsUpdate(localWorkItems);
            }
          }
          await loadItems();
        } catch (err: any) {
          console.error('Work save error:', err);
          showToast('Saved locally. Database sync failed: ' + err.message);
        }
      }
    });

    // Delete confirmation
    confirmDeleteBtn?.addEventListener('click', async () => {
      if (!deleteTargetId) return;
      const targetId = deleteTargetId;

      // Optimistic delete
      localWorkItems = localWorkItems.filter((i) => i.id !== targetId);
      broadcastWorkItemsUpdate(localWorkItems);
      renderCards();

      try {
        if (isSupabaseConfigured && supabase) {
          const { error } = await supabase.from('work_items').delete().eq('id', targetId);
          if (error) throw error;
        }
        closeDeleteDialog();
        showToast('✓ Photo delete ho gayi.');
        await loadItems();
      } catch (err: any) {
        console.error('Work delete error:', err);
        alert('Could not delete item: ' + (err.message || 'Unknown error'));
      }
    });

    cancelDeleteBtn?.addEventListener('click', closeDeleteDialog);
    openAddBtn?.addEventListener('click', () => openModal(undefined, 'top'));

    const mobileFabBtn = document.getElementById('mobile-fab-add-btn');
    mobileFabBtn?.addEventListener('click', () => openModal(undefined, 'top'));
    closeModalBtn?.addEventListener('click', closeModal);
    cancelModalBtn?.addEventListener('click', closeModal);

    // Tab filter buttons
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn.getAttribute('data-filter') as 'all' | 'top' | 'bottom') || 'all';
        activeFilter = filter;

        tabBtns.forEach((b) => {
          b.classList.remove('bg-brand-ice', 'text-white', 'shadow-sm');
          b.classList.add('bg-slate-900', 'border', 'border-slate-800', 'text-slate-300');
        });

        btn.classList.add('bg-brand-ice', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-slate-900', 'border', 'border-slate-800', 'text-slate-300');

        renderCards();
      });
    });

    loadItems();
  </script>
</AdminLayout>
