---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { siteConfig } from '../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact',
      item: `${siteConfig.siteUrl}/contact/`,
    },
  ],
};

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Patel Cool Tech',
  url: `${siteConfig.siteUrl}/contact/`,
  description: 'Contact Patel Cool Tech for prompt on-site AC repair, installation, and servicing in Indore, Rau, and Pithampur. Call 9575664203 or 9425166191, or chat on WhatsApp.',
  mainEntity: {
    '@type': 'HVACBusiness',
    name: business.name,
    telephone: business.phones.primaryFormatted,
    email: business.email,
    url: `${siteConfig.siteUrl}/`,
    hasMap: business.googleBusinessProfile.mapsUrl,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: business.phones.primaryFormatted,
        contactType: 'customer service',
        areaServed: ['Indore', 'Rau', 'Pithampur'],
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: business.phones.secondaryFormatted,
        contactType: 'technical support',
        areaServed: ['Indore', 'Rau', 'Pithampur'],
        availableLanguage: ['Hindi', 'English'],
      },
    ],
  },
};

const preparationTips = [
  {
    step: '1',
    title: 'AC Type & Brand',
    description: 'Mention whether you have a Split AC or Window AC, and the brand (e.g. Voltas, LG, Daikin, Lloyd) if readily known.',
  },
  {
    step: '2',
    title: 'Current Issue or Need',
    description: 'Describe what you observe: no cooling, water dripping indoors, strange noise, circuit tripping, or routine seasonal jet cleaning.',
  },
  {
    step: '3',
    title: 'Your Location Area',
    description: 'Tell us your colony or neighborhood in Indore, Rau, or Pithampur so we can estimate travel and schedule the visit promptly.',
  },
];
---

<BaseLayout
  title="Contact Patel Cool Tech | AC Service in Indore"
  description="Contact Patel Cool Tech for prompt on-site AC repair, installation, and servicing in Indore, Rau, and Pithampur. Call 9575664203 or 9425166191, or chat on WhatsApp."
  canonicalUrl={`${siteConfig.siteUrl}/contact/`}
  additionalSchema={[breadcrumbSchema, contactPageSchema]}
>
  <!-- Hero & Primary Direct CTAs Section -->
  <section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-8 sm:pb-16 border-b border-brand-border overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="contact-hero-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0B1F3A" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#contact-hero-pattern)" />
      </svg>
    </div>

    <Container class="relative z-10">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-5 sm:mb-6" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-brand-text-subtle">
          <li>
            <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
          </li>
          <li class="select-none" aria-hidden="true">&rsaquo;</li>
          <li class="font-semibold text-brand-navy" aria-current="page">Contact</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-surface-alt text-brand-navy border border-brand-border mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span class="tracking-wide uppercase text-[11px] font-bold">DIRECT ON-SITE TECHNICIANS</span>
        </div>

        <h1 class="text-2xl xs:text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight text-brand-navy leading-[1.18] sm:leading-[1.15]">
          Contact Patel Cool Tech
        </h1>

        <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed">
          Need AC service or repair in Indore? Speak directly with technicians Mahendra Patel and Satyam Patel. Call or WhatsApp us to describe your issue and book an on-site visit.
        </p>

        <!-- Primary High-Conversion Action Grid -->
        <div class="mt-6 sm:mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3.5 max-w-xl">
          <a
            href={business.phones.primaryTel}
            class="flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl bg-brand-navy hover:bg-brand-navy-light text-white font-bold text-base shadow-card hover:shadow-hover transition-all duration-150 min-h-[52px] active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-brand-navy"
            aria-label={`Call primary phone ${business.phones.primaryFormatted}`}
          >
            <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div class="flex flex-col text-left">
              <span class="text-xs text-brand-ice font-normal leading-tight">Call Primary</span>
              <span class="font-bold tracking-tight">{business.phones.primaryFormatted}</span>
            </div>
          </a>

          <a
            href={business.phones.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsapp-hover text-white font-bold text-base shadow-card hover:shadow-hover transition-all duration-150 min-h-[52px] active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-brand-whatsapp"
            aria-label="Chat with Patel Cool Tech on WhatsApp (opens in new tab)"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
            </svg>
            <div class="flex flex-col text-left">
              <span class="text-xs text-emerald-100 font-normal leading-tight">Fast Response</span>
              <span class="font-bold tracking-tight">Chat on WhatsApp</span>
            </div>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Complete Contact Details Strip (NAP) -->
  <section class="py-12 sm:py-16 bg-white border-b border-brand-border">
    <Container>
      <div class="mb-8 sm:mb-10 max-w-2xl">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-navy">
          Direct Contact Information
        </h2>
        <p class="text-sm text-brand-text-muted mt-1">
          Reach out through any of our verified communication channels.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Phone 1 (Primary) -->
        <div class="p-6 bg-brand-surface rounded-2xl border border-brand-border shadow-soft flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-blue-light text-brand-blue flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue block mb-1">
              Primary Phone &amp; WhatsApp
            </span>
            <h3 class="text-lg font-bold text-brand-navy mb-1">
              {business.phones.primaryFormatted}
            </h3>
            <p class="text-xs text-brand-text-muted leading-relaxed">
              Direct line for bookings, service scheduling, and emergency AC faults.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-brand-border/60">
            <a
              href={business.phones.primaryTel}
              class="inline-flex items-center text-xs font-bold text-brand-blue hover:text-brand-ice transition-colors min-h-[44px] py-1"
              aria-label={`Call primary phone ${business.phones.primaryFormatted}`}
            >
              <span>Call Primary Line &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Phone 2 (Secondary) -->
        <div class="p-6 bg-brand-surface rounded-2xl border border-brand-border shadow-soft flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-blue-light text-brand-blue flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue block mb-1">
              Secondary Direct Line
            </span>
            <h3 class="text-lg font-bold text-brand-navy mb-1">
              {business.phones.secondaryFormatted}
            </h3>
            <p class="text-xs text-brand-text-muted leading-relaxed">
              Alternative technician contact number if the primary line is on-site or busy.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-brand-border/60">
            <a
              href={business.phones.secondaryTel}
              class="inline-flex items-center text-xs font-bold text-brand-blue hover:text-brand-ice transition-colors min-h-[44px] py-1"
              aria-label={`Call secondary phone ${business.phones.secondaryFormatted}`}
            >
              <span>Call Secondary Line &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Email -->
        <div class="p-6 bg-brand-surface rounded-2xl border border-brand-border shadow-soft flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-blue-light text-brand-blue flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue block mb-1">
              Email Correspondence
            </span>
            <h3 class="text-base font-bold text-brand-navy mb-1 break-all">
              {business.email}
            </h3>
            <p class="text-xs text-brand-text-muted leading-relaxed">
              For corporate AMC inquiries, commercial quotations, and formal communication.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-brand-border/60">
            <a
              href={`mailto:${business.email}`}
              class="inline-flex items-center text-xs font-bold text-brand-blue hover:text-brand-ice transition-colors min-h-[44px] py-1"
              aria-label={`Send email to ${business.email}`}
            >
              <span>Send Email &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Google Business Profile / Maps -->
        <div class="p-6 bg-brand-surface rounded-2xl border border-brand-border shadow-soft flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 block mb-1">
              Google Maps Listing
            </span>
            <h3 class="text-base font-bold text-brand-navy mb-1">
              Google Business Profile
            </h3>
            <p class="text-xs text-brand-text-muted leading-relaxed">
              Located and serving in Indore, Madhya Pradesh. View our verified listing on Google Maps.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-brand-border/60">
            <a
              href={business.googleBusinessProfile.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-xs font-bold text-emerald-700 hover:text-emerald-800 transition-colors min-h-[44px] py-1"
              aria-label="View Patel Cool Tech on Google Maps (opens in new tab)"
            >
              <span>View us on Google Maps &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Helpful "What to Tell Us" Guidance Section -->
  <section class="py-12 sm:py-16 bg-brand-surface border-b border-brand-border">
    <Container>
      <div class="max-w-3xl mb-8 sm:mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-blue mb-1.5 block">
          Fast Service Tip
        </span>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold text-brand-navy">
          What to Share When You Call or Message
        </h2>
        <p class="text-sm sm:text-base text-brand-text-muted mt-2 leading-relaxed">
          Sharing these 3 quick details helps us diagnose the situation faster and bring the right tools or spare components:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          preparationTips.map((tip) => (
            <div class="p-6 bg-white rounded-2xl border border-brand-border shadow-soft">
              <div class="w-8 h-8 rounded-full bg-brand-navy text-white text-sm font-bold flex items-center justify-center mb-4">
                {tip.step}
              </div>
              <h3 class="text-base font-bold text-brand-navy mb-2">
                {tip.title}
              </h3>
              <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed">
                {tip.description}
              </p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Services We Handle Strip -->
  <section class="py-12 sm:py-16 bg-white border-b border-brand-border">
    <Container>
      <div class="mb-8 max-w-2xl">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-navy">
          Services We Handle
        </h2>
        <p class="text-sm text-brand-text-muted mt-1">
          Explore individual service specifications or request immediate assistance:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          services.map((service) => (
            <a
              href={`/services/${service.slug}/`}
              class="p-4 rounded-xl border border-brand-border bg-brand-surface hover:border-brand-blue hover:bg-white hover:shadow-card transition-all duration-150 flex items-center justify-between group min-h-[48px]"
              aria-label={`View ${service.title} details`}
            >
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
                <span class="text-sm font-bold text-brand-navy group-hover:text-brand-blue transition-colors">
                  {service.title}
                </span>
              </div>
              <svg class="w-4 h-4 text-brand-text-subtle group-hover:text-brand-blue group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))
        }
        <a
          href="/our-work/"
          class="p-4 rounded-xl border border-dashed border-brand-blue/60 bg-brand-blue-light/30 hover:bg-brand-blue-light/60 transition-all duration-150 flex items-center justify-between group min-h-[48px]"
          aria-label="View Our Work gallery"
        >
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-sm font-bold text-brand-navy">
              View Work Capabilities
            </span>
          </div>
          <span class="text-xs font-semibold text-brand-blue">&rarr;</span>
        </a>
      </div>
    </Container>
  </section>

  <!-- Service Areas Section -->
  <ServiceAreas />

  <!-- Final CTA Strip -->
  <section class="py-14 sm:py-18 bg-brand-navy text-white text-center">
    <Container>
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl xs:text-3xl sm:text-4xl font-extrabold text-white mb-4">
          Ready for Quick On-Site AC Assistance?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mb-8 leading-relaxed">
          Call or message us on WhatsApp now. Direct talk with technicians Mahendra Patel &amp; Satyam Patel.
        </p>

        <div class="flex flex-col xs:flex-row items-stretch xs:items-center justify-center gap-3.5 max-w-md mx-auto">
          <Button
            href={business.phones.primaryTel}
            variant="secondary"
            size="lg"
            class="w-full xs:w-auto font-bold justify-center min-h-[48px] px-6 text-base"
            aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call: {business.phones.primaryFormatted}</span>
          </Button>

          <Button
            href={business.phones.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="lg"
            class="w-full xs:w-auto font-bold justify-center min-h-[48px] px-6 text-base"
            aria-label="Chat with Patel Cool Tech on WhatsApp"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
            </svg>
            <span>WhatsApp Us</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
