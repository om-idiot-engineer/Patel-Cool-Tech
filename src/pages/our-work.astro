---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import WorkGallery from '../components/WorkGallery.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import WorkCTA from '../components/WorkCTA.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';
import { siteConfig } from '../data/site';
import { getPublishedWorkItems, defaultFallbackWork } from '../utils/supabase';

const workItems = await getPublishedWorkItems();
const displayItems = workItems.length > 0 ? workItems : defaultFallbackWork;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Our Work',
      item: `${siteConfig.siteUrl}/our-work/`,
    },
  ],
};

const commonWorkCategories = [
  {
    title: 'Split & Window AC Installation',
    slug: 'ac-installation',
    description: 'Wall bracket anchoring, indoor unit level balancing, vibration dampening for outdoor units, and vacuum-tested refrigerant piping.',
    linkText: 'Explore AC Installation',
  },
  {
    title: 'Cooling & Electrical Diagnostics',
    slug: 'ac-repair',
    description: 'Systematic diagnosis of low cooling, compressor starting failure, run capacitor degradation, sensor errors, and circuit breaker trips.',
    linkText: 'Explore AC Repair',
  },
  {
    title: 'Deep Jet-Spray Servicing',
    slug: 'ac-service',
    description: 'High-pressure wash for heavily choked cooling coils, outdoor condenser fin descaling, and condensate water drain pan cleaning.',
    linkText: 'Explore AC Servicing',
  },
  {
    title: 'Refrigerant Leak Checks & Charging',
    slug: 'ac-gas-refilling',
    description: 'Operating pressure verification with manifold gauges, flare joint soap-bubble testing, and refrigerant recharge (R32, R410A, R22).',
    linkText: 'Explore Gas Refilling',
  },
  {
    title: 'Water Leakage Troubleshooting',
    slug: 'ac-repair',
    description: 'Resolving indoor unit water dripping, unblocking choked gravity drain lines, and clearing iced-up evaporator coils.',
    linkText: 'Explore Leakage Repair',
  },
  {
    title: 'Preventive Annual Maintenance (AMC)',
    slug: 'ac-amc',
    description: 'Periodic inspection contracts for residential homes, co-working offices, and commercial establishments across Indore.',
    linkText: 'Explore AMC Contracts',
  },
];
---

<BaseLayout
  title="AC Installation & Repair Work in Indore"
  description="Explore genuine field work photos, installation standards, fault troubleshooting, and deep servicing workflows handled by Patel Cool Tech across Indore and nearby areas."
  canonicalUrl={`${siteConfig.siteUrl}/our-work/`}
  additionalSchema={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-10 sm:pb-16 border-b border-brand-border overflow-hidden">
    <div class="absolute -top-32 right-1/4 w-96 h-96 bg-brand-ice/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <Container class="relative z-10">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-5 sm:mb-6" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-brand-text-subtle">
          <li>
            <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
          </li>
          <li class="select-none" aria-hidden="true">&rsaquo;</li>
          <li class="font-semibold text-brand-navy" aria-current="page">Our Work</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Column: Copy & Actions -->
        <div class="lg:col-span-7 reveal-init">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-white text-brand-navy border border-brand-border shadow-sm mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span class="tracking-wide uppercase text-[11px] font-bold">FIELD WORK GALLERY &bull; INDORE</span>
          </div>

          <h1 class="text-3xl xs:text-4xl sm:text-5xl font-extrabold tracking-tight text-brand-navy leading-tight font-display">
            Air Conditioning Work Portfolio
          </h1>

          <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed">
            Documented field work delivered across Indore, Rau, Pithampur, and neighboring areas. Click any project card below to inspect high-resolution photographs, technical steps, and service specifications.
          </p>

          <!-- Direct Actions -->
          <div class="mt-6 sm:mt-8 flex flex-col xs:flex-row items-stretch xs:items-center gap-3 sm:gap-3.5 max-w-md sm:max-w-none w-full sm:w-auto">
            <Button
              href={business.phones.primaryTel}
              variant="primary"
              size="lg"
              class="flex-1 xs:flex-1 sm:flex-initial w-full xs:w-auto justify-center font-bold px-3.5 xs:px-4 sm:px-6 py-3 sm:py-3.5 min-h-[48px] text-xs xs:text-sm sm:text-base shadow-card hover:shadow-hover whitespace-nowrap"
              aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
            >
              <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="hidden sm:inline whitespace-nowrap">Call: {business.phones.primaryFormatted}</span>
              <span class="sm:hidden whitespace-nowrap">Call Now</span>
            </Button>

            <Button
              href={business.phones.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="whatsapp"
              size="lg"
              class="flex-1 xs:flex-1 sm:flex-initial w-full xs:w-auto justify-center font-bold px-3.5 xs:px-4 sm:px-6 py-3 sm:py-3.5 min-h-[48px] text-xs xs:text-sm sm:text-base shadow-card hover:shadow-hover whitespace-nowrap"
              aria-label="Chat with Patel Cool Tech on WhatsApp"
            >
              <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
              </svg>
              <span class="whitespace-nowrap">WhatsApp Us</span>
            </Button>
          </div>
        </div>

        <!-- Right Column: Desktop Gallery Highlights Card -->
        <div class="hidden lg:flex lg:col-span-5 flex-col">
          <div class="p-6 xl:p-8 rounded-3xl bg-white/95 border border-brand-border/90 shadow-elevated relative overflow-hidden group">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue"></div>
            
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-ice font-display">Field Documentation</span>
              <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200/80 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Verified Work
              </span>
            </div>

            <div class="space-y-3.5 text-sm text-brand-text">
              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xl">📸</span>
                <div>
                  <h4 class="font-bold text-brand-navy">Real On-Site Photography</h4>
                  <p class="text-xs text-brand-text-muted mt-0.5">Direct project logs by Mahendra &amp; Satyam with step-by-step notes.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xl">🎥</span>
                <div>
                  <h4 class="font-bold text-brand-navy">Interactive Video Reels</h4>
                  <p class="text-xs text-brand-text-muted mt-0.5">High-definition jet washing &amp; outdoor unit balancing in action.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xl">🔍</span>
                <div>
                  <h4 class="font-bold text-brand-navy">Fullscreen Lightbox</h4>
                  <p class="text-xs text-brand-text-muted mt-0.5">Click any gallery item below to inspect detailed work specs.</p>
                </div>
              </div>
            </div>

            <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">Updated Weekly</span>
              <span class="font-bold text-brand-navy">Indore Field Ops</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Work Categories & Visual Overview Section with Full Interactive Lightbox -->
  <section class="py-12 sm:py-16 lg:py-20 bg-white border-b border-brand-border">
    <Container>
      <!-- Work Gallery Component with filters and Lightbox -->
      <WorkGallery items={displayItems} columns={3} showFilters={true} />
    </Container>
  </section>

  <!-- What We Commonly Handle Section -->
  <section class="py-14 sm:py-20 bg-brand-surface border-b border-brand-border">
    <Container>
      <div class="max-w-3xl mb-8 sm:mb-10 reveal-init">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-blue mb-1.5 block">
          Practical Field Experience
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-navy">
          What We Commonly Handle On-Site
        </h2>
        <p class="text-sm sm:text-base text-brand-text-muted mt-2 leading-relaxed">
          Air conditioning units face heavy dust accumulation, electrical voltage fluctuations, and high summer heat across Madhya Pradesh. Below are common situations we encounter and resolve:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          commonWorkCategories.map((item, idx) => (
            <div class={`p-6 bg-white rounded-2xl border border-brand-border/90 shadow-soft flex flex-col justify-between card-hover-effect reveal-init stagger-${(idx % 3) + 1}`}>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2.5">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed mb-4">
                  {item.description}
                </p>
              </div>

              <div class="pt-3 border-t border-brand-border/60">
                <a
                  href={`/services/${item.slug}/`}
                  class="inline-flex items-center text-xs font-bold text-brand-blue hover:text-brand-ice transition-colors min-h-[44px] py-1"
                  aria-label={`${item.linkText} dedicated page`}
                >
                  <span>{item.linkText}</span>
                  <span aria-hidden="true" class="ml-1">&rarr;</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Service Area Coverage -->
  <ServiceAreas />

  <!-- Conversion CTA -->
  <WorkCTA
    heading="Ready to Book AC Installation, Repair, or Service?"
    subheading="Contact technicians Mahendra Patel and Satyam Patel directly. We provide honest technical assessments and reliable on-site support in Indore, Rau, and Pithampur."
  />
</BaseLayout>
