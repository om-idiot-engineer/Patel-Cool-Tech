---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import BrandsSection from '../../components/BrandsSection.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/services';
import { business } from '../../data/business';
import { siteConfig } from '../../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: `${siteConfig.siteUrl}/services/`,
    },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Air Conditioning Services by Patel Cool Tech',
  description: 'List of professional air conditioning services in Indore, Rau, and Pithampur.',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.title,
    url: `${siteConfig.siteUrl}/services/${service.slug}/`,
  })),
};
---

<BaseLayout
  title="Air Conditioning Services in Indore"
  description="Professional split and window AC services in Indore, Rau, and Pithampur: installation, repair, deep servicing, gas refilling, and AMC maintenance."
  additionalSchema={[breadcrumbSchema, itemListSchema]}
>
  <!-- Hero / Introduction Section -->
  <section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-8 sm:pb-16 border-b border-brand-border overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="directory-hero-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0B1F3A" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#directory-hero-pattern)" />
      </svg>
    </div>

    <Container class="relative z-10">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-5 sm:mb-6" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-brand-text-subtle">
          <li>
            <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
          </li>
          <li class="select-none" aria-hidden="true">&rsaquo;</li>
          <li class="font-semibold text-brand-navy" aria-current="page">Services</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Column: Directory Copy & CTAs -->
        <div class="lg:col-span-7 reveal-init">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-white text-brand-navy border border-brand-border shadow-sm mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span class="tracking-wide uppercase text-[11px] font-bold">SERVICE DIRECTORY &bull; INDORE</span>
          </div>

          <h1 class="text-3xl xs:text-4xl sm:text-5xl font-extrabold tracking-tight text-brand-navy leading-tight font-display">
            Air Conditioning Services in Indore
          </h1>

          <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed">
            Patel Cool Tech provides reliable on-site air conditioning solutions across Indore, Rau, Pithampur, and nearby areas. From new split and window AC installation and fault troubleshooting to deep coil cleaning, refrigerant leak checks, and customized maintenance contracts.
          </p>

          <!-- Direct CTA Bar -->
          <div class="mt-6 sm:mt-8 flex flex-col xs:flex-row items-stretch xs:items-center gap-3 sm:gap-3.5 max-w-md sm:max-w-none w-full sm:w-auto">
            <Button
              href={business.phones.primaryTel}
              variant="primary"
              size="lg"
              class="flex-1 xs:flex-1 sm:flex-initial w-full xs:w-auto justify-center font-bold px-3.5 xs:px-4 sm:px-7 py-3 sm:py-3.5 min-h-[48px] text-xs xs:text-sm sm:text-base shadow-card hover:shadow-hover whitespace-nowrap"
              aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
            >
              <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="hidden sm:inline whitespace-nowrap">Call: {business.phones.primaryFormatted}</span>
              <span class="sm:hidden whitespace-nowrap">Call Now</span>
            </Button>

            <Button
              href={business.phones.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="whatsapp"
              size="lg"
              class="flex-1 xs:flex-1 sm:flex-initial w-full xs:w-auto justify-center font-bold px-3.5 xs:px-4 sm:px-7 py-3 sm:py-3.5 min-h-[48px] text-xs xs:text-sm sm:text-base shadow-card hover:shadow-hover whitespace-nowrap"
              aria-label="Chat with Patel Cool Tech on WhatsApp"
            >
              <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
              </svg>
              <span class="whitespace-nowrap">WhatsApp Us</span>
            </Button>
          </div>
        </div>

        <!-- Right Column: Desktop Service Highlights Card -->
        <div class="hidden lg:flex lg:col-span-5 flex-col">
          <div class="p-6 xl:p-8 rounded-3xl bg-white/95 border border-brand-border/90 shadow-elevated relative overflow-hidden group">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue"></div>
            
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-ice font-display">Service Standards</span>
              <span class="px-2.5 py-1 rounded-full bg-sky-50 text-brand-blue text-xs font-bold border border-sky-100 flex items-center gap-1.5">
                5 Core Solutions
              </span>
            </div>

            <div class="space-y-3.5 text-sm text-brand-text">
              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xl">🛠️</span>
                <div>
                  <h4 class="font-bold text-brand-navy">Installation &amp; Shifting</h4>
                  <p class="text-xs text-brand-text-muted mt-0.5">Heavy-duty bracket anchoring, copper piping &amp; vacuum testing.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xl">💨</span>
                <div>
                  <h4 class="font-bold text-brand-navy">Leak Check &amp; Gas Refilling</h4>
                  <p class="text-xs text-brand-text-muted mt-0.5">Gauge manifold inspection, nitrogen testing, pure R32/R410A charging.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
                <span class="text-xl">🌊</span>
                <div>
                  <h4 class="font-bold text-brand-navy">Jet Pump Deep Wash</h4>
                  <p class="text-xs text-brand-text-muted mt-0.5">High-pressure indoor jacket washing &amp; outdoor condenser coil cleaning.</p>
                </div>
              </div>
            </div>

            <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">Split &bull; Window &bull; Inverter</span>
              <span class="font-bold text-brand-navy">Doorstep Indore</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Service Directory Cards Grid -->
  <section class="py-12 sm:py-16 lg:py-20 bg-white border-b border-brand-border">
    <Container>
      <div class="mb-10 reveal-init">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy font-display tracking-tight">
          Explore Our 5 Air Conditioning Services
        </h2>
        <p class="text-sm sm:text-base text-brand-text-muted mt-2">
          Select a service to read detailed scope of work, practical guidelines, and typical on-site workflows.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6 items-stretch">
        {
          services.map((service, index) => {
            const isLast = index === 4;
            return (
              <article
                class:list={[
                  'card-spotlight group relative flex flex-col justify-between bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/90 transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_16px_32px_-8px_rgba(2,132,199,0.18)] hover:border-sky-400/80 active:scale-[0.98] sm:active:scale-100 overflow-hidden reveal-init',
                  `stagger-${(index % 3) + 1}`,
                  isLast ? 'sm:col-span-2 lg:col-span-1' : '',
                ]}
              >
                <!-- Animated top accent line on hover -->
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-ice via-sky-400 to-brand-blue transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left z-20"></div>

                <!-- Shimmer light sheen sweep across card on hover -->
                <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-sky-100/35 to-transparent pointer-events-none z-10 ease-in-out"></div>

                <div>
                  <div class="flex items-center justify-between gap-3 mb-4 relative z-20">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-blue-light to-sky-100/60 text-brand-blue border border-brand-blue/15 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:rotate-6 group-hover:bg-gradient-to-tr group-hover:from-brand-navy group-hover:to-brand-blue group-hover:text-white group-hover:border-transparent group-hover:shadow-md transition-all duration-300">
                      {service.id === 'ac-installation' && (
                        <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                      )}
                      {service.id === 'ac-repair' && (
                        <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
                        </svg>
                      )}
                      {service.id === 'ac-service' && (
                        <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                      )}
                      {service.id === 'ac-gas-refilling' && (
                        <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                      )}
                      {(service.id === 'ac-amc' || service.id === 'amc-maintenance') && (
                        <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                      )}
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-50 border border-slate-200/90 text-slate-600 shadow-xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
                      <span>{service.category === 'both' ? 'Homes & Offices' : service.category}</span>
                    </span>
                  </div>

                  <h3 class="text-lg sm:text-xl font-bold text-brand-navy mb-1.5 font-display group-hover:text-brand-blue transition-colors">
                    <a href={`/services/${service.slug}/`} class="focus-visible:outline-none after:absolute after:inset-0">
                      {service.title}
                    </a>
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-3.5">
                    {service.shortDescription}
                  </p>

                  <div class="flex flex-wrap gap-1.5 mb-5 relative z-20">
                    {service.tags.map((tag) => (
                      <span class="inline-flex items-center text-[11px] font-medium px-2 py-0.5 rounded-md bg-slate-100/90 text-slate-600 border border-slate-200/60 group-hover:bg-sky-50 group-hover:text-brand-blue group-hover:border-sky-200/70 transition-colors">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm font-bold text-brand-blue group-hover:text-brand-navy transition-colors relative z-20">
                  <span class="group-hover:translate-x-0.5 transition-transform">View Details</span>
                  <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-slate-100 text-slate-600 group-hover:bg-brand-blue group-hover:text-white group-hover:translate-x-1 group-hover:shadow-sm transition-all duration-300 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- Service Areas & Coverage Summary -->
  <ServiceAreas />

  <!-- Major Brands Independent Support Section -->
  <BrandsSection />

  <!-- Final Climax CTA -->
  <ContactCTA />
</BaseLayout>
