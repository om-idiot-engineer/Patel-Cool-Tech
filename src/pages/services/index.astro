---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import BrandsSection from '../../components/BrandsSection.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import { services } from '../../data/services';
import { business } from '../../data/business';
import { siteConfig } from '../../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteConfig.siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: `${siteConfig.siteUrl}/services/`,
    },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Air Conditioning Services by Patel Cool Tech',
  description: 'List of professional air conditioning services in Indore, Rau, and Pithampur.',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.title,
    url: `${siteConfig.siteUrl}/services/${service.slug}/`,
  })),
};
---

<BaseLayout
  title="Air Conditioning Services in Indore"
  description="Professional split and window AC services in Indore, Rau, and Pithampur: installation, repair, deep servicing, gas refilling, and AMC maintenance."
  additionalSchema={[breadcrumbSchema, itemListSchema]}
>
  <!-- Hero / Introduction Section -->
  <section class="relative bg-gradient-to-b from-brand-surface via-white to-white pt-6 pb-12 sm:pt-8 sm:pb-16 border-b border-brand-border overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="directory-hero-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0B1F3A" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#directory-hero-pattern)" />
      </svg>
    </div>

    <Container class="relative z-10">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-5 sm:mb-6" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-brand-text-subtle">
          <li>
            <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
          </li>
          <li class="select-none" aria-hidden="true">&rsaquo;</li>
          <li class="font-semibold text-brand-navy" aria-current="page">Services</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-surface-alt text-brand-navy border border-brand-border mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span class="tracking-wide uppercase text-[11px] font-bold">SERVICE DIRECTORY &bull; INDORE</span>
        </div>

        <h1 class="text-2xl xs:text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight text-brand-navy leading-[1.18] sm:leading-[1.15]">
          Air Conditioning Services in Indore
        </h1>

        <p class="mt-4 sm:mt-5 text-base sm:text-lg text-brand-text-muted leading-relaxed">
          Patel Cool Tech provides reliable on-site air conditioning solutions across Indore, Rau, Pithampur, and nearby areas. From new split and window AC installation and fault troubleshooting to deep coil cleaning, refrigerant leak checks, and customized maintenance contracts.
        </p>

        <!-- Direct CTA Bar -->
        <div class="mt-6 sm:mt-8 flex flex-col xs:flex-row items-stretch xs:items-center gap-3">
          <Button
            href={business.phones.primaryTel}
            variant="primary"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold px-6 py-3.5 min-h-[48px] text-sm sm:text-base shadow-card hover:shadow-hover"
            aria-label={`Call Patel Cool Tech at ${business.phones.primaryFormatted}`}
          >
            <svg class="w-5 h-5 text-brand-ice flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call: {business.phones.primaryFormatted}</span>
          </Button>

          <Button
            href={business.phones.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            size="lg"
            class="w-full xs:w-auto justify-center font-bold px-6 py-3.5 min-h-[48px] text-sm sm:text-base shadow-card hover:shadow-hover"
            aria-label="Chat with Patel Cool Tech on WhatsApp"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.97.57 3.811 1.558 5.368L2.094 22l4.743-1.442a9.98 9.98 0 005.194 1.473h.004c5.535 0 10.03-4.495 10.03-10.031 0-2.68-1.043-5.2-2.935-7.093A9.972 9.972 0 0012.031 2zm0 18.257h-.003a8.217 8.217 0 01-4.186-1.144l-.3-.178-3.11.946.963-3.033-.195-.311a8.22 8.22 0 01-1.26-4.506c0-4.544 3.697-8.241 8.243-8.241 2.2 0 4.27.859 5.827 2.417a8.196 8.196 0 012.413 5.826c0 4.546-3.698 8.244-8.242 8.244z"/>
            </svg>
            <span>WhatsApp Us</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Service Directory Cards Grid -->
  <section class="py-12 sm:py-16 bg-white border-b border-brand-border">
    <Container>
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-navy">
          Explore Our 5 Air Conditioning Services
        </h2>
        <p class="text-sm text-brand-text-muted mt-1">
          Select a service to read detailed scope of work, practical guidelines, and typical on-site workflows.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        {
          services.map((service, index) => {
            const isLast = index === 4;
            return (
              <article
                class:list={[
                  'flex flex-col justify-between bg-brand-surface rounded-2xl p-6 sm:p-7 border border-brand-border hover:border-brand-blue/40 hover:shadow-card transition-all duration-200 group',
                  isLast ? 'md:col-span-2 lg:col-span-1' : '',
                ]}
              >
                <div>
                  <div class="flex items-center justify-between gap-4 mb-5">
                    <div class="w-12 h-12 rounded-xl bg-brand-blue-light text-brand-blue flex items-center justify-center flex-shrink-0 group-hover:bg-brand-blue group-hover:text-white transition-colors duration-200">
                      {service.id === 'ac-installation' && (
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                      )}
                      {service.id === 'ac-repair' && (
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
                        </svg>
                      )}
                      {service.id === 'ac-service' && (
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                      )}
                      {service.id === 'ac-gas-refilling' && (
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                      )}
                      {(service.id === 'ac-amc' || service.id === 'amc-maintenance') && (
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                      )}
                    </div>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white border border-brand-border text-brand-text-subtle capitalize">
                      {service.category === 'both' ? 'Homes & Offices' : service.category}
                    </span>
                  </div>

                  <h3 class="text-lg sm:text-xl font-bold text-brand-navy mb-2.5">
                    <a href={`/services/${service.slug}/`} class="hover:text-brand-blue transition-colors">
                      {service.title}
                    </a>
                  </h3>
                  <p class="text-sm sm:text-base text-brand-text-muted leading-relaxed mb-4">
                    {service.shortDescription}
                  </p>

                  <ul class="space-y-2 mb-6 border-t border-brand-border/60 pt-4" role="list">
                    {service.features.map((feature) => (
                      <li class="flex items-start gap-2 text-xs sm:text-sm text-brand-text">
                        <svg class="w-4 h-4 text-brand-ice flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-3 border-t border-brand-border/60">
                  <a
                    href={`/services/${service.slug}/`}
                    class="inline-flex items-center justify-between w-full text-sm font-bold text-brand-blue hover:text-brand-ice transition-colors duration-150 py-2.5 min-h-[48px] focus-visible:outline-2 focus-visible:outline-brand-blue rounded-md"
                    aria-label={`View complete information for ${service.title}`}
                  >
                    <span>View Service Details &rarr;</span>
                    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- Service Areas & Coverage Summary -->
  <ServiceAreas />

  <!-- Major Brands Independent Support Section -->
  <BrandsSection />
</BaseLayout>
